pkgbase = omarchy-kids
	pkgdesc = Kids Mode for Omarchy: a Kids Mode app on a normal Omarchy install (sandbox path)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/markcuda/omarchy-kids-sandbox
	install = omarchy-kids.install
	arch = x86_64
	license = MIT
	depends = bash
	depends = gum
	depends = jq
	depends = python
	depends = cryptsetup
	depends = polkit
	depends = sudo
	depends = systemd
	depends = qt6-svg
	depends = networkmanager
	depends = quickshell
	optdepends = socat: faster transport between omarchy-kids-parent-auth and omarchy-kids-authd
	optdepends = snapper: pre-apply "before Kids Mode" snapshot and Remove Kids Mode snapshot (R-TRUST-1)
	optdepends = limine-snapper-sync: refresh the boot menu right after hiding/showing snapshot entries (issue #38)
	backup = etc/mkinitcpio.conf.d/omarchy_kids.conf

pkgname = omarchy-kids
