#!/bin/bash
# omarchy-kids: the app entry point (R-FND-1, R-WIZ-1 through R-WIZ-9).
# Launched from the app drawer or Super+Shift+K. With no kid provisioned
# yet, opens the parent wizard (bin/omarchy-kids-wizard, issue #19); once
# at least one kid exists, `omarchy-kids` alone opens the panel
# (bin/omarchy-kids-panel, issue #21) and `omarchy-kids wizard` always
# opens the wizard (R-WIZ-7's "add a kid" runs the same per-kid screens).
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WIZARD_BIN="${OMARCHY_KIDS_WIZARD_BIN:-$DIR/bin/omarchy-kids-wizard}"; [[ -x "$WIZARD_BIN" ]] || WIZARD_BIN=omarchy-kids-wizard
PANEL_BIN="${OMARCHY_KIDS_PANEL_BIN:-$DIR/bin/omarchy-kids-panel}"; [[ -x "$PANEL_BIN" ]] || PANEL_BIN=omarchy-kids-panel

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
KIDS_DIR="$ETC/kids"

usage() {
  cat <<EOF
Usage: omarchy-kids [wizard] [--dry-run] [--apply] [--help]

Opens Kids Mode. With no kid provisioned yet, this is the parent wizard
(SPEC.md R-WIZ). Once a kid exists, this opens the panel (R-WIZ-7/8) and
'omarchy-kids wizard' always opens the wizard, to add another kid.

  wizard      Always open the parent wizard, even if kids already exist.
  --dry-run   Passed through to the wizard's or panel's own --dry-run.
  --apply     Passed through to the panel's own --apply (see its --help).
  -h, --help  Show this help and exit.
EOF
}

any_kid_provisioned() {
  local f
  for f in "$KIDS_DIR"/*.conf; do
    [[ -e "$f" ]] && return 0
  done
  return 1
}

args=()
open_wizard=0
for arg in "$@"; do
  case "$arg" in
    wizard) open_wizard=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) args+=("$arg") ;;
  esac
done

if ((open_wizard)); then
  exec "$WIZARD_BIN" "${args[@]+"${args[@]}"}"
fi

if ! any_kid_provisioned; then
  exec "$WIZARD_BIN" "${args[@]+"${args[@]}"}"
fi

exec "$PANEL_BIN" "${args[@]+"${args[@]}"}"
