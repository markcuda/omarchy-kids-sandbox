#!/bin/bash
# omarchy-kids-apps — starter-pack installs, the per-kid launcher
# allowlist, and the parent's own opt-in "hide kids' apps from my
# launcher" switch (SPEC.md R-APPS-2..6, Appendix C; I-1, I-6).
#
#   list <band|kid>          Every app in a band's pack (or, given a kid
#                             account, that kid's band) with its
#                             installed/missing state (`pacman -Q`).
#   install <band> [--now]   Missing packages for a band's pack, resolved
#                             against the sync db first (`pacman -Si`,
#                             issue #52) so one bad/missing target never
#                             sinks the whole transaction. By default,
#                             enqueues the resolvable ones to
#                             /var/lib/omarchy-kids/apps-queue and starts
#                             omarchy-kids-apps-install.service in the
#                             background (`systemctl start --no-block`),
#                             so the parent keeps going (R-APPS-3).
#                             --now runs `pacman -S --needed --noconfirm`
#                             for them directly, right away. AUR packages
#                             (pkg = "aur:...") and any target `pacman -Si`
#                             can't find are named on stderr and skipped
#                             either way -- building AUR is R-APPS-1's own
#                             job, not built here. Exits 0 as long as
#                             nothing that *was* attempted failed.
#                             DRY_RUN=1 by default (AGENTS.md rule 8);
#                             --apply or DRY_RUN=0 makes either mode real.
#   install-queued           The queue's worker: resolves everything still
#                             in the queue file against the sync db
#                             (`pacman -Si`, issue #52), installs whatever
#                             resolves and isn't already installed in one
#                             transaction, reports anything that doesn't
#                             resolve, then empties the file. Always runs
#                             for real -- see "Judgment calls" in
#                             docs/apps.md. Meant to be called by
#                             systemd/omarchy-kids-apps-install.service,
#                             not by a parent directly.
#   allowlist <kid>          The kid's effective launcher allowlist:
#                             their band's pack (`allowlist`, Appendix B),
#                             plus `apps.extra`, minus `apps.hidden` (two
#                             profile keys this adds beyond Appendix B --
#                             docs/conf.md). Comma-separated ids, same
#                             format as the `allowlist` key itself.
#   hide <kid> <app>         Adds <app> to the kid's `apps.hidden`.
#   show <kid> <app>         Removes <app> from the kid's `apps.hidden`.
#   hide-from-mine [--apply] Opt-in only (I-1): writes NoDisplay=true
#                             overrides for every provisioned kid's
#                             allowlisted apps into the *current user's
#                             own* ~/.local/share/applications/, so those
#                             apps stop showing in the parent's own
#                             launcher. Never touches a kid's account or
#                             any file owned by `omarchy`/`omarchy-settings`
#                             (I-7). DRY_RUN=1 by default.
#   show-in-mine [--apply]   Removes exactly the override files
#                             hide-from-mine wrote (marked internally with
#                             X-OmarchyKidsHideFromMine=true), never a
#                             file the parent created some other way.
#
# Every path is overridable for tests, same convention as
# omarchy-kids-conf and bin/omarchy-kids-assert:
#   OMARCHY_KIDS_ETC     kid overrides root (default /etc/omarchy-kids)
#   OMARCHY_KIDS_SHARE   bands.toml, packs/ (default /usr/share/omarchy-kids)
#   OMARCHY_KIDS_ROOT    scratch prefix for /var/lib/omarchy-kids (the
#                        install queue), same convention
#                        bin/omarchy-kids-assert and lib/posture.sh use
#                        for system paths this package doesn't own
#   OMARCHY_KIDS_HOME    hide-from-mine/show-in-mine's target home
#                        (default: $HOME) -- always the account running
#                        this command, never a kid's home
#   OMARCHY_KIDS_APPLICATIONS_DIRS  colon-separated .desktop search dirs
#                        for hide-from-mine (default
#                        /usr/share/applications:/usr/local/share/applications)
#   OMARCHY_KIDS_CONF_BIN  path to omarchy-kids-conf (default: resolved
#                        beside this script, else /usr/bin/omarchy-kids-conf)
#   OMARCHY_KIDS_CONF_PY  python3 by default (also read by omarchy-kids-conf)
#   OMARCHY_KIDS_LIB     lib/ beside bin/, else /usr/lib/omarchy-kids
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="${OMARCHY_KIDS_LIB:-$DIR/lib}"; [[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
CONF_BIN="${OMARCHY_KIDS_CONF_BIN:-$DIR/bin/omarchy-kids-conf}"; [[ -x "$CONF_BIN" ]] || CONF_BIN=/usr/bin/omarchy-kids-conf
PY="${OMARCHY_KIDS_CONF_PY:-python3}"
PYHELPER="$LIB/conf.py"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
SYSROOT="${OMARCHY_KIDS_ROOT:-}"
KIDS_DIR="$ETC/kids"
PACKS_DIR="$SHARE/packs"
QUEUE_FILE="$SYSROOT/var/lib/omarchy-kids/apps-queue"
APPLICATIONS_DIRS="${OMARCHY_KIDS_APPLICATIONS_DIRS:-/usr/share/applications:/usr/local/share/applications}"
TARGET_HOME="${OMARCHY_KIDS_HOME:-$HOME}"
HIDE_MARKER="X-OmarchyKidsHideFromMine=true"

DRY_RUN="${DRY_RUN:-1}"

VALID_BANDS=("3-5" "6-8" "9-12" "13+")

die() { echo "omarchy-kids-apps: $1" >&2; exit "${2:-2}"; }

usage() {
    cat <<'EOF'
Usage: omarchy-kids-apps list <band|kid>
       omarchy-kids-apps install <band> [--now] [--apply]
       omarchy-kids-apps install-queued
       omarchy-kids-apps allowlist <kid>
       omarchy-kids-apps hide <kid> <app>
       omarchy-kids-apps show <kid> <app>
       omarchy-kids-apps hide-from-mine [--apply]
       omarchy-kids-apps show-in-mine [--apply]
       omarchy-kids-apps --help

list          Pack entries for a band (or a kid's own band) with
              installed/missing state (`pacman -Q`).

install       Missing pack packages for a band, resolved against the sync
              db first (pacman -Si) so one bad target can't sink the rest.
              Default: enqueue the resolvable ones for the background
              install unit. --now: run pacman right away. AUR packages
              (pkg = "aur:...") and any unresolved target are named but
              skipped either way. DRY_RUN=1 by default (AGENTS.md rule 8);
              --apply or DRY_RUN=0 makes it real.

install-queued  The queue's worker (always real -- see docs/apps.md).
                Resolves against the sync db first, same as install.
                Meant for systemd/omarchy-kids-apps-install.service.

allowlist     The kid's effective launcher allowlist: pack, plus
              apps.extra, minus apps.hidden.

hide, show    Add/remove one app from a kid's apps.hidden, through
              omarchy-kids-conf.

hide-from-mine, show-in-mine   Opt-in only (I-1): write/remove
              NoDisplay=true overrides for kids' apps in the current
              user's own ~/.local/share/applications/. DRY_RUN=1 by
              default; --apply or DRY_RUN=0 makes it real.

  -h, --help  Show this help and exit.
EOF
}

# --- small shared helpers ---------------------------------------------

is_in() { # is_in NEEDLE HAYSTACK...
    local needle="$1"; shift
    local h
    for h in "$@"; do [[ "$h" == "$needle" ]] && return 0; done
    return 1
}

is_valid_band() { is_in "$1" "${VALID_BANDS[@]}"; }

# pkg_resolves PKG — true if PKG is a real target in the sync db right
# now (`pacman -Si`); catches a mismarked pack entry or a mirror that's
# missing a package before it ever reaches a real -S transaction (issue
# #52: this is what "target not found: tuxpaint" looked like live).
pkg_resolves() { pacman -Si "$1" >/dev/null 2>&1; }

# run CMD [ARGS...] — DRY_RUN=1 (default) prints the shell-quoted command
# instead of running it; DRY_RUN=0 (or --apply) runs it for real. Same
# shape as bin/omarchy-kids-web's own `run`.
run() {
    if [[ "$DRY_RUN" == "0" ]]; then
        "$@"
    else
        printf '  [dry-run]'
        printf ' %q' "$@"
        printf '\n'
    fi
}

# resolve_band ARG — ARG itself if it's already a valid band, else the
# band of the kid account ARG names (via omarchy-kids-conf, so this
# never reads a kid's profile directly).
resolve_band() {
    local arg="$1"
    if is_valid_band "$arg"; then
        printf '%s\n' "$arg"
        return 0
    fi
    "$CONF_BIN" get "$arg" band 2>/dev/null \
        || die "'$arg' is neither a band (${VALID_BANDS[*]}) nor a kid with a band set"
}

pack_file() { printf '%s/%s.toml' "$PACKS_DIR" "$1"; }

# pack_ids_array BAND -> sets the global array PACK_IDS to that band's
# pack ids, in file order (empty if the pack has none).
PACK_IDS=()
pack_ids_array() {
    local band="$1" pack ids
    pack="$(pack_file "$band")"
    [[ -f "$pack" ]] || die "no pack for band '$band' ($pack)"
    ids="$("$PY" "$PYHELPER" pack-ids "$pack")"
    PACK_IDS=()
    IFS=',' read -ra PACK_IDS <<<"$ids"
}

# pack_app_meta PACK ID -> sets LABEL, PKG (globals) for one app id, or
# dies -- same helper bin/omarchy-kids-session-start already leans on.
LABEL=""
PKG=""
pack_app_meta() {
    local pack="$1" id="$2" meta
    meta="$("$PY" "$PYHELPER" pack-app "$pack" "$id")" || die "no such app id '$id' in $pack"
    IFS=$'\t' read -r LABEL PKG _web <<<"$meta"
}

list_kids() {
    [[ -d "$KIDS_DIR" ]] || return 0
    local f
    for f in "$KIDS_DIR"/*.conf; do
        [[ -e "$f" ]] || continue
        basename "$f" .conf
    done
}

# --- allowlist math -----------------------------------------------------

# combine_allowlist BASE EXTRA HIDDEN -> comma-separated ids on stdout:
# BASE's ids in order, then any of EXTRA's ids not already present (in
# their own order), minus every id named in HIDDEN. Pure string work.
combine_allowlist() {
    local base="$1" extra="$2" hidden="$3"
    local -a base_arr=() extra_arr=() hidden_arr=() out=()
    IFS=',' read -ra base_arr <<<"$base"
    IFS=',' read -ra extra_arr <<<"$extra"
    IFS=',' read -ra hidden_arr <<<"$hidden"

    local id
    for id in "${base_arr[@]+"${base_arr[@]}"}"; do
        [[ -n "$id" ]] || continue
        is_in "$id" "${hidden_arr[@]+"${hidden_arr[@]}"}" && continue
        out+=("$id")
    done
    for id in "${extra_arr[@]+"${extra_arr[@]}"}"; do
        [[ -n "$id" ]] || continue
        is_in "$id" "${hidden_arr[@]+"${hidden_arr[@]}"}" && continue
        is_in "$id" "${out[@]+"${out[@]}"}" && continue
        out+=("$id")
    done

    local IFS=,
    printf '%s\n' "${out[*]+"${out[*]}"}"
}

# allowlist_value KID -> the kid's effective allowlist (see combine_allowlist).
allowlist_value() {
    local kid="$1" base extra hidden
    base="$("$CONF_BIN" get "$kid" allowlist)"
    extra="$("$CONF_BIN" get "$kid" apps.extra)"
    hidden="$("$CONF_BIN" get "$kid" apps.hidden)"
    combine_allowlist "$base" "$extra" "$hidden"
}

# --- list ----------------------------------------------------------------

cmd_list() {
    local arg="${1:?omarchy-kids-apps list <band|kid>}" band pack id pkgname state
    band="$(resolve_band "$arg")"
    pack="$(pack_file "$band")"
    [[ -f "$pack" ]] || die "no pack for band '$band' ($pack)"
    pack_ids_array "$band"

    printf '%-16s %-24s %-28s %s\n' ID LABEL PKG STATE
    for id in "${PACK_IDS[@]+"${PACK_IDS[@]}"}"; do
        [[ -n "$id" ]] || continue
        pack_app_meta "$pack" "$id"
        pkgname="${PKG#aur:}"
        if pacman -Q "$pkgname" >/dev/null 2>&1; then
            state=installed
        else
            state=missing
        fi
        printf '%-16s %-24s %-28s %s\n' "$id" "$LABEL" "$PKG" "$state"
    done
}

# --- install / install-queued --------------------------------------------

enqueue_apps() { # enqueue_apps PKG...
    local dir; dir="$(dirname "$QUEUE_FILE")"
    install -d -m 0755 "$dir"
    local tmp; tmp="$(mktemp "$QUEUE_FILE.XXXXXX")"
    { [[ -f "$QUEUE_FILE" ]] && cat "$QUEUE_FILE"; printf '%s\n' "$@"; } \
        | awk 'NF && !seen[$0]++' >"$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$QUEUE_FILE"
}

start_install_service() { systemctl start --no-block omarchy-kids-apps-install.service; }

cmd_install() {
    local band="" now=0
    while (($#)); do
        case "$1" in
            --now) now=1; shift ;;
            --apply) DRY_RUN=0; shift ;;
            -h|--help) usage; exit 0 ;;
            --) shift ;;
            -*) die "install: unknown option '$1'" ;;
            *) if [[ -z "$band" ]]; then band="$1"; else die "install: unexpected argument '$1'"; fi; shift ;;
        esac
    done
    [[ -n "$band" ]] || die "install: needs a band"
    is_valid_band "$band" || die "install: unknown band '$band' (must be one of ${VALID_BANDS[*]})"

    local pack; pack="$(pack_file "$band")"
    [[ -f "$pack" ]] || die "no pack for band '$band' ($pack)"
    pack_ids_array "$band"

    local -a missing=() aur_skipped=() unresolved=()
    local id pkgname
    for id in "${PACK_IDS[@]+"${PACK_IDS[@]}"}"; do
        [[ -n "$id" ]] || continue
        pack_app_meta "$pack" "$id"
        case "$PKG" in
            aur:*)
                pkgname="${PKG#aur:}"
                pacman -Q "$pkgname" >/dev/null 2>&1 || aur_skipped+=("$pkgname")
                ;;
            *)
                if pacman -Q "$PKG" >/dev/null 2>&1; then
                    :
                elif pkg_resolves "$PKG"; then
                    missing+=("$PKG")
                else
                    unresolved+=("$PKG")
                fi
                ;;
        esac
    done

    if [[ ${#aur_skipped[@]} -gt 0 ]]; then
        echo "omarchy-kids-apps: skipping AUR package(s), not yet automated (R-APPS-1): ${aur_skipped[*]}" >&2
    fi
    if [[ ${#unresolved[@]} -gt 0 ]]; then
        echo "omarchy-kids-apps: not found in the synced repos, skipping (pack.toml or mirror gap, issue #52): ${unresolved[*]}" >&2
    fi

    if [[ ${#missing[@]} -eq 0 ]]; then
        echo "omarchy-kids-apps: band '$band' has nothing left to install"
        return 0
    fi

    if [[ "$now" -eq 1 ]]; then
        echo "omarchy-kids-apps: installing now for band '$band': ${missing[*]}"
        run pacman -S --needed --noconfirm "${missing[@]}"
    else
        echo "omarchy-kids-apps: queuing for band '$band': ${missing[*]}"
        run enqueue_apps "${missing[@]}"
        run start_install_service
    fi
}

# install-queued: the queue's own worker. Always runs for real (see
# docs/apps.md's "Judgment calls" -- same reasoning as
# bin/omarchy-kids-assert inverting AGENTS.md rule 8's usual default):
# it exists precisely so systemd/omarchy-kids-apps-install.service never
# needs --apply to do its one job. Never removes a package, never
# reboots. Idempotent: an empty or already-installed queue is a no-op.
cmd_install_queued() {
    if [[ ! -s "$QUEUE_FILE" ]]; then
        echo "omarchy-kids-apps: install-queued: queue is empty"
        return 0
    fi

    local -a queued=() still_missing=() unresolved=()
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" ]] && queued+=("$line")
    done <"$QUEUE_FILE"

    # Resolve against the sync db before ever handing pacman a
    # transaction (issue #52) -- a queued entry that no longer resolves
    # (mirror gap, or a mismarked pack) is reported and dropped, never
    # retried forever.
    local p
    for p in "${queued[@]+"${queued[@]}"}"; do
        if pacman -Q "$p" >/dev/null 2>&1; then
            continue
        elif pkg_resolves "$p"; then
            still_missing+=("$p")
        else
            unresolved+=("$p")
        fi
    done

    if [[ ${#unresolved[@]} -gt 0 ]]; then
        echo "omarchy-kids-apps: install-queued: not found in the synced repos, dropping from the queue: ${unresolved[*]}" >&2
    fi

    if [[ ${#still_missing[@]} -eq 0 ]]; then
        echo "omarchy-kids-apps: install-queued: nothing left in the queue to install"
    else
        echo "omarchy-kids-apps: install-queued: installing ${still_missing[*]}"
        if ! pacman -S --needed --noconfirm "${still_missing[@]}"; then
            echo "omarchy-kids-apps: install-queued: pacman failed; leaving the queue for the next run" >&2
            return 1
        fi
        echo "omarchy-kids-apps: install-queued: done"
    fi
    : >"$QUEUE_FILE"
}

# --- allowlist / hide / show ----------------------------------------------

cmd_allowlist() {
    local kid="${1:?omarchy-kids-apps allowlist <kid>}"
    allowlist_value "$kid"
}

# edit_hidden KID ACTION(add|remove) APP — rewrites apps.hidden through
# omarchy-kids-conf (docs/conf.md: nothing else touches a kid's .conf
# file directly), de-duplicated either way.
edit_hidden() {
    local kid="$1" action="$2" app="$3" hidden
    hidden="$("$CONF_BIN" get "$kid" apps.hidden)"
    local -a arr=() out=()
    IFS=',' read -ra arr <<<"$hidden"
    local id
    for id in "${arr[@]+"${arr[@]}"}"; do
        [[ -n "$id" && "$id" != "$app" ]] && out+=("$id")
    done
    [[ "$action" == add ]] && out+=("$app")
    local IFS=,
    "$CONF_BIN" set "$kid" apps.hidden "${out[*]+"${out[*]}"}" >/dev/null
}

cmd_hide() {
    local kid="${1:?omarchy-kids-apps hide <kid> <app>}" app="${2:?omarchy-kids-apps hide <kid> <app>}"
    edit_hidden "$kid" add "$app"
    echo "$kid: hid '$app'"
}

cmd_show_app() {
    local kid="${1:?omarchy-kids-apps show <kid> <app>}" app="${2:?omarchy-kids-apps show <kid> <app>}"
    edit_hidden "$kid" remove "$app"
    echo "$kid: unhid '$app'"
}

# --- hide-from-mine / show-in-mine ----------------------------------------

# find_desktop_file_by_id ID -> "basename\tdir" of a .desktop file whose
# name looks like it belongs to launcher id ID, or nothing (non-zero
# exit) if none is found. Same best-effort substring heuristic as
# bin/omarchy-kids-session-start's find_desktop_file, trimmed to just the
# id (hide-from-mine also has to cover apps.extra ids that were never in
# any pack, so it has no `pkg` to also match against).
find_desktop_file_by_id() {
    local id="$1" needle dir f base base_lc
    needle="$(printf '%s' "$id" | tr '[:upper:]' '[:lower:]')"
    IFS=':' read -ra dirs <<<"$APPLICATIONS_DIRS"
    for dir in "${dirs[@]+"${dirs[@]}"}"; do
        [[ -d "$dir" ]] || continue
        for f in "$dir"/*.desktop; do
            [[ -e "$f" ]] || continue
            base="$(basename "$f" .desktop)"
            base_lc="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
            if [[ "$base_lc" == *"$needle"* ]]; then
                printf '%s\t%s\n' "$base" "$dir"
                return 0
            fi
        done
    done
    return 1
}

# write_override SRC DEST — copies SRC (a real .desktop file) to DEST
# with NoDisplay=true set in its [Desktop Entry] group and our own
# marker line added right after it, so show-in-mine can later tell this
# file apart from an override the parent wrote some other way. Spec text
# (R-APPS-5) says "Hidden=true"; NoDisplay=true is used here instead --
# it is the field the Desktop Entry / menu specs actually define for
# "don't list this in a menu, the app is still otherwise valid" (Hidden
# means "treat this id as deleted", which is a stronger and different
# claim than "not in my menu") -- see docs/apps.md's "Judgment calls".
write_override() {
    local src="$1" dest="$2" dir
    dir="$(dirname "$dest")"
    install -d -m 0755 "$dir"
    local tmp; tmp="$(mktemp "$dir/.omarchy-kids-apps.XXXXXX")"
    awk -v marker="$HIDE_MARKER" '
        /^\[Desktop Entry\]/ && !done { print; print "NoDisplay=true"; print marker; done=1; next }
        /^NoDisplay=/ && done { next }
        { print }
    ' "$src" >"$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$dest"
    echo "  wrote $dest (NoDisplay=true)"
}

cmd_hide_from_mine() {
    while (($#)); do
        case "$1" in
            --apply) DRY_RUN=0; shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "hide-from-mine: unexpected argument '$1'" ;;
        esac
    done

    local -a kids=()
    local k
    while IFS= read -r k; do [[ -n "$k" ]] && kids+=("$k"); done < <(list_kids)
    if [[ ${#kids[@]} -eq 0 ]]; then
        echo "omarchy-kids-apps: no kids provisioned; nothing to hide"
        return 0
    fi

    local -a ids=()
    local kid list id
    for kid in "${kids[@]}"; do
        list="$(allowlist_value "$kid")"
        local -a one=()
        IFS=',' read -ra one <<<"$list"
        for id in "${one[@]+"${one[@]}"}"; do
            [[ -n "$id" ]] || continue
            is_in "$id" "${ids[@]+"${ids[@]}"}" || ids+=("$id")
        done
    done

    if [[ ${#ids[@]} -eq 0 ]]; then
        echo "omarchy-kids-apps: no allowlisted apps to hide"
        return 0
    fi

    local desktop_line base dir
    for id in "${ids[@]}"; do
        if desktop_line="$(find_desktop_file_by_id "$id")"; then
            IFS=$'\t' read -r base dir <<<"$desktop_line"
            run write_override "$dir/$base.desktop" "$TARGET_HOME/.local/share/applications/$base.desktop"
        else
            echo "  no .desktop file found for '$id'; skipped (I-6: nothing to honestly hide)" >&2
        fi
    done
}

cmd_show_in_mine() {
    while (($#)); do
        case "$1" in
            --apply) DRY_RUN=0; shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "show-in-mine: unexpected argument '$1'" ;;
        esac
    done

    local dir="$TARGET_HOME/.local/share/applications"
    if [[ ! -d "$dir" ]]; then
        echo "omarchy-kids-apps: nothing to restore ($dir doesn't exist)"
        return 0
    fi

    local f removed=0
    for f in "$dir"/*.desktop; do
        [[ -e "$f" ]] || continue
        grep -qxF "$HIDE_MARKER" "$f" || continue
        run rm -f "$f"
        removed=$((removed + 1))
    done
    echo "omarchy-kids-apps: removed $removed override(s) from $dir"
}

# --- main ------------------------------------------------------------------

main() {
    local cmd="${1:-}"
    case "$cmd" in
        -h|--help|"") usage; [[ "$cmd" == "" ]] && exit 2; exit 0 ;;
    esac
    shift

    case "$cmd" in
        list) cmd_list "$@" ;;
        install) cmd_install "$@" ;;
        install-queued) cmd_install_queued "$@" ;;
        allowlist) cmd_allowlist "$@" ;;
        hide) cmd_hide "$@" ;;
        show) cmd_show_app "$@" ;;
        hide-from-mine) cmd_hide_from_mine "$@" ;;
        show-in-mine) cmd_show_in_mine "$@" ;;
        *) die "unknown command: '$cmd' (see --help)" ;;
    esac
}

main "$@"
