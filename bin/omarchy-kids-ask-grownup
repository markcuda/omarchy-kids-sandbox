#!/bin/bash
# omarchy:summary=Show the fail-closed "Ask a grown-up" screen before a kid's desktop starts
# Shown by omarchy-kids-session (SPEC.md R-DESK-2) when a fail-closed
# check fails before a kid's desktop starts -- a tty message, not a real
# graphical modal, since Hyprland hasn't started yet at that point.
# See docs/check.md for why this is a placeholder, and every env var.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: omarchy-kids-ask-grownup "<check name>"

Prints a full-screen "Ask a grown-up" message naming the failed check
(SPEC.md R-DESK-2), then holds it on screen for a while and exits.
Placeholder for the real graphical modal -- see this script's header.

  -h, --help  Show this help and exit.

Env:
  OMARCHY_KIDS_ASK_GROWNUP_SLEEP  seconds to hold the message (default 15)
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
  esac
done

CHECK_NAME="${1:-a check}"
SLEEP_SECS="${OMARCHY_KIDS_ASK_GROWNUP_SLEEP:-15}"

MESSAGE="Ask a grown-up

Something isn't set up right yet, so this desktop can't start safely.

Check that failed: $CHECK_NAME

Find a grown-up. They can run 'omarchy-kids-check' to see what's wrong."

# Prefer the actual tty this session owns; fall back to stdout when
# there isn't one (no controlling terminal in a test run, or this got
# redirected somewhere that isn't a terminal). A plain `[[ -w /dev/tty ]]`
# isn't enough: the device node's permission bits can look writable even
# with no controlling terminal attached, and the write then fails with
# ENXIO -- so actually try the open instead of just checking permissions.
OUT=/dev/stdout
if { : > /dev/tty; } 2>/dev/null; then
  OUT=/dev/tty
fi

if command -v gum >/dev/null 2>&1; then
  gum style \
    --border double \
    --align center \
    --width 60 \
    --margin "2 4" \
    --padding "2 4" \
    --foreground 212 --border-foreground 212 \
    "$MESSAGE" >"$OUT" 2>/dev/null || printf '%s\n' "$MESSAGE" >"$OUT"
else
  {
    printf '%s\n' "======================================================"
    printf '%s\n' "$MESSAGE"
    printf '%s\n' "======================================================"
  } >"$OUT"
fi

sleep "$SLEEP_SECS"
exit 1
