#!/bin/bash
# omarchy-kids-assert — re-asserts every Kids Mode lock idempotently
# (SPEC.md I-4, R-TRUST-5, R-BOOT-5, R-WEB-1, R-FND-2..6, §5.1). Called by
# /usr/share/libalpm/hooks/omarchy-kids.hook after every pacman transaction,
# by systemd/omarchy-kids-assert.service at boot, and (per docs/assert.md)
# by Omarchy's own post-update hook -- see that doc for the full lock list,
# when each caller runs it, and the exit codes.
#
# Unlike most other omarchy-kids-* commands, this one applies fixes for
# real *by default*: it exists precisely so an automatic caller (the
# pacman hook, the boot unit) never has to pass --apply for a lock to
# actually be restored. `--dry-run` opts into preview-only mode instead
# (see "Judgment calls" in docs/assert.md for why this is the one command
# that inverts AGENTS.md rule 8's usual DRY_RUN=1 default). Every real
# path is still overridable so tests -- and a --dry-run reviewed before
# trusting it -- can point the whole run at a scratch tree, and nothing
# under this dev checkout's real /etc, /var, or /home is ever touched by
# test/shell.d/assert-test.sh:
#   OMARCHY_KIDS_ETC        default /etc/omarchy-kids   (kid profiles, machine.conf)
#   OMARCHY_KIDS_SHARE      default /usr/share/omarchy-kids  (hyprland/*.lua and avatars source)
#   OMARCHY_KIDS_LIB        default lib/ beside bin/, else /usr/lib/omarchy-kids
#   OMARCHY_KIDS_ROOT       scratch prefix for every real machine path this
#                           touches: /etc/polkit-1, /etc/security, /etc/pam.d,
#                           /etc/fstab, /var/lib/AccountsService,
#                           /etc/sddm.conf.d, /usr/share/sddm/themes/omarchy-kids
#                           (theme.conf.user), /usr/share/sddm/faces
#                           (lib/posture.sh), plus /etc/systemd/system
#                           (getty masks), /etc/chromium/policies/managed
#                           (kids policy files), /usr/lib/initcpio/hooks
#                           and /boot (the boot hook)
#   OMARCHY_KIDS_HOME_ROOT  scratch prefix for /home/<account> itself, for the
#                           findmnt/mount calls this makes (matches
#                           omarchy-kids-provision's own env var of the same name)
#   OMARCHY_KIDS_UKI        overrides which UKI/initramfs image R-BOOT-5 checks,
#                           instead of the first /boot/EFI/Linux/*.efi found
# shellcheck disable=SC2329 # every *_ok/*_fix below is invoked indirectly through assert_one's "$check" "$@" / "$fix" "$@"
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="${OMARCHY_KIDS_LIB:-$DIR/lib}"; [[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/conf.sh
source "$LIB/conf.sh"
# shellcheck source=lib/posture.sh
source "$LIB/posture.sh"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
HOME_ROOT="${OMARCHY_KIDS_HOME_ROOT:-}"
KIDS_DIR="$ETC/kids"
MACHINE_CONF="$ETC/machine.conf"

QUIET=0
DRY_RUN=0
ANY_FAIL=0

usage() {
    cat <<'EOF'
Usage: omarchy-kids-assert [--quiet] [--dry-run]

Re-asserts every Kids Mode lock for every provisioned kid, and every
machine-level lock, idempotently (SPEC.md I-4, R-TRUST-5): fstab bind
lines and noexec mounts, pam_namespace lines, the AccountsService pin,
the passwd GECOS display name, the SDDM face icon, group membership, the
polkit admin/deny rules, the SDDM portal theme selection and its
theme.conf.user parent/avatar data (R-LOGIN, issue #39), pam_namespace on
sddm and systemd-user, masked getty@tty2..6, the
/etc/omarchy-kids/hyprland/*.lua copies, per-band Chromium policy file
permissions, and the boot hook (R-BOOT-5). See docs/assert.md for the
full lock list and exit codes.

Applies fixes for real by default -- this is the command the pacman hook
and the boot unit call with no other flags, so it must self-heal without
needing --apply.

  --quiet     Print only "fixed"/"FAIL" lines (no "ok" lines, no notice
              when nothing is provisioned).
  --dry-run   Report what would change; write nothing.
  -h, --help  Show this help and exit.

Exit codes: 0 everything is (or now is) fine; 1 at least one lock could
not be fixed.
EOF
}

for arg in "$@"; do
    case "$arg" in
        --quiet) QUIET=1 ;;
        --dry-run) DRY_RUN=1 ;;
        -h|--help) usage; exit 0 ;;
        *)
            echo "omarchy-kids-assert: unknown argument '$arg'" >&2
            usage >&2
            exit 2
            ;;
    esac
done

# report STATUS LOCK — one line per lock. "ok" is suppressed under
# --quiet; "fixed"/"FAIL" always print. Sets ANY_FAIL on any "FAIL".
report() {
    local status="$1" lock="$2"
    [[ "$status" == "FAIL" ]] && ANY_FAIL=1
    [[ "$QUIET" -eq 1 && "$status" == "ok" ]] && return 0
    printf '%-8s %s\n' "$status" "$lock"
    return 0
}

# assert_one LOCK CHECK_FN FIX_FN [ARGS...] — the one control-flow shape
# every lock below uses: if CHECK_FN "$@" is already true, "ok"; else,
# under --dry-run, "would-fix" and stop; else run FIX_FN "$@" and report
# "fixed" on success, "FAIL" (and keep going -- one bad lock never stops
# the rest from being asserted) on failure.
assert_one() {
    local lock="$1" check="$2" fix="$3"
    shift 3
    if "$check" "$@"; then
        report ok "$lock"
        return 0
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        report would-fix "$lock"
        return 0
    fi
    if "$fix" "$@"; then
        report fixed "$lock"
    else
        report FAIL "$lock"
    fi
    return 0
}

# --- small helpers not worth a shared lib entry ----------------------------

# group_for_band BAND — the same fixed, documented mapping
# bin/omarchy-kids-provision's group_for_band uses (docs/packaging.md);
# duplicated rather than sourced because omarchy-kids-provision is a
# script (its own `main "$@"` would run if sourced), not a library, and
# this mapping is four stable lines unlikely to ever change independent
# of that file. Accepts both "13+" (Appendix B's spelling) and "13plus"
# (a Chromium policy filename's spelling, since '+' is an awkward
# characters to key on there) for the oldest band.
group_for_band() {
    case "$1" in
        3-5) echo omarchy-kids-3-5 ;;
        6-8) echo omarchy-kids-6-8 ;;
        9-12) echo omarchy-kids-9-12 ;;
        13+|13plus) echo omarchy-kids-13plus ;;
        *) return 1 ;;
    esac
}

profile_field() { conf_get "$KIDS_DIR/$1.conf" "$2" 2>/dev/null || true; }

home_dir_for() { printf '%s/home/%s' "$HOME_ROOT" "$1"; }

# GNU first: on Linux `stat -f` means "filesystem status" and prints that (with a non-zero
# exit for the odd operand), so the BSD-first form tainted the result and the chromium lock
# re-fixed a correct file on every run (seen live 2026-09-02).
file_mode() {
    if stat --version >/dev/null 2>&1; then stat -c '%a' "$1" 2>/dev/null || true
    else stat -f '%Lp' "$1" 2>/dev/null || true; fi
}

# --- per-kid locks ----------------------------------------------------------

# fstab: R-FND-2's bind-mount line. Reuses lib/posture.sh's own writer,
# which is already idempotent (append-if-missing).
fstab_ok() { grep -qxF "$(posture_fstab_line "$1")" "$(posture_fstab)" 2>/dev/null; }
fstab_fix() { posture_add_fstab_line "$1"; }

# mount: the home is actually mounted noexec,nosuid,nodev right now (not
# just that fstab says it should be) -- "mount if not", per the issue.
mount_opts_ok() { [[ "$1" == *noexec* && "$1" == *nosuid* && "$1" == *nodev* ]]; }
mount_ok() {
    local opts
    opts="$(findmnt -no OPTIONS "$(home_dir_for "$1")" 2>/dev/null || true)"
    [[ -n "$opts" ]] && mount_opts_ok "$opts"
}
mount_fix() {
    local account="$1" home opts
    home="$(home_dir_for "$account")"
    opts="$(findmnt -no OPTIONS "$home" 2>/dev/null || true)"
    if [[ -z "$opts" ]]; then
        mount --bind "$home" "$home" || return 1
    fi
    mount -o remount,bind,nosuid,nodev,noexec "$home"
}

# namespace: R-FND-2a's two pam_namespace.conf lines for this account.
namespace_ok() {
    local file
    file="$(posture_namespace_conf)"
    [[ -f "$file" ]] || return 1
    grep -qxF "$(posture_namespace_line_tmp "$1")" "$file" \
        && grep -qxF "$(posture_namespace_line_shm "$1")" "$file"
}
namespace_fix() { posture_add_namespace_lines "$1"; }

# accountsservice: R-LOGIN-3's session pin, exact content match (same
# idempotence check posture_write_accountsservice itself uses).
accountsservice_ok() {
    local account="$1" avatar="$2" file
    file="$(posture_accountsservice_dir)/$account"
    [[ -f "$file" ]] && [[ "$(cat "$file")" == "$(posture_accountsservice_text "$avatar")" ]]
}
accountsservice_fix() { posture_write_accountsservice "$1" "$2"; }

# gecos (issue #39): the greeter's realName comes from the passwd GECOS
# field, not AccountsService -- SDDM's UserModel reads getpwnam(3)'s
# pw_gecos (docs/portal.md). "add" sets it once with `usermod -c`; this
# re-asserts it against a stray edit or a package reinstall the same way
# every other per-kid lock here does. Needs `getent` to read the field
# back; a box without one (this repo's own macOS dev environment --
# docs/provision.md's own note on `lsblk` is the same situation) has
# nothing to compare against, so this reports "ok" rather than guessing
# at a fix it can't verify.
gecos_ok() {
    local account="$1" name="$2" current
    command -v getent >/dev/null 2>&1 || return 0
    current="$(getent passwd "$account" 2>/dev/null | cut -d: -f5)"
    [[ "$current" == "$name" ]]
}
gecos_fix() { usermod -c "$2" "$1"; }

# face (issue #39, live VM finding): the actual file SDDM's UserModel
# reads for the avatar on this stack -- lib/posture.sh's own header
# comment on posture_write_face_icon has the full UserModel.cpp
# citation for why AccountsService's Icon= line isn't it.
face_ok() {
    local account="$1" avatar="$2" src file
    src="$SHARE/avatars/$avatar.svg"
    file="$(posture_sddm_faces_dir)/$account.face.icon"
    [[ -f "$file" ]] && cmp -s "$src" "$file"
}
face_fix() { posture_write_face_icon "$SHARE/avatars/$2.svg" "$1"; }

# groups: member of omarchy-kids and the band group. No writer for this
# in lib/posture.sh (omarchy-kids-provision sets it once via `useradd -G`
# at creation time, not through a posture_* function), so this is the one
# lock re-implemented here rather than reused, per the issue's own
# `usermod -aG` instruction.
current_groups() { id -nG "$1" 2>/dev/null || true; }
has_group() { [[ " $1 " == *" $2 "* ]]; }
groups_ok() {
    local account="$1" band="$2" group current
    group="$(group_for_band "$band")" || return 1
    current="$(current_groups "$account")"
    has_group "$current" omarchy-kids && has_group "$current" "$group"
}
groups_fix() {
    local account="$1" band="$2" group current missing=()
    group="$(group_for_band "$band")" || return 1
    current="$(current_groups "$account")"
    has_group "$current" omarchy-kids || missing+=(omarchy-kids)
    has_group "$current" "$group" || missing+=("$group")
    [[ ${#missing[@]} -eq 0 ]] && return 0
    local IFS=,
    usermod -aG "${missing[*]}" "$account"
}

# --- machine-level locks ----------------------------------------------------

polkit_admin_ok() {
    local parent file
    parent="$(conf_get "$MACHINE_CONF" parent 2>/dev/null || true)"
    [[ -n "$parent" ]] || return 1
    file="$(posture_polkit_dir)/40-omarchy-kids.rules"
    [[ -f "$file" ]] && [[ "$(cat "$file")" == "$(posture_polkit_admin_rule_text "$parent")" ]]
}
polkit_admin_fix() {
    local parent
    parent="$(conf_get "$MACHINE_CONF" parent 2>/dev/null || true)"
    [[ -n "$parent" ]] || return 1
    posture_write_polkit_admin_rule "$parent"
}

polkit_deny_ok() {
    local file
    file="$(posture_polkit_dir)/41-omarchy-kids-deny.rules"
    [[ -f "$file" ]] && [[ "$(cat "$file")" == "$(posture_polkit_deny_rule_text)" ]]
}
polkit_deny_fix() { posture_write_polkit_deny_rule; }

# sddm-theme (R-LOGIN, issue #14): the portal's conf.d drop-in, exact
# content match (same idempotence check posture_write_sddm_theme_dropin
# itself uses). Machine-level like the polkit rules above.
sddm_theme_ok() {
    local file
    file="$(posture_sddm_conf_dir)/zz-omarchy-kids-theme.conf"
    [[ -f "$file" ]] && [[ "$(cat "$file")" == "$(posture_sddm_theme_dropin_text)" ]]
}
sddm_theme_fix() { posture_write_sddm_theme_dropin; }

# portal-conf (issue #39): the installed theme's theme.conf.user,
# rebuilt from the current, known-correct set of kid profiles plus
# machine.conf's parent= every time -- same "recompute the whole thing,
# exact-content match" shape sddm-theme/polkit-admin above already use,
# not reconstructed incrementally, so a stray hand-edit or a kid profile
# quietly falling out of sync with the file can't leave stale entries
# behind. Replaces an earlier portal.json + sddm.service XHR drop-in
# design: that drop-in only took effect after `systemctl restart sddm`,
# which on an already-booted machine re-fires the owner's stock
# autologin -- see lib/posture.sh's own header comment on
# posture_write_portal_conf for the SDDM ThemeConfig citation this
# replacement rests on instead.
portal_conf_entries() {
    local f account name avatar
    for f in "$KIDS_DIR"/*.conf; do
        [[ -e "$f" ]] || continue
        account="$(basename "$f" .conf)"
        name="$(conf_get "$f" name 2>/dev/null || true)"
        avatar="$(conf_get "$f" avatar 2>/dev/null || true)"
        printf '%s\t%s\t%s\n' "$account" "$name" "$avatar"
    done
}
portal_conf_expected() {
    local parent entries=() line
    parent="$(conf_get "$MACHINE_CONF" parent 2>/dev/null || true)"
    [[ -n "$parent" ]] || return 1
    while IFS= read -r line; do
        [[ -n "$line" ]] && entries+=("$line")
    done < <(portal_conf_entries)
    posture_portal_conf_text "$parent" "${entries[@]+"${entries[@]}"}"
}
portal_conf_ok() {
    local expected file
    expected="$(portal_conf_expected)" || return 1
    file="$(posture_sddm_theme_dir)/theme.conf.user"
    [[ -f "$file" ]] && [[ "$(cat "$file")" == "$expected" ]]
}
portal_conf_fix() {
    local parent entries=() line
    parent="$(conf_get "$MACHINE_CONF" parent 2>/dev/null || true)"
    [[ -n "$parent" ]] || return 1
    while IFS= read -r line; do
        [[ -n "$line" ]] && entries+=("$line")
    done < <(portal_conf_entries)
    posture_write_portal_conf "$parent" "${entries[@]+"${entries[@]}"}"
}

pam_ok() {
    local file
    file="$(posture_pam_dir)/$1"
    [[ -f "$file" ]] && grep -qxF "$(posture_pam_namespace_marker)" "$file"
}
pam_fix() { posture_ensure_pam_namespace "$1"; }

# parent-unlock (R-SEC-2, R-SEC-3): the pam_exec line docs/authd.md
# describes, on sddm and on whichever lock-screen stack this box actually
# has (posture_parent_unlock_lock_stack). "ok" if the stack doesn't exist
# at all on this box (nothing to disprove -- same shape as boot_hook_ok,
# chromium_ok's directory guard, limine_editor_ok below); the fix can
# still fail and report FAIL if the stack exists but has no pam_unix.so
# line to anchor on, same as every other lock here.
parent_unlock_ok() {
    local file
    file="$(posture_pam_dir)/$1"
    [[ -f "$file" ]] || return 0
    grep -qxF "$(posture_parent_unlock_marker)" "$file"
}
parent_unlock_fix() { posture_ensure_parent_unlock_line "$1"; }

# getty@tty2..6 masked (R-FND-5): masking is nothing more than a symlink
# to /dev/null at the unit's path -- the same thing `systemctl mask`
# itself does, --root or not, without needing a live systemd -- so the
# check reads that symlink directly and only the fix shells out, matching
# how omarchy-kids-provision already masks these (docs/provision.md).
getty_unit_path() { printf '%s/etc/systemd/system/getty@tty%s.service' "$(posture_root)" "$1"; }
getty_ok() {
    local link
    link="$(getty_unit_path "$1")"
    [[ -L "$link" ]] && [[ "$(readlink "$link")" == "/dev/null" ]]
}
getty_fix() {
    local root_args=()
    [[ -n "$(posture_root)" ]] && root_args=(--root="$(posture_root)")
    systemctl "${root_args[@]}" mask "getty@tty$1.service"
}

# units (R-BOOT-3, R-SEC-2): the package's units must be enabled or the
# per-boot autologin drop-in is never written and the owner's stock
# autologin wins. Path-based check (like getty_ok) so it works on a test
# root; the fix is plain `systemctl enable`, which also works with --root.
KIDS_UNITS=(omarchy-kids-boot-login.service omarchy-kids-boot-login-cleanup.service omarchy-kids-assert.service)
KIDS_SOCKETS=(omarchy-kids-authd.socket)
unit_link() { printf '%s/etc/systemd/system/%s.wants/%s' "$(posture_root)" "$1" "$2"; }
units_ok() {
    local u
    for u in "${KIDS_UNITS[@]}"; do [[ -L "$(unit_link multi-user.target "$u")" ]] || return 1; done
    for u in "${KIDS_SOCKETS[@]}"; do [[ -L "$(unit_link sockets.target "$u")" ]] || return 1; done
}
units_fix() {
    local root_args=()
    [[ -n "$(posture_root)" ]] && root_args=(--root="$(posture_root)")
    systemctl "${root_args[@]}" enable "${KIDS_UNITS[@]}" "${KIDS_SOCKETS[@]}"
}

# hyprland configs: every *.lua in $SHARE/hyprland copied verbatim to
# $ETC/hyprland (R-DESK-1). Prefers omarchy-kids-session --install-configs
# if that ever exists (it doesn't yet -- verified against this checkout),
# so this starts using the real thing automatically once it lands,
# without needing to change here.
HYPR_SHARE="$SHARE/hyprland"
HYPR_ETC="$ETC/hyprland"
hyprland_ok() {
    [[ -d "$HYPR_SHARE" ]] || return 0
    local f base
    for f in "$HYPR_SHARE"/*.lua; do
        [[ -e "$f" ]] || continue
        base="$(basename "$f")"
        [[ -f "$HYPR_ETC/$base" ]] || return 1
        cmp -s "$f" "$HYPR_ETC/$base" || return 1
    done
    return 0
}
hyprland_fix() {
    [[ -d "$HYPR_SHARE" ]] || return 0
    if command -v omarchy-kids-session >/dev/null 2>&1 \
        && OMARCHY_KIDS_ETC="$ETC" OMARCHY_KIDS_SHARE="$SHARE" omarchy-kids-session --install-configs >/dev/null 2>&1; then
        return 0
    fi
    install -d -m 0755 "$HYPR_ETC" || return 1
    local f base
    for f in "$HYPR_SHARE"/*.lua; do
        [[ -e "$f" ]] || continue
        base="$(basename "$f")"
        # atomic replace: Hyprland reloads on change, a half-written file shows a red banner
        install -m 0644 "$f" "$HYPR_ETC/.$base.tmp" && mv -f "$HYPR_ETC/.$base.tmp" "$HYPR_ETC/$base" || return 1
    done
}

# Chromium policy files (R-WEB-1): mode/owner only, and only for files
# that already exist -- this command never creates one (no writer for
# them exists yet; see docs/assert.md's judgment calls). Ownership is
# attempted best-effort and never decides ok/fixed/FAIL, matching
# docs/provision.md's own stated reasoning: real runs are always root, at
# which point every file this creates is already root-owned anyway.
chromium_dir() { printf '%s/etc/chromium/policies/managed' "$(posture_root)"; }
chromium_ok() { [[ "$(file_mode "$1")" == "640" ]]; }
chromium_fix() {
    local file="$1" band="$2" group
    chmod 0640 "$file" || return 1
    group="$(group_for_band "$band" 2>/dev/null || true)"
    [[ -n "$group" ]] && chown "root:$group" "$file" >/dev/null 2>&1
    return 0
}

# Boot hook (R-BOOT-5): only checked if the hook file the package installs
# is actually present on this box; nothing to assert otherwise.
HOOK_FILE="$(posture_root)/usr/lib/initcpio/hooks/omarchy-kids-unlock"
find_uki() {
    if [[ -n "${OMARCHY_KIDS_UKI:-}" ]]; then
        printf '%s\n' "$OMARCHY_KIDS_UKI"
        return 0
    fi
    local f
    for f in "$(posture_root)"/boot/EFI/Linux/*.efi; do
        [[ -e "$f" ]] || continue
        printf '%s\n' "$f"
        return 0
    done
    return 1
}
boot_hook_ok() {
    local uki tmp rc
    uki="$(find_uki)" || return 0  # no image found to check -- nothing to disprove
    tmp="$(mktemp "${TMPDIR:-/tmp}/omarchy-kids-assert-initrd.XXXXXX")"
    if objcopy -O binary --only-section=.initrd "$uki" "$tmp" 2>/dev/null \
        && lsinitcpio "$tmp" 2>/dev/null | grep -q omarchy-kids-unlock; then
        rc=0
    else
        rc=1
    fi
    rm -f "$tmp"
    return "$rc"
}
boot_hook_fix() { mkinitcpio -P; }

# --- main --------------------------------------------------------------

list_kids() {
    [[ -d "$KIDS_DIR" ]] || return 0
    local f
    for f in "$KIDS_DIR"/*.conf; do
        [[ -e "$f" ]] || continue
        basename "$f" .conf
    done
}

# --- Limine editor (V6): the menu editor and "Blank Entry" let anyone append init=/bin/bash ---
limine_conf() { printf '%s/boot/limine.conf' "$(posture_root)"; }
limine_editor_ok() {
    local f; f="$(limine_conf)"
    [[ -f "$f" ]] || return 0   # no Limine config here (a VM without it, a test tree): nothing to assert
    grep -qE '^editor_enabled:[[:space:]]*no[[:space:]]*$' "$f"
}
limine_editor_fix() {
    local f tmp; f="$(limine_conf)"
    [[ -f "$f" ]] || return 0
    tmp="$(mktemp)"
    # Drop any existing editor_enabled line, then put ours first so a regenerated file gets it back.
    { printf 'editor_enabled: no\n'; grep -vE '^editor_enabled:' "$f"; } > "$tmp" && cat "$tmp" > "$f"
    rm -f "$tmp"
}

# --- Limine snapshot entries (V6, issue #38): a Snapper snapshot from
# before Kids Mode boots a frozen UKI with no unlock hook, no polkit deny
# rule, no boot-login unit, and the owner's stock autologin, on top of the
# live @home -- a kid with a disk password can pick it from the Limine
# menu and land on the parent's desktop. MAX_SNAPSHOT_ENTRIES=0 in
# /etc/default/limine hides every such entry; machine.conf's
# boot.snapshot_entries (docs/conf.md) picks "hide" (default) or "show".
# Machine-level like the locks above: runs once per invocation, only
# while at least one kid is provisioned.
limine_default() { printf '%s/etc/default/limine' "$(posture_root)"; }
LIMINE_SNAPSHOTS_MARKER='# omarchy-kids: was MAX_SNAPSHOT_ENTRIES='

boot_snapshot_entries_mode() {
    local mode
    mode="$(conf_get "$MACHINE_CONF" boot.snapshot_entries 2>/dev/null || true)"
    [[ "$mode" == "show" ]] && { echo show; return; }
    echo hide
}

# limine_snapshots_marker_value FILE — the value remembered in our own
# comment line, if any (the value MAX_SNAPSHOT_ENTRIES held before we
# first set it to 0).
limine_snapshots_marker_value() {
    local f="$1" line
    line="$(grep -F "$LIMINE_SNAPSHOTS_MARKER" "$f" 2>/dev/null | tail -n1 || true)"
    [[ -n "$line" ]] && printf '%s' "${line#"$LIMINE_SNAPSHOTS_MARKER"}"
}

limine_snapshots_ok() {
    local f; f="$(limine_default)"
    [[ -f "$f" ]] || return 0   # no /etc/default/limine here (no Limine, or a test tree): nothing to assert
    case "$(boot_snapshot_entries_mode)" in
        hide) grep -qxF 'MAX_SNAPSHOT_ENTRIES=0' "$f" ;;
        show) ! grep -qxF 'MAX_SNAPSHOT_ENTRIES=0' "$f" ;;
    esac
}

limine_snapshots_fix() {
    local f tmp mode; f="$(limine_default)"
    [[ -f "$f" ]] || return 0
    mode="$(boot_snapshot_entries_mode)"
    tmp="$(mktemp)" || return 1
    case "$mode" in
        hide)
            local old="" have_marker=0
            grep -qF "$LIMINE_SNAPSHOTS_MARKER" "$f" && have_marker=1
            if [[ "$have_marker" -eq 0 ]]; then
                old="$(grep -E '^MAX_SNAPSHOT_ENTRIES=' "$f" | tail -n1 || true)"
                old="${old#MAX_SNAPSHOT_ENTRIES=}"
            fi
            {
                grep -vE "^MAX_SNAPSHOT_ENTRIES=|^${LIMINE_SNAPSHOTS_MARKER}" "$f" || true
                if [[ "$have_marker" -eq 1 ]]; then
                    grep -F "$LIMINE_SNAPSHOTS_MARKER" "$f"
                elif [[ -n "$old" ]]; then
                    printf '%s%s\n' "$LIMINE_SNAPSHOTS_MARKER" "$old"
                fi
                printf 'MAX_SNAPSHOT_ENTRIES=0\n'
            } > "$tmp" || { rm -f "$tmp"; return 1; }
            ;;
        show)
            local old; old="$(limine_snapshots_marker_value "$f")"
            {
                grep -vE "^MAX_SNAPSHOT_ENTRIES=|^${LIMINE_SNAPSHOTS_MARKER}" "$f" || true
                if [[ -n "$old" ]]; then printf 'MAX_SNAPSHOT_ENTRIES=%s\n' "$old"; fi
                true
            } > "$tmp" || { rm -f "$tmp"; return 1; }
            ;;
    esac
    cat "$tmp" > "$f" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
    # Only a real run (never this dev checkout's tests, per AGENTS.md rule 8)
    # has an empty posture_root; limine-snapper-sync also may not be
    # installed at all (no Limine, no Snapper) -- either way, nothing to do.
    if [[ -z "$(posture_root)" ]] && command -v limine-snapper-sync >/dev/null 2>&1; then
        limine-snapper-sync
    fi
    return 0
}

main() {
    local kids=() k
    while IFS= read -r k; do
        [[ -n "$k" ]] && kids+=("$k")
    done < <(list_kids)

    if [[ ${#kids[@]} -eq 0 ]]; then
        [[ "$QUIET" -eq 1 ]] || echo "omarchy-kids-assert: no kids provisioned; nothing to assert"
        exit 0
    fi

    local account band avatar name
    for account in "${kids[@]}"; do
        band="$(profile_field "$account" band)"
        avatar="$(profile_field "$account" avatar)"
        name="$(profile_field "$account" name)"
        assert_one "fstab:$account" fstab_ok fstab_fix "$account"
        assert_one "mount:$account" mount_ok mount_fix "$account"
        assert_one "namespace:$account" namespace_ok namespace_fix "$account"
        assert_one "accountsservice:$account" accountsservice_ok accountsservice_fix "$account" "$avatar"
        assert_one "gecos:$account" gecos_ok gecos_fix "$account" "$name"
        assert_one "face:$account" face_ok face_fix "$account" "$avatar"
        assert_one "groups:$account" groups_ok groups_fix "$account" "$band"
    done

    assert_one "polkit-admin" polkit_admin_ok polkit_admin_fix
    assert_one "polkit-deny" polkit_deny_ok polkit_deny_fix
    assert_one "sddm-theme" sddm_theme_ok sddm_theme_fix
    assert_one "portal-conf" portal_conf_ok portal_conf_fix
    assert_one "pam:sddm" pam_ok pam_fix sddm
    assert_one "pam:systemd-user" pam_ok pam_fix systemd-user

    local lock_stack
    lock_stack="$(posture_parent_unlock_lock_stack)"
    assert_one "parent-unlock:sddm" parent_unlock_ok parent_unlock_fix sddm
    assert_one "parent-unlock:$lock_stack" parent_unlock_ok parent_unlock_fix "$lock_stack"

    local n
    for n in 2 3 4 5 6; do
        assert_one "getty:tty$n" getty_ok getty_fix "$n"
    done

    assert_one "units" units_ok units_fix

    assert_one "hyprland-configs" hyprland_ok hyprland_fix

    local dir f band_token
    dir="$(chromium_dir)"
    if [[ -d "$dir" ]]; then
        for f in "$dir"/omarchy-kids-*.json; do
            [[ -e "$f" ]] || continue
            band_token="$(basename "$f")"
            band_token="${band_token#omarchy-kids-}"
            band_token="${band_token%.json}"
            assert_one "chromium-policy:$band_token" chromium_ok chromium_fix "$f" "$band_token"
        done
    fi

    if [[ -f "$HOOK_FILE" ]]; then
        assert_one "boot-hook" boot_hook_ok boot_hook_fix
    assert_one "limine-editor" limine_editor_ok limine_editor_fix
    fi

    assert_one "limine-snapshots" limine_snapshots_ok limine_snapshots_fix

    [[ "$ANY_FAIL" -eq 0 ]] || exit 1
    exit 0
}

main
