#!/bin/bash
# Green/red parent screen. Honest about what this machine actually enforces.
set -uo pipefail
G=$'\033[32m'
R=$'\033[31m'
Y=$'\033[33m'
N=$'\033[0m'
pass() { echo "${G}  PASS${N}  $1"; }
fail() { echo "${R}  FAIL${N}  $1"; FAILED=1; }
warn() { echo "${Y}  WARN${N}  $1"; }
FAILED=0
OWNER="$(tr -d '[:space:]' </etc/omarchy-kids/owner 2>/dev/null || true)"

[[ -n "$OWNER" ]] && pass "owner recorded ($OWNER)" || fail "no /etc/omarchy-kids/owner"
[[ -s /etc/omarchy-kids/kid.passwd ]] && pass "kid login hash exists (not shadow)" || fail "no kid login hash"
if [[ -n "$OWNER" ]]; then
  id -nG "$OWNER" 2>/dev/null | grep -qw docker && fail "$OWNER is in docker (root-equivalent)" || pass "$OWNER is not in docker"
fi
[[ -d /var/lib/omarchy-kids/home ]] && pass "kid home store exists" || fail "kid home store missing"
[[ -x /usr/local/bin/omarchy-kids-session ]] && pass "session wrapper installed" || fail "omarchy-kids-session not installed"
[[ -x /usr/local/bin/omarchy-kids-dispatch ]] && pass "session dispatch installed" || fail "dispatch missing"
grep -qs omarchy-kids-pam-auth /etc/pam.d/sddm && pass "SDDM accepts kid password" || fail "PAM kid-auth not in /etc/pam.d/sddm"
grep -qs 'PASSWD: /usr/bin/omarchy-dns' /etc/sudoers.d/zz-omarchy-kids && pass "omarchy-dns requires parent password" || fail "DNS sudoers override missing"
grep -qs 'family.cloudflare-dns.com' /etc/systemd/resolved.conf.d/30-omarchy-kids-family.conf && pass "family DNS on systemd-resolved" || fail "family DNS drop-in missing"
[[ -f /etc/chromium/policies/managed/omarchy-kids.json ]] && pass "Chromium policy locked" || fail "browser policy missing"
[[ -x /usr/local/libexec/omarchy-kids-wifi-connect ]] && pass "Wi-Fi helper installed" || fail "Wi-Fi helper missing"
[[ -f /usr/share/polkit-1/actions/org.omarchy.kids.policy ]] && pass "Wi-Fi polkit action installed" || warn "Wi-Fi polkit action missing"
grep -qs '^editor_enabled: no' /boot/limine.conf 2>/dev/null && pass "boot menu editor off" || warn "boot menu editor still on (or /boot not readable)"
systemctl is-enabled getty@tty1.service 2>/dev/null | grep -q masked && pass "spare TTY off" || warn "getty@tty1 not masked"
passwd -S root 2>/dev/null | grep -qE ' L | LK ' && pass "root locked" || warn "root not locked"

echo
if [[ $FAILED == 0 ]]; then
  echo "${G}══ READY ══${N}  Kid password → namespaced home. Parent password → real home + sudo."
  echo "  Firmware password is still on you."
else
  echo "${R}══ NOT READY — fix the FAILs ══${N}"
  exit 1
fi
