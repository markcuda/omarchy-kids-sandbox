#!/bin/bash
# omarchy:summary=Report whether every Kids Mode lock actually holds
# omarchy:args=[--json] [--live]
# The green/red/yellow "is it safe?" report, read-only (SPEC.md R-TRUST-2, R-TRUST-3, R-DESK-2).
# Reuses omarchy-kids-assert's *_ok functions rather than re-implementing them (see that file's own tail comment).
# See docs/check.md for the full section list and every judgment call.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="${OMARCHY_KIDS_LIB:-$DIR/lib}"; [[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/conf.sh
source "$LIB/conf.sh"
# shellcheck source=lib/posture.sh
source "$LIB/posture.sh"
# shellcheck source=lib/time.sh
source "$LIB/time.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"

ASSERT_BIN="$(kids_bin assert "$DIR")"
RUNUSER_BIN="${OMARCHY_KIDS_RUNUSER_BIN:-runuser}"
LOGINCTL_BIN="${OMARCHY_KIDS_LOGINCTL_BIN:-loginctl}"
PROC_ROOT="${OMARCHY_KIDS_PROC_ROOT:-/proc}"

usage() {
    cat <<'EOF'
Usage: omarchy-kids-check [--json] [--live] [--help]

Read-only "is it safe?" report (SPEC.md R-TRUST-2): every provisioned
kid's account, every omarchy-kids-assert lock, the boot chain, the
portal, PAM, the web policy files, the screen-time engine, and the
firmware-password step. Never writes anything, never fixes anything —
a FAIL means "run omarchy-kids-assert" or "ask a grown-up", not
"already handled".

  --json   Print one JSON object instead of the human report (for the
           panel and the wizard's safety check — see docs/check.md).
  --live   Also run the live tests: as root, briefly become each kid
           (runuser) and confirm sudo, polkit, /tmp, and a downloaded
           executable are actually denied, not just configured to be.
           Requires root; without it this section is skipped, not
           faked.
  -h, --help  Show this help and exit.

Exit codes: 0 every check passed; 1 no FAILs but at least one WARN
("could not verify" or "needs a grown-up's attention", never on its
own a security gap); 2 at least one FAIL.
EOF
}

JSON=0
LIVE=0
for arg in "$@"; do
    case "$arg" in
        --json) JSON=1 ;;
        --live) LIVE=1 ;;
        -h|--help) usage; exit 0 ;;
        *)
            echo "omarchy-kids-check: unknown argument '$arg'" >&2
            usage >&2
            exit 2
            ;;
    esac
done

[[ -r "$ASSERT_BIN" ]] || { echo "omarchy-kids-check: cannot find omarchy-kids-assert at $ASSERT_BIN" >&2; exit 2; }

# source_assert — pulls in every lock's *_ok/*_fix plus the ETC/SHARE/
# KIDS_DIR/etc. variables omarchy-kids-assert resolves. Called from
# inside a function so its "$@" is empty, not this script's --json/--live
# -- see that file's own tail-comment guard for why sourcing it is safe.
source_assert() {
    # shellcheck source=bin/omarchy-kids-assert
    source "$ASSERT_BIN"
}
source_assert

# --- reporting -------------------------------------------------------------

G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; N=$'\033[0m'

RESULTS=()          # "section\x1fid\x1fstatus\x1fdetail" — status: pass/warn/fail/skip
SECTION_ORDER=()
CHECK_ANY_FAIL=0
CHECK_ANY_WARN=0

array_contains() { # array_contains NEEDLE [HAYSTACK...]
    local needle="$1" x
    shift
    for x in "$@"; do [[ "$x" == "$needle" ]] && return 0; done
    return 1
}

# add_result SECTION ID STATUS DETAIL — the one thing every check below
# calls. STATUS is pass/warn/fail/skip; skip never affects the verdict
# (--live not requested, nothing provisioned to check, etc).
add_result() {
    local section="$1" id="$2" status="$3" detail="$4"
    array_contains "$section" "${SECTION_ORDER[@]+"${SECTION_ORDER[@]}"}" || SECTION_ORDER+=("$section")
    RESULTS+=("$section"$'\x1f'"$id"$'\x1f'"$status"$'\x1f'"$detail")
    case "$status" in
        fail) CHECK_ANY_FAIL=1 ;;
        warn) CHECK_ANY_WARN=1 ;;
    esac
}

# lock_check ID CHECK_FN [ARGS...] — the "every assert lock reported via
# the ok functions only" rule: never calls the matching *_fix. A FAIL's
# detail points at docs/assert.md, which already documents in full what
# each lock proves and what its fix does — repeating that here per lock
# would just be a second copy to keep in sync.
lock_check() {
    local id="$1" fn="$2" rc
    shift 2
    "$fn" "$@" && rc=0 || rc=$?
    if [[ "$rc" -eq 0 ]]; then
        add_result Locks "lock:$id" pass "matches what omarchy-kids-assert expects"
    elif [[ "$rc" -eq 2 ]]; then
        # Exit 2 from a *_ok is omarchy-kids-assert's "I could not look"
        # (review S11). A check that cannot see is not a passing check, so
        # this machine is reported as not fully verified rather than green.
        add_result Locks "lock:$id" warn "could not be verified on this machine — see 'omarchy-kids-assert' output for '$id'"
    else
        add_result Locks "lock:$id" fail "does not match what omarchy-kids-assert expects — run 'omarchy-kids-assert' to restore it (docs/assert.md's lock table has what '$id' proves)"
    fi
}

# lock_check_warn — same shape as lock_check, for the one lock that
# isn't a security fence at all: the SDDM face icon (issue #39) only
# controls which picture shows on a kid's portal tile. A kid still logs
# in exactly as fenced either way, so a mismatch here is worth a
# grown-up's attention, never "not ready to hand over" on its own.
lock_check_warn() {
    local id="$1" fn="$2"
    shift 2
    if "$fn" "$@"; then
        add_result Locks "lock:$id" pass "matches what omarchy-kids-assert expects"
    else
        add_result Locks "lock:$id" warn "does not match what omarchy-kids-assert expects (cosmetic only, no security consequence) — run 'omarchy-kids-assert' to restore it"
    fi
}

kid_conf_count() {
    local n=0 acct
    while IFS= read -r acct; do
        [[ -n "$acct" ]] && n=$((n + 1))
    done < <(kids_list "$KIDS_DIR")
    printf '%s' "$n"
}

# --- thin dispatch: one lib/check-<area>.sh per report section -------------

# shellcheck source=lib/check-accounts.sh
source "$LIB/check-accounts.sh"
# shellcheck source=lib/check-locks.sh
source "$LIB/check-locks.sh"
# shellcheck source=lib/check-boot.sh
source "$LIB/check-boot.sh"
# shellcheck source=lib/check-login.sh
source "$LIB/check-login.sh"
# shellcheck source=lib/check-pam.sh
source "$LIB/check-pam.sh"
# shellcheck source=lib/check-web.sh
source "$LIB/check-web.sh"
# shellcheck source=lib/check-time.sh
source "$LIB/check-time.sh"
# shellcheck source=lib/check-firmware.sh
source "$LIB/check-firmware.sh"
# shellcheck source=lib/check-live.sh
source "$LIB/check-live.sh"
# shellcheck source=lib/check-render.sh
source "$LIB/check-render.sh"
# --- main --------------------------------------------------------------

run_accounts_section
run_locks_section
run_boot_section
run_login_section
run_pam_section
run_web_section
run_time_section
run_firmware_section
run_live_section

VERDICT=pass
EXIT_CODE=0
if [[ "$CHECK_ANY_FAIL" == 1 ]]; then
    VERDICT=fail; EXIT_CODE=2
elif [[ "$CHECK_ANY_WARN" == 1 ]]; then
    VERDICT=warn; EXIT_CODE=1
fi

if [[ "$JSON" == 1 ]]; then
    render_json
else
    render_human
fi

exit "$EXIT_CODE"
