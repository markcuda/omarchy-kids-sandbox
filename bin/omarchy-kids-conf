#!/bin/bash
# omarchy-kids-conf — one way to read and write every kid setting
# (SPEC.md R-BAND-1, R-BAND-2, R-BUILD-5, Appendix B, Appendix C).
#
# Precedence for every Appendix B key: the kid's override
# (/etc/omarchy-kids/kids/<account>.conf), else the kid's band default
# (share/bands/bands.toml, plus share/packs/<band>.toml for allowlist and
# sites), else the global default (dns, history_visible, password,
# onboarded). `band`, `name` and `avatar` have no default at all — they
# must already be in the profile.
#
# Every path is overridable for tests, so test/shell.d/conf-test.sh runs
# entirely against scratch trees:
#   OMARCHY_KIDS_ETC    default /etc/omarchy-kids        (kid overrides live here)
#   OMARCHY_KIDS_SHARE  default /usr/share/omarchy-kids  (bands.toml, packs/)
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# lib/ sits beside bin/ in the repo; the package installs it to /usr/lib/omarchy-kids.
LIB="${OMARCHY_KIDS_LIB:-$DIR/lib}"; [[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
source "$LIB/conf.sh"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
KIDS_DIR="$ETC/kids"
BANDS_TOML="$SHARE/bands/bands.toml"
PACKS_DIR="$SHARE/packs"
PY="${OMARCHY_KIDS_CONF_PY:-python3}"
PYHELPER="$LIB/conf.py"

# Appendix B, in table order.
APPENDIX_B_KEYS=(name avatar band level web dns budget_min budget_min_weekend
    lights_out lights_out_weekend wifi history_visible menu allowlist sites
    password onboarded)
# No default anywhere; must already be an override.
REQUIRED_KEYS=(name avatar band)
# Resolved from the band table in bands.toml when there's no override.
BAND_KEYS=(level web dns budget_min budget_min_weekend lights_out
    lights_out_weekend wifi history_visible menu)
# Resolved from share/packs/<band>.toml when there's no override.
PACK_KEYS=(allowlist sites)
VALID_BANDS=("3-5" "6-8" "9-12" "13+")
# Extension keys (issue #24, docs/apps.md): not in Appendix B, so kept out
# of APPENDIX_B_KEYS, cmd_show's main table, and "reset"'s identity-key
# exemption -- but still one KEY=VALUE line in the same profile file,
# read and written through this same tool (docs/conf.md's "no other
# command touches a kid's .conf file directly" rule applies to these
# too). omarchy-kids-apps is the only caller that needs them:
#   apps.extra   comma-separated launcher ids added on top of the band's
#                pack for this kid ("hide"/"show" edit this and
#                apps.hidden through `omarchy-kids-conf set`, never the
#                raw file)
#   apps.hidden  comma-separated launcher ids removed from this kid's
#                allowlist, pack or apps.extra alike
EXT_KEYS=(apps.extra apps.hidden)

# global_default KEY — prints the Appendix B global default for a key the
# band table doesn't carry (dns, history_visible, password, onboarded)
# and returns 0; returns 1 with nothing printed for any other key. A
# plain case instead of an associative array so this runs on bash 3.2
# too, not just the bash 5 the target (Arch) ships.
global_default() {
    case "$1" in
        dns) echo cloudflare-family ;;
        history_visible) echo yes ;;
        password) echo set ;;
        onboarded) echo no ;;
        apps.extra) echo "" ;;
        apps.hidden) echo "" ;;
        *) return 1 ;;
    esac
}

usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [args]

  get <kid> <key>          effective value: override, else band, else default
  set <kid> <key> <value>  write an override
  show <kid>                every key, its value, and where it came from
  reset <kid>                clear overrides except band/name/avatar/password/onboarded
  bands                      list bands with their label and blurb
  band <band>                print one band's defaults
  slug <display name>        the kid- account-name slug for a display name
  --help                     this text

Env:
  OMARCHY_KIDS_ETC    default /etc/omarchy-kids
  OMARCHY_KIDS_SHARE  default /usr/share/omarchy-kids
EOF
}

die() { echo "omarchy-kids-conf: $1" >&2; exit "${2:-2}"; }

is_valid_key() {
    local key="$1" k
    for k in "${APPENDIX_B_KEYS[@]}" "${EXT_KEYS[@]}"; do [[ "$k" == "$key" ]] && return 0; done
    return 1
}

is_in() { # is_in NEEDLE HAYSTACK...
    local needle="$1"; shift
    local h
    for h in "$@"; do [[ "$h" == "$needle" ]] && return 0; done
    return 1
}

profile_file() { echo "$KIDS_DIR/$1.conf"; }

# validate_value KEY VALUE — exits 2 with a one-line reason on a bad value.
validate_value() {
    local key="$1" value="$2"
    case "$key" in
        name)
            [[ -n "$value" && "$value" != *$'\n'* ]] || die "invalid value for 'name': must be non-empty, single-line text"
            ;;
        avatar)
            [[ "$value" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid value for 'avatar': lowercase id, e.g. 'fox'"
            if [[ -d "$SHARE/avatars" ]] && compgen -G "$SHARE/avatars/*.svg" >/dev/null 2>&1; then
                [[ -f "$SHARE/avatars/$value.svg" ]] || die "invalid value for 'avatar': no such avatar '$value'"
            fi
            ;;
        band)
            is_in "$value" "${VALID_BANDS[@]}" || die "invalid value for 'band': must be one of ${VALID_BANDS[*]}"
            ;;
        level)
            [[ "$value" =~ ^[123]$ ]] || die "invalid value for 'level': must be 1, 2, or 3"
            ;;
        web)
            is_in "$value" garden filtered none || die "invalid value for 'web': must be garden, filtered, or none"
            ;;
        dns)
            case "$value" in
                cloudflare-family|cleanbrowsing-family) ;;
                custom:?*) ;;
                *) die "invalid value for 'dns': cloudflare-family, cleanbrowsing-family, or custom:<url>" ;;
            esac
            ;;
        budget_min|budget_min_weekend)
            [[ "$value" =~ ^[0-9]+$ && "$value" -ge 1 && "$value" -le 1440 ]] || die "invalid value for '$key': integer minutes, 1-1440"
            ;;
        lights_out|lights_out_weekend)
            [[ "$value" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "invalid value for '$key': HH:MM, 24-hour"
            ;;
        wifi)
            is_in "$value" parent helper || die "invalid value for 'wifi': must be parent or helper"
            ;;
        history_visible|onboarded)
            is_in "$value" yes no || die "invalid value for '$key': must be yes or no"
            ;;
        menu)
            is_in "$value" trimmed full || die "invalid value for 'menu': must be trimmed or full"
            ;;
        allowlist)
            [[ "$value" =~ ^[a-z0-9_-]+(,[a-z0-9_-]+)*$ || -z "$value" ]] || die "invalid value for 'allowlist': comma-separated launcher ids"
            ;;
        sites)
            [[ "$value" =~ ^[a-z0-9.-]+(,[a-z0-9.-]+)*$ || -z "$value" ]] || die "invalid value for 'sites': comma-separated hostnames"
            ;;
        password)
            is_in "$value" set none || die "invalid value for 'password': must be set or none"
            ;;
        apps.extra|apps.hidden)
            [[ "$value" =~ ^[a-z0-9_-]+(,[a-z0-9_-]+)*$ || -z "$value" ]] || die "invalid value for '$key': comma-separated launcher ids"
            ;;
        *)
            die "no validator for '$key' (this is a bug)"
            ;;
    esac
}

band_dump_pairs() { # BAND -> "key=value" lines, or exit 2
    "$PY" "$PYHELPER" band-dump "$BANDS_TOML" "$1"
}

band_get() { # BAND KEY -> value, or exit 2
    "$PY" "$PYHELPER" band-get "$BANDS_TOML" "$1" "$2"
}

pack_file() { echo "$PACKS_DIR/$1.toml"; }

pack_value() { # BAND KEY(allowlist|sites) -> comma list, or exit 2
    local band="$1" key="$2" pack
    pack="$(pack_file "$band")"
    [[ -f "$pack" ]] || die "no pack for band '$band' ($pack)"
    case "$key" in
        allowlist) "$PY" "$PYHELPER" pack-ids "$pack" ;;
        sites) "$PY" "$PYHELPER" pack-sites "$pack" ;;
    esac
}

# resolve KID KEY -> prints "value\tsource" (source: override|band|default),
# or exits 2 if there is truly nothing to resolve to.
resolve() {
    local kid="$1" key="$2" profile band value
    profile="$(profile_file "$kid")"

    if value="$(conf_get "$profile" "$key")"; then
        printf '%s\toverride\n' "$value"
        return 0
    fi

    if is_in "$key" "${REQUIRED_KEYS[@]}"; then
        die "kid '$kid' has no '$key' set and it has no default (see docs/conf.md)"
    fi

    if ! band="$(conf_get "$profile" band)"; then
        die "kid '$kid' has no band set; cannot resolve '$key'"
    fi

    if is_in "$key" "${BAND_KEYS[@]}"; then
        value="$(band_get "$band" "$key")"
        printf '%s\tband\n' "$value"
        return 0
    fi

    if is_in "$key" "${PACK_KEYS[@]}"; then
        value="$(pack_value "$band" "$key")"
        printf '%s\tband\n' "$value"
        return 0
    fi

    if value="$(global_default "$key")"; then
        printf '%s\tdefault\n' "$value"
        return 0
    fi

    die "no default for '$key' (this is a bug)"
}

cmd_get() {
    local kid="${1:?omarchy-kids-conf get <kid> <key>}" key="${2:?omarchy-kids-conf get <kid> <key>}"
    is_valid_key "$key" || die "unknown key: '$key' (see docs/conf.md)"
    local out value
    out="$(resolve "$kid" "$key")"
    value="${out%%$'\t'*}"
    printf '%s\n' "$value"
}

cmd_set() {
    local kid="${1:?omarchy-kids-conf set <kid> <key> <value>}" key="${2:?omarchy-kids-conf set <kid> <key> <value>}"
    shift 2 || true
    local value="$*"
    is_valid_key "$key" || die "unknown key: '$key' (see docs/conf.md)"
    validate_value "$key" "$value"
    conf_set "$(profile_file "$kid")" "$key" "$value"
    echo "$kid: $key=$value"
}

cmd_show() {
    local kid="${1:?omarchy-kids-conf show <kid>}" key out value source
    printf '%-20s %-30s %s\n' KEY VALUE SOURCE
    for key in "${APPENDIX_B_KEYS[@]}" "${EXT_KEYS[@]}"; do
        out="$(resolve "$kid" "$key")"
        value="${out%%$'\t'*}"
        source="${out##*$'\t'}"
        printf '%-20s %-30s %s\n' "$key" "$value" "$source"
    done
}

cmd_reset() {
    local kid="${1:?omarchy-kids-conf reset <kid>}" profile key
    profile="$(profile_file "$kid")"
    [[ -e "$profile" ]] || die "kid '$kid' has no profile ($profile)"
    for key in "${APPENDIX_B_KEYS[@]}" "${EXT_KEYS[@]}"; do
        is_in "$key" band name avatar password onboarded && continue
        conf_del "$profile" "$key"
    done
    echo "$kid: reset to band defaults"
}

cmd_bands() {
    "$PY" "$PYHELPER" band-list "$BANDS_TOML" | while IFS=$'\t' read -r band label blurb; do
        printf '%-8s %-14s %s\n' "$band" "$label" "$blurb"
    done
}

cmd_band() {
    local band="${1:?omarchy-kids-conf band <band>}"
    is_in "$band" "${VALID_BANDS[@]}" || die "unknown band: '$band' (must be one of ${VALID_BANDS[*]})"
    band_dump_pairs "$band"
}

cmd_slug() {
    [[ $# -ge 1 ]] || die "omarchy-kids-conf slug <display name>"
    "$PY" "$PYHELPER" slug "$@"
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        get) shift; cmd_get "$@" ;;
        set) shift; cmd_set "$@" ;;
        show) shift; cmd_show "$@" ;;
        reset) shift; cmd_reset "$@" ;;
        bands) shift; cmd_bands "$@" ;;
        band) shift; cmd_band "$@" ;;
        slug) shift; cmd_slug "$@" ;;
        -h|--help|"") usage; [[ "$cmd" == "" ]] && exit 2; exit 0 ;;
        *) die "unknown command: '$cmd' (see --help)" ;;
    esac
}

main "$@"
