#!/bin/bash
# omarchy:summary=Open the exit modal, or end a kid's session for real
# omarchy:args=[--open|--finish|--pause] | --finish --kid <account>
# Opens the exit modal (Super+Shift+K or a triple Super tap) or ends a session for real (SPEC.md R-EXIT-1..6).
# See docs/exit.md for the full picture, including what's still unverified against a real session.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"; [[ -f "$LIB/kids.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
CONF_BIN="$(kids_bin conf "$DIR")"
MODAL_QML="$SHARE/exit-modal/shell.qml"
RUN="${OMARCHY_KIDS_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-kids}"
MODAL_PIDFILE="$RUN/exit-modal.pid"

die() { echo "omarchy-kids-exit: $1" >&2; exit "${2:-2}"; }

usage() {
  cat <<EOF
Usage: omarchy-kids-exit [--open|--finish|--pause]
       omarchy-kids-exit --finish --kid <account>

Bound to Super+Shift+K in every Kids Mode Hyprland level
(share/hyprland/L1.lua, L2.lua, L3.lua) and to three Super taps within
1.5s (bin/omarchy-kids-super-tap). See docs/exit.md.

  --open      Show the exit modal (default). A no-op if it looks like
              one is already up.
  --finish    End the kid's session cleanly (SPEC.md R-EXIT-3). Run by
              the modal's own Finish button after the parent password
              verifies -- not meant to be run directly by a kid.
  --finish --kid <account>
              Root only. End <account>'s session from outside it (the
              bar widget's "end session" row, bin/omarchy-kids-bar end --
              see docs/exit.md). Same idea as plain --finish, reached
              through that account's own Hyprland instance instead of
              this process's own.
  --pause     Not implemented yet (docs/phase1/V1.md, DECISIONS-NEEDED.md).
              Prints why and exits 2.

Env:
  OMARCHY_KIDS_SHARE     default /usr/share/omarchy-kids (exit-modal/shell.qml lives under here)
  OMARCHY_KIDS_EXIT_WAIT seconds to wait for Hyprland to exit cleanly before
                         falling back to loginctl (default 8; both --finish
                         forms)
  OMARCHY_KIDS_RUN_USER_ROOT  where --finish --kid looks for the kid's own
                         runtime dir: <this>/<uid>/hypr/<signature>/
                         (default /run/user, i.e. the kid's real
                         \$XDG_RUNTIME_DIR)

  -h, --help  Show this help and exit.
EOF
}

cmd_open() {
  if modal_already_open "$MODAL_PIDFILE"; then
    exit 0
  fi

  local account name avatar_id
  account="$(id -un)"
  name="$("$CONF_BIN" get "$account" name)" || {
    echo "omarchy-kids-exit: could not read '$account's name from omarchy-kids-conf" >&2
    exit 1
  }
  avatar_id="$("$CONF_BIN" get "$account" avatar)" || {
    echo "omarchy-kids-exit: could not read '$account's avatar from omarchy-kids-conf" >&2
    exit 1
  }

  export OMARCHY_KIDS_ACCOUNT="$account"
  export OMARCHY_KIDS_NAME="$name"
  export OMARCHY_KIDS_AVATAR="$SHARE/avatars/$avatar_id.svg"

  # exec keeps this pid, so $$ is the modal's own pid.
  install -d -m 0700 "$RUN"
  modal_write_pid "$MODAL_PIDFILE"
  exec quickshell -p "$MODAL_QML"
}

# wait_for_hyprland_gone UID — polls up to OMARCHY_KIDS_EXIT_WAIT for no
# Hyprland left owned by UID; 1 once spent (loginctl fallback only then).
wait_for_hyprland_gone() {
  local uid="$1" waited=0 max="${OMARCHY_KIDS_EXIT_WAIT:-8}"
  while (( waited < max )); do
    pgrep -u "$uid" -x Hyprland >/dev/null 2>&1 || return 0
    sleep 1; waited=$((waited + 1))
  done
  return 1
}

cmd_finish() {
  # A hard terminate makes sddm-helper exit 1 and SDDM show nothing at
  # all (seen live 2026-09-02) -- ask the compositor to quit first. docs/exit.md.
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 || hyprctl dispatch exit >/dev/null 2>&1 || true
  fi
  wait_for_hyprland_gone "$(id -u)" && exit 0
  # Last resort only: the compositor ignored the request.
  exec loginctl terminate-session "${XDG_SESSION_ID:?omarchy-kids-exit --finish needs XDG_SESSION_ID}"
}

# cmd_finish_kid ACCOUNT — root-side version of cmd_finish: finds
# ACCOUNT's Hyprland instance(s) under /run/user/<uid>/hypr/ and asks
# each to exit via runuser. docs/exit.md.
cmd_finish_kid() {
  local account="$1"
  [[ -n "$account" ]] || die "--finish --kid needs an account (see --help)"
  if ! is_root; then
    die "--finish --kid must run as root (it is meant to be run by bin/omarchy-kids-bar end, under sudo)" 1
  fi

  local uid
  uid="$(id -u "$account" 2>/dev/null)" || die "--finish --kid: no such account '$account'"

  local run_dir="${OMARCHY_KIDS_RUN_USER_ROOT:-/run/user}/$uid"
  local hypr_dir="$run_dir/hypr"
  local -a sigs=()
  local entry
  if [[ -d "$hypr_dir" ]]; then
    for entry in "$hypr_dir"/*; do
      [[ -d "$entry" ]] || continue
      sigs+=("$(basename "$entry")")
    done
  fi

  if ((${#sigs[@]} == 0)); then
    echo "omarchy-kids-exit: no Hyprland instance found for '$account' under $hypr_dir -- going straight to loginctl terminate-user" >&2
  elif command -v runuser >/dev/null 2>&1; then
    local sig
    for sig in "${sigs[@]}"; do
      runuser -u "$account" -- env "XDG_RUNTIME_DIR=$run_dir" "HYPRLAND_INSTANCE_SIGNATURE=$sig" \
        hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 || true
    done
  fi

  wait_for_hyprland_gone "$uid" && exit 0
  # Last resort only: no session id in hand here, so this ends every
  # session the account has, not one specific scope (docs/exit.md).
  exec loginctl terminate-user "$account"
}

cmd_pause() {
  echo "Pause is not available on this Omarchy version yet (see docs/phase1/V1.md)" >&2
  exit 2
}

action="--open"
kid=""
while (($#)); do
  case "$1" in
    --open|--finish|--pause) action="$1" ;;
    --kid)
      shift
      [[ $# -gt 0 ]] || die "--kid needs an account (see --help)"
      kid="$1"
      ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "omarchy-kids-exit: unknown argument '$1' (see --help)" >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -n "$kid" && "$action" != "--finish" ]]; then
  die "--kid only makes sense with --finish"
fi

case "$action" in
  --open) cmd_open ;;
  --finish)
    # An `if`, not `a && b || c`: under --finish --kid this runs as root,
    # so a cmd_finish_kid that returned non-zero instead of exec'ing (no
    # loginctl, a future early return) would fall through to cmd_finish
    # and terminate root's own session (review §1.9).
    if [[ -n "$kid" ]]; then cmd_finish_kid "$kid"; else cmd_finish; fi
    ;;
  --pause) cmd_pause ;;
esac
