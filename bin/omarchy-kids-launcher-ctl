#!/bin/bash
# omarchy:summary=Tell the big-tile launcher to open or close from a Hyprland bind
# omarchy:args=<show|activate|log ID>
# Where the Level 1/2 Hyprland binds (share/hyprland/L1.lua, L2.lua) reach the big-tile launcher, so the
# Lua files never guess a socket path. See docs/launcher-ctl.md for the show/activate/log protocol.
set -euo pipefail

CONTROL="${OMARCHY_KIDS_LAUNCHER_CONTROL:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-kids/launcher-control}"
LAUNCHES_LOG="${OMARCHY_KIDS_LAUNCHES_LOG:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-kids/launches.log}"
TITLE="Omarchy Kids Launcher"

usage() {
  cat <<EOF
Usage: omarchy-kids-launcher-ctl <show|activate|log ID>

  show      Focus the Level 1/2 launcher window (Super+Home, Super+Space).
  activate  Tell the launcher to open its currently highlighted tile
            (Super+Enter).
  log ID    Record one Level 1 tile launch (R-DATA-1's "app launches").
            Appends "<timestamp> <id>" to this account's own runtime
            launches log; never touches the root-owned one directly.

Env:
  OMARCHY_KIDS_LAUNCHER_CONTROL  control file path (default \$XDG_RUNTIME_DIR/omarchy-kids/launcher-control)
  OMARCHY_KIDS_LAUNCHES_LOG      log's own target file (default \$XDG_RUNTIME_DIR/omarchy-kids/launches.log)
  OMARCHY_KIDS_NOW               "YYYY-MM-DD HH:MM:SS" clock override for log (tests)

  -h, --help  Show this help and exit.
EOF
}

cmd_show() {
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl dispatch focuswindow "title:^(${TITLE})\$" >/dev/null 2>&1 || true
  fi
}

cmd_activate() {
  mkdir -p "$(dirname "$CONTROL")"
  # shell.qml polls this file and compares its full text to the last
  # value it saw (see its header), so the same word twice in a row
  # needs to look different each time -- hence the nonce.
  printf 'activate %s\n' "$(date +%s%N 2>/dev/null || date +%s)" >"$CONTROL"
}

cmd_log() {
  local id="${1:-}"
  [[ -n "$id" ]] || { echo "omarchy-kids-launcher-ctl: log needs an app id" >&2; exit 2; }
  local now
  # Naive local "YYYY-MM-DDTHH:MM:SS" -- one token, no embedded space,
  # matching lib/data.sh/lib/data.py's whole-feature convention (see
  # that file's header on why this package never converts a timezone).
  now="${OMARCHY_KIDS_NOW:-$(date '+%Y-%m-%d %H:%M:%S')}"
  now="${now/ /T}"
  mkdir -p "$(dirname "$LAUNCHES_LOG")" 2>/dev/null || true
  printf '%s %s\n' "$now" "$id" >>"$LAUNCHES_LOG" 2>/dev/null || true
}

case "${1:-}" in
  show) cmd_show ;;
  activate) cmd_activate ;;
  log) shift; cmd_log "${1:-}" ;;
  -h|--help|"") usage; [[ "${1:-}" == "" ]] && exit 2; exit 0 ;;
  *)
    echo "omarchy-kids-launcher-ctl: unknown command: '$1' (see --help)" >&2
    exit 2
    ;;
esac
