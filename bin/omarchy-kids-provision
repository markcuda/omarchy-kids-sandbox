#!/bin/bash
# omarchy:summary=Add or remove a kid's Unix account and every lock it needs
# omarchy:args=<add <display-name> --band <band>|remove <account>|list>
# Adds and removes a kid account: the Unix account, profile, and every
# lock provisioning needs (SPEC.md R-FND-2..6, R-SEC-3..5, R-LOGIN-3,
# Appendix B). DRY_RUN=1 by default; --apply/DRY_RUN=0 makes it real.
# See docs/provision.md for the exact order, every env var, and what
# each step touches.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="${OMARCHY_KIDS_LIB:-$DIR/lib}"; [[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/conf.sh
source "$LIB/conf.sh"
# shellcheck source=lib/posture.sh
source "$LIB/posture.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"

DRY_RUN="${DRY_RUN:-1}"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
HOME_ROOT="${OMARCHY_KIDS_HOME_ROOT:-}"
KIDS_DIR="$ETC/kids"
SLOTS_FILE="$ETC/luks-slots"
MACHINE_CONF="$ETC/machine.conf"

CONF="$(kids_bin conf "$DIR")"

VALID_BANDS=("3-5" "6-8" "9-12" "13+")

die() { echo "omarchy-kids-provision: $1" >&2; exit "${2:-2}"; }

usage() {
    cat <<'EOF'
Usage: omarchy-kids-provision add <display-name> --band <band>
           [--avatar ID] [--password-stdin | --no-password]
           [--parent-password-stdin] [--parent-password-fd N]
           [--luks-device DEV] [--apply]
       omarchy-kids-provision remove <account> [--keep-home] [--apply]
       omarchy-kids-provision list
       omarchy-kids-provision --help

add     Creates the Unix account, the profile, the polkit/pam/fstab
        posture, an AccountsService pin, the SDDM portal theme selection
        (R-LOGIN), a LUKS key slot if a password and an encrypted root
        device are both in play, and either runs omarchy-provision-user
        or marks Omarchy's per-user migrations done -- so the new
        desktop never shows "Pending Omarchy Migrations". Also matches
        the kid's own desktop theme to the parent's current one
        (docs/theming.md). Bands: 3-5, 6-8, 9-12, 13+.

        The kid's password is read from stdin (never argv), one line,
        with --password-stdin. --no-password locks the account instead,
        and is only accepted for band 3-5 (R-SEC-3). When a LUKS slot is
        also being added, the parent's own passphrase (needed to
        authorize the add) is the *second* line of the same stdin with
        --parent-password-stdin, or comes from an already-open file
        descriptor with --parent-password-fd N.

remove  Reverses everything "add" did for that account: LUKS slot,
        luks-slots rewrite, pam_namespace lines, AccountsService file,
        fstab line and mount, profile, then the account itself. The home
        moves to "<parent home>/Kids Mode/<name>/" unless --keep-home.
        Machine-level pieces (groups, console masks, the polkit rules)
        are left for Remove Kids Mode.

list    One line per provisioned kid: account, name, band.

DRY_RUN=1 is the default everywhere (see AGENTS.md rule 8): every command
above only prints what it would do. Pass --apply, or set DRY_RUN=0, to
make it real.
EOF
}

# ensure_parent_unlock_soft STACK — posture_ensure_parent_unlock_line
# through `run` (so DRY_RUN=1's default just prints the plan), but never
# aborts the add: a target PAM stack this box hasn't written yet (no
# omarchy-lock-password configured, i.e. omarchy-apply-lock hasn't run
# yet) is a warning, not a reason to fail provisioning the account.
# omarchy-kids-assert is what re-asserts this lock going forward once
# the stack does exist.
ensure_parent_unlock_soft() {
    local stack="$1"
    if ! run posture_ensure_parent_unlock_line "$stack"; then
        echo "warning: could not add the parent-unlock line to pam.d/$stack (see stderr above)" >&2
    fi
}

is_valid_band() {
    local b="$1" v
    for v in "${VALID_BANDS[@]}"; do [[ "$v" == "$b" ]] && return 0; done
    return 1
}

# valid_display_name NAME — see cmd_add's own note (review S10).
valid_display_name() {
    local name="$1"
    [[ ${#name} -ge 1 && ${#name} -le 64 ]] || return 1
    [[ "$name" != *:* && "$name" != *,* ]] || return 1
    [[ "$name" != *$'\t'* && "$name" != *$'\n'* ]] || return 1
    return 0
}

# band_field BAND KEY — one value out of `omarchy-kids-conf band BAND`
# (password_min, password_optional -- the band-only fields, docs/conf.md).
band_field() {
    local band="$1" key="$2" out
    out="$("$CONF" band "$band")" || die "could not read band '$band' defaults from $CONF"
    printf '%s\n' "$out" | sed -n "s/^${key}=//p" | head -1
}

# read_parent — the "parent=" account name from $MACHINE_CONF, via
# lib/conf.sh's conf_get (the format's one shared reader).
read_parent() { conf_get "$MACHINE_CONF" parent 2>/dev/null || true; }

# --- luks-slots parsing (the file lib/posture.sh's posture_write_luks_slots
# rewrites; see docs/boot.md for the "slot=account[:session]" format) -------

luks_slots_parent_line() {
    local file="$1" line
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            ''|'#'*) continue ;;
            0=*) printf '%s\n' "$line"; return 0 ;;
        esac
    done < "$file"
}

# luks_slots_kid_entries FILE — every "slot=account[:session]" line whose
# slot isn't 0, one per line.
luks_slots_kid_entries() {
    local file="$1" line key
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in ''|'#'*) continue ;; esac
        key="${line%%=*}"
        [[ "$key" == "0" ]] && continue
        printf '%s\n' "$line"
    done < "$file"
}

luks_slot_for_account() {
    local file="$1" account="$2" line key val acct
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in ''|'#'*) continue ;; esac
        key="${line%%=*}"; val="${line#*=}"
        acct="${val%%:*}"
        if [[ "$acct" == "$account" ]]; then
            printf '%s\n' "$key"
            return 0
        fi
    done < "$file"
}

# --- theme.conf.user (R-LOGIN, issue #39) -----------------------------------

unique_account() {
    local base="$1" n=2
    local account="$base"
    while [[ -e "$KIDS_DIR/$account.conf" ]] \
        || { command -v getent >/dev/null 2>&1 && getent passwd "$account" >/dev/null 2>&1; }; do
        account="${base}-${n}"
        n=$((n + 1))
    done
    printf '%s\n' "$account"
}

# --- Omarchy per-user migrations (issue #10 finding b) ---------------------

# mark_migrations_done ACCOUNT — best-effort stand-in for
# omarchy-provision-user, run only when it doesn't exist. A documented
# guess at the marker format (~/.local/state/omarchy/migrations.log),
# not verified against a real Omarchy install -- TODO(#10). See
# docs/provision.md's "Known gap".
mark_migrations_done() {
    local account="$1" home migrations_src state_dir f
    home="$(home_dir_for "$account")"
    migrations_src="${OMARCHY_MIGRATIONS_DIR:-/usr/share/omarchy/migrations}"
    state_dir="$home/.local/state/omarchy"
    install -d -m 0700 "$state_dir"
    {
        if [[ -d "$migrations_src" ]]; then
            for f in "$migrations_src"/*; do
                [[ -e "$f" ]] || continue
                printf '%s %s\n' "$(basename "$f")" "$(date -u +%FT%TZ)"
            done
        fi
    } > "$state_dir/migrations.log"
}

# --- Chromium launch flags override (issue #44) -----------------------

# install_kids_chromium_flags ACCOUNT — overwrites
# ~/.config/chromium-flags.conf with Kids Mode's own copy (same file
# bin/omarchy-kids-web's `launch` uses), replacing Omarchy's own copy
# whose --load-extension=... flags the kids policy always refuses (the
# same "disabled by the administrator" modal `web launch` avoids).
# Root:root 0644: readable, not writable, so a kid can't put the flag
# back by editing it (deleting it is still possible -- ~/.config is
# theirs -- but that just leaves no flags file at all).
install_kids_chromium_flags() {
    local account="$1" home config_dir dest stage
    home="$(home_dir_for "$account")"
    config_dir="$home/.config"
    install -d -m 0755 "$config_dir"
    dest="$config_dir/chromium-flags.conf"
    stage="$(mktemp "$config_dir/.chromium-flags.conf.XXXXXX")"
    cp -f "$SHARE/policy/chromium-flags.conf" "$stage"
    chmod 0644 "$stage"
    mv -f "$stage" "$dest"
    if ! chown root:root "$dest" >/dev/null 2>&1; then
        echo "  (could not chown $dest to root:root -- fine outside a real root run)" >&2
    fi
}

# --- thin dispatch: one lib/provision-<verb>.sh per subcommand -------------

# shellcheck source=lib/provision-add.sh
source "$LIB/provision-add.sh"
# shellcheck source=lib/provision-remove.sh
source "$LIB/provision-remove.sh"

# --- list ------------------------------------------------------------------

cmd_list() {
    if [[ ! -d "$KIDS_DIR" ]]; then
        echo "no kids provisioned yet"
        return 0
    fi
    local f any=0 account name band
    for f in "$KIDS_DIR"/*.conf; do
        [[ -e "$f" ]] || continue
        any=1
        account="$(basename "$f" .conf)"
        name="$(conf_get "$f" name 2>/dev/null || echo '?')"
        band="$(conf_get "$f" band 2>/dev/null || echo '?')"
        printf '%s\t%s\t%s\n' "$account" "$name" "$band"
    done
    [[ $any == 1 ]] || echo "no kids provisioned yet"
}

# --- main --------------------------------------------------------------

main() {
    local cmd="${1:-}"
    case "$cmd" in
        -h|--help|"")
            usage
            [[ "$cmd" == "" ]] && exit 2
            exit 0
            ;;
    esac
    shift

    local -a rest=()
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "--apply" ]]; then
            DRY_RUN=0
        else
            rest+=("$arg")
        fi
    done

    case "$cmd" in
        add) cmd_add "${rest[@]+"${rest[@]}"}" ;;
        remove) cmd_remove "${rest[@]+"${rest[@]}"}" ;;
        list) cmd_list "${rest[@]+"${rest[@]}"}" ;;
        *) die "unknown command: '$cmd' (see --help)" ;;
    esac
}

main "$@"
