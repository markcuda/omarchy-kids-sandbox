#!/bin/bash
# omarchy:summary=Set up one kid Hyprland session: launcher tile, apps, time, web
# Runs once per kid Hyprland session (exec-once/hl.on): the launcher tile, then apps/time/web
# (SPEC.md R-DESK-1, R-DESK-3, R-DESK-5, Appendix E). See docs/session.md for the tile JSON format and every env var.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="${OMARCHY_KIDS_LIB:-$DIR/lib}"; [[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
CONF_BIN="$(kids_bin conf "$DIR")"
APPS_BIN="$(kids_bin apps "$DIR")"
TIME_BIN="$(kids_bin time "$DIR")"
WEB_BIN="$(kids_bin web "$DIR")"
PY="${OMARCHY_KIDS_CONF_PY:-python3}"
PYHELPER="$LIB/conf.py"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
# The kid can only write to their own runtime dir; /run/omarchy-kids is root-owned (found live).
RUN="${OMARCHY_KIDS_RUN:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-kids}"
mkdir -p "$RUN" 2>/dev/null || true
APPLICATIONS_DIRS="${OMARCHY_KIDS_APPLICATIONS_DIRS:-/usr/share/applications:/usr/local/share/applications}"
# Same convention bin/omarchy-kids-apps uses for the one system path this
# package doesn't own (issue #42): SYSROOT/var/lib/omarchy-kids/apps-queue
# is that command's pending-install queue, read here (never written) to
# tell a merely-missing tile apart from one mid-install.
SYSROOT="${OMARCHY_KIDS_ROOT:-}"
QUEUE_FILE="$SYSROOT/var/lib/omarchy-kids/apps-queue"

# log MESSAGE — appends to the same per-session log
# bin/omarchy-kids-session already writes to ($RUN/session-<uid>.log),
# so the R-DESK-2 preflight and this launcher's own tile-building show
# up as one timeline. Never fatal: a log write that fails (a read-only
# $RUN in some test harness) must not take the launcher down with it.
LOG_FILE="$RUN/session-$(id -u).log"
log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG_FILE" 2>/dev/null || true; }

usage() {
  cat <<EOF
Usage: omarchy-kids-session-start

Run from a Kids Mode Hyprland level config's exec-once (share/hyprland/
L1.lua, L2.lua, L3.lua). Writes the Level 1/2 launcher's tile JSON, then
starts the launcher (Level 1) or Omarchy's own shell (Level 2/3).

Env:
  OMARCHY_KIDS_ETC      default /etc/omarchy-kids
  OMARCHY_KIDS_SHARE    default /usr/share/omarchy-kids
  OMARCHY_KIDS_RUN      default \$XDG_RUNTIME_DIR/omarchy-kids
  OMARCHY_KIDS_ACCOUNT  default: this process's own user
  OMARCHY_KIDS_LEVEL    default: omarchy-kids-conf get <account> level
  OMARCHY_KIDS_BAND     default: omarchy-kids-conf get <account> band

  -h, --help  Show this help and exit.
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    *) echo "omarchy-kids-session-start: unknown argument: '$arg'" >&2; exit 2 ;;
  esac
done

export OMARCHY_KIDS_ETC="$ETC" OMARCHY_KIDS_SHARE="$SHARE"

ACCOUNT="${OMARCHY_KIDS_ACCOUNT:-$(id -un)}"
LEVEL="${OMARCHY_KIDS_LEVEL:-$("$CONF_BIN" get "$ACCOUNT" level)}"
BAND="${OMARCHY_KIDS_BAND:-$("$CONF_BIN" get "$ACCOUNT" band)}"
ALLOWLIST="$("$APPS_BIN" allowlist "$ACCOUNT")"
WEB="$("$CONF_BIN" get "$ACCOUNT" web)"

PACK="$SHARE/packs/$BAND.toml"
UID_NUM="$(id -u)"
LAUNCHER_JSON="$RUN/launcher-$UID_NUM.json"

# find_desktop_file ID PKG -> a matching .desktop basename, or nothing.
# A heuristic, not exact: pack ids are short ("gcompris"), .desktop ids
# are often reverse-DNS ("org.gcompris.GCompris"). Case-insensitive
# substring match on either; anything missed falls back to running the
# pack id as a literal command (resolve_tile below).
find_desktop_file() {
  # Lowercased with `tr`, not bash 4's ${var,,}: the target (Arch,
  # AGENTS.md) has bash 5, but this stays portable to whatever runs the
  # test suite too.
  local id="$1" pkg="$2" dir f base needle_id needle_pkg base_lc
  needle_id="$(printf '%s' "$id" | tr '[:upper:]' '[:lower:]')"
  needle_pkg="${pkg#aur:}"
  needle_pkg="$(printf '%s' "$needle_pkg" | tr '[:upper:]' '[:lower:]')"
  IFS=':' read -ra dirs <<<"$APPLICATIONS_DIRS"
  for dir in "${dirs[@]}"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.desktop; do
      [[ -e "$f" ]] || continue
      base="$(basename "$f" .desktop)"
      base_lc="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
      if [[ "$base_lc" == *"$needle_id"* || ( -n "$needle_pkg" && "$base_lc" == *"$needle_pkg"* ) ]]; then
        printf '%s\t%s\n' "$base" "$dir"
        return 0
      fi
    done
  done
  return 1
}

# icon_for_desktop BASENAME DIR -> the desktop file's Icon= value
# (usually an icon theme name, occasionally a literal path), or nothing.
icon_for_desktop() {
  local base="$1" dir="$2" f
  f="$dir/$base.desktop"
  [[ -f "$f" ]] || return 1
  grep -m1 '^Icon=' "$f" | cut -d= -f2-
}

# resolve_tile ID PKG -> sets RESOLVED_ICON/RESOLVED_EXEC/RESOLVED_INSTALLED
# (globals, not stdout -- a tab-delimited herestring silently shifts
# fields left on a tile with no icon). Prefers a matched .desktop file
# (gtk-launch), else runs the pack id as a bare command. INSTALLED is
# whether the resolved exec exists (.desktop match, or `command -v`) --
# not `pacman -Q`, so an apps.extra id with no package still resolves
# right (issue #42, I-6: no tile whose Enter silently does nothing).
RESOLVED_ICON=""
RESOLVED_EXEC=""
RESOLVED_INSTALLED=0
resolve_tile() {
  local id="$1" pkg="$2" desktop_line base dir
  if desktop_line="$(find_desktop_file "$id" "$pkg")"; then
    IFS=$'\t' read -r base dir <<<"$desktop_line"
    RESOLVED_ICON="$(icon_for_desktop "$base" "$dir" || true)"
    RESOLVED_EXEC="gtk-launch $base"
    RESOLVED_INSTALLED=1
  else
    RESOLVED_ICON=""
    RESOLVED_EXEC="$id"
    if command -v "$id" >/dev/null 2>&1; then
      RESOLVED_INSTALLED=1
    else
      RESOLVED_INSTALLED=0
    fi
  fi
}

# queue_has_pkg PKG -> 0 if PKG (an "aur:"-prefixed pack `pkg`, stripped
# the same way bin/omarchy-kids-apps strips it) is a line in the pending
# install queue omarchy-kids-apps install writes -- i.e. this app is
# missing but already on its way, not just missing. Never writes the
# queue; only omarchy-kids-apps and its install-queued worker do that.
queue_has_pkg() {
  local pkg="$1"
  local pkgname="${pkg#aur:}"
  [[ -s "$QUEUE_FILE" ]] || return 1
  grep -qxF "$pkgname" "$QUEUE_FILE" 2>/dev/null
}

mkdir -p "$RUN"
TILES_FILE="$(mktemp)"
trap 'rm -f "$TILES_FILE"' EXIT

# apps.show_missing (issue #42, docs/conf.md): default "no" -- a missing
# app's tile is omitted (logged why), never shown doing nothing on
# Enter. "yes" keeps it, greyed, with an "installing..."/"not installed
# yet" caption instead (still never launchable -- the launcher ignores
# Enter on it, see share/launcher/shell.qml).
SHOW_MISSING="$("$CONF_BIN" get "$ACCOUNT" apps.show_missing)"

IFS=',' read -ra ids <<<"$ALLOWLIST"
for id in "${ids[@]}"; do
  [[ -n "$id" ]] || continue
  if ! meta="$("$PY" "$PYHELPER" pack-app "$PACK" "$id" 2>/dev/null)"; then
    # Allowlisted id isn't in this band's pack (a stale override, a
    # renamed app, ...). Skip it rather than fail the whole launcher.
    continue
  fi
  IFS=$'\t' read -r label pkg _web <<<"$meta"
  resolve_tile "$id" "$pkg"

  caption=""
  if [[ "$RESOLVED_INSTALLED" == 0 ]]; then
    if queue_has_pkg "$pkg"; then
      caption="installing..."
    else
      caption="not installed yet"
    fi
    if [[ "$SHOW_MISSING" != "yes" ]]; then
      log "tile omitted for '$id' ('$ACCOUNT'): not installed (no desktop entry or exec on PATH; $caption)"
      continue
    fi
  fi

  installed_json=$([[ "$RESOLVED_INSTALLED" == 1 ]] && echo true || echo false)
  jq -n --arg id "$id" --arg label "$label" --arg icon "$RESOLVED_ICON" --arg exec "$RESOLVED_EXEC" \
    --argjson installed "$installed_json" --arg caption "$caption" \
    '{id: $id, label: $label, icon: $icon, exec: $exec, installed: $installed, caption: $caption}' >>"$TILES_FILE"
done

# R-WEB-4 defense in depth: omarchy-kids-session's own check_policy
# already fails the session closed if the policy file isn't readable;
# this just leaves the web tile out (logged) rather than show a control
# that silently fails (I-6). Execs `omarchy-kids-web launch`, not bare
# "chromium" (issue #44: the Arch wrapper's --load-extension flags get
# refused by the kids policy). See docs/web.md.
if [[ "$WEB" != "none" ]]; then
  policy="/etc/chromium/policies/managed/omarchy-kids-$BAND.json"
  if [[ -r "$policy" ]]; then
    jq -n --arg band "$BAND" --arg web_bin "$WEB_BIN" \
      '{id: "chromium", label: "Web", icon: "chromium",
        exec: ("OMARCHY_KIDS_BAND=" + ($band | @sh) + " " + ($web_bin | @sh) + " launch")}' \
      >>"$TILES_FILE"
  else
    log "web tile omitted for '$ACCOUNT': $policy missing or not readable (R-WEB-4, fail closed)"
  fi
fi

# "More apps" tile (SPEC.md R-APPS-7; issue #28): the kids-plugins
# shelf, Level 1 only, bands 6-8 and up -- 3-5 gets no shelf tile at
# all, not a shelf that always shows nothing (I-6: don't offer a door
# to an empty room). Opens share/plugins/shell.qml, a read-only list of
# the shelf (same overlay pattern as the "Ask a grown-up" modal); its
# own Enter runs `omarchy-kids-ask app <plugin>`, so nothing here needs
# to plumb the kid's account through -- only the band, for the shelf's
# own age filter (bin/omarchy-kids-plugins shelf --band).
if [[ "$LEVEL" == "1" && "$BAND" != "3-5" ]]; then
  jq -n --arg band "$BAND" --arg qml "$SHARE/plugins/shell.qml" \
    '{id: "more-apps", label: "More apps", icon: "",
      exec: ("OMARCHY_KIDS_BAND=" + ($band | @sh) + " quickshell -p " + ($qml | @sh))}' \
    >>"$TILES_FILE"
fi

# R-DATA-3 (issue #27): K5, "What my grown-ups can see" (`omarchy-kids-data
# mine`), gated on BAND (9-12/13+, old enough to read it themselves) not
# LEVEL -- 3-5/6-8 aren't denied the data, just this tile. A 9-12/13+
# kid on Level 2/3 has no tile grid at all, so this stays reachable there
# only by running the command directly: docs/data.md's "Not built here".
if [[ "$BAND" == "9-12" || "$BAND" == "13+" ]]; then
  DATA_BIN="$(kids_bin data "$DIR")"
  # UNVERIFIED: no terminal-emulator convention exists anywhere in this
  # repo yet (nothing under share/hyprland or docs names one) -- this is
  # a best-effort guess at common terminals, first one found on PATH
  # wins. If none is found, the tile is left out entirely (logged, not
  # shown broken) rather than shown and silently doing nothing when
  # pressed -- same "don't show a control that isn't enforced" pattern
  # R-WEB-4's chromium-tile omission above already uses, applied to
  # "doesn't work" instead of "isn't allowed".
  DATA_TERM=""
  for term in kitty alacritty foot wezterm xterm; do
    if command -v "$term" >/dev/null 2>&1; then DATA_TERM="$term"; break; fi
  done
  if [[ -n "$DATA_TERM" ]]; then
    DATA_EXEC="$DATA_TERM -e sh -c '\"$DATA_BIN\" mine; printf \"\\nPress Enter to close.\\n\"; read _'"
    jq -n --arg exec "$DATA_EXEC" \
      '{id: "kids-data", label: "What grown-ups see", icon: "", exec: $exec}' >>"$TILES_FILE"
  else
    log "kids-data tile omitted for '$ACCOUNT': no terminal emulator found on PATH (I-6; see docs/data.md)"
  fi
fi

jq -s '{account: $account, band: $band, level: $level, tiles: .}' \
  --arg account "$ACCOUNT" --arg band "$BAND" --arg level "$LEVEL" \
  "$TILES_FILE" >"$LAUNCHER_JSON.tmp"
mv "$LAUNCHER_JSON.tmp" "$LAUNCHER_JSON"
chmod 0644 "$LAUNCHER_JSON"

: > "$RUN/launcher-control"  # the launcher polls this file; create it so the poll never warns
export OMARCHY_KIDS_LAUNCHER_JSON="$LAUNCHER_JSON" OMARCHY_KIDS_LAUNCHER_CONTROL="$RUN/launcher-control"

case "$LEVEL" in
  1)
    EXEC_LINE=(quickshell -p "$SHARE/launcher/shell.qml")
    ;;
  2|3)
    # $RUN/allowlist.json (docs/apps.md): the same effective allowlist
    # as the tile file above, for Omarchy's own trimmed menu extension
    # to read at these levels (Levels 2/3 run Omarchy's shell, not the
    # Level 1 launcher, so there is no tile grid here to read instead --
    # R-DESK-4, issue #24). Written unconditionally, whether or not any
    # menu extension actually reads it yet (I-6: this is just data, not
    # a control claimed to be enforced by itself).
    jq -n --arg account "$ACCOUNT" --arg band "$BAND" --arg allowlist "$ALLOWLIST" \
      '{account: $account, band: $band, allowlist: ($allowlist | split(",") | map(select(length > 0)))}' \
      >"$RUN/allowlist.json.tmp"
    mv "$RUN/allowlist.json.tmp" "$RUN/allowlist.json"
    chmod 0644 "$RUN/allowlist.json"
    # The exact command Omarchy's own default.hypr.autostart uses.
    EXEC_LINE=(/usr/bin/omarchy-launch-shell)
    ;;
  *)
    echo "omarchy-kids-session-start: unknown level '$LEVEL' for '$ACCOUNT'" >&2
    exit 1
    ;;
esac

if [[ "${OMARCHY_KIDS_SESSION_START_NO_EXEC:-0}" == "1" ]]; then
  printf '%s\n' "${EXEC_LINE[*]}"
  exit 0
fi

# Screen-time engine (SPEC.md R-TIME-1..5): the per-session daemon,
# started detached and outliving this script's own exec below. Runs as
# the kid, read-only (lib/time.sh's header has the trust boundary).
# Never fatal -- the desktop still comes up if this can't start.
log "starting omarchy-kids-time daemon for '$ACCOUNT'"
"$TIME_BIN" daemon >/dev/null 2>&1 &
disown 2>/dev/null || true

exec "${EXEC_LINE[@]}"
