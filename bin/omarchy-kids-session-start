#!/bin/bash
# omarchy-kids-session-start: run once per kid Hyprland session via
# `exec-once`/`hl.on("hyprland.start", ...)` from share/hyprland/L1.lua,
# L2.lua, and L3.lua (SPEC.md R-DESK-1, R-DESK-3, R-DESK-5, Appendix E).
#
# Writes the Level 1/2 launcher's tile list to
# $XDG_RUNTIME_DIR/omarchy-kids/launcher-<uid>.json from the kid's resolved
# allowlist (omarchy-kids-conf) and pack metadata (share/packs/<band>.toml),
# then starts the right thing for the level:
#   Level 1 -> the standalone big-tile launcher (quickshell -p ...), the
#              *only* thing running (R-DESK-5: not a shell plugin).
#   Level 2/3 -> Omarchy's own shell, the same way Omarchy's own
#              default.hypr.autostart does (`omarchy-launch-shell`).
#
# Not yet started: the exit overlay and notifications this file's header
# comment promises -- those are bin/omarchy-kids-exit (a stub, R-EXIT-1)
# and a later issue; this file just launches whichever of the above is
# right for the level, plus the JSON write every level needs regardless.
#
# Every path below is overridable for tests, same convention as
# omarchy-kids-conf and docs/conf.md:
#   OMARCHY_KIDS_ETC     kid overrides root (default /etc/omarchy-kids)
#   OMARCHY_KIDS_SHARE   bands.toml, packs/, launcher/ (default /usr/share/omarchy-kids)
#   OMARCHY_KIDS_RUN     runtime state root (default $XDG_RUNTIME_DIR/omarchy-kids)
#   OMARCHY_KIDS_ACCOUNT  kid account (default: this process's own user)
#   OMARCHY_KIDS_LEVEL    1/2/3 (default: omarchy-kids-conf get <account> level)
#   OMARCHY_KIDS_BAND     3-5/6-8/9-12/13+ (default: omarchy-kids-conf get <account> band)
#   OMARCHY_KIDS_APPLICATIONS_DIRS  colon-separated .desktop dirs to search
#                                   for a pack app's launcher entry
#                                   (default /usr/share/applications:/usr/local/share/applications)
#   OMARCHY_KIDS_SESSION_START_NO_EXEC=1  write the JSON, print the exec
#                                   line that would run, and return 0
#                                   instead of exec'ing it (test hook)
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="${OMARCHY_KIDS_LIB:-$DIR/lib}"; [[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
CONF_BIN="${OMARCHY_KIDS_CONF_BIN:-$DIR/bin/omarchy-kids-conf}"; [[ -x "$CONF_BIN" ]] || CONF_BIN=/usr/bin/omarchy-kids-conf
PY="${OMARCHY_KIDS_CONF_PY:-python3}"
PYHELPER="$LIB/conf.py"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
# The kid can only write to their own runtime dir; /run/omarchy-kids is root-owned (found live).
RUN="${OMARCHY_KIDS_RUN:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-kids}"
mkdir -p "$RUN" 2>/dev/null || true
APPLICATIONS_DIRS="${OMARCHY_KIDS_APPLICATIONS_DIRS:-/usr/share/applications:/usr/local/share/applications}"

# log MESSAGE — appends to the same per-session log
# bin/omarchy-kids-session already writes to ($RUN/session-<uid>.log),
# so the R-DESK-2 preflight and this launcher's own tile-building show
# up as one timeline. Never fatal: a log write that fails (a read-only
# $RUN in some test harness) must not take the launcher down with it.
LOG_FILE="$RUN/session-$(id -u).log"
log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG_FILE" 2>/dev/null || true; }

usage() {
  cat <<EOF
Usage: omarchy-kids-session-start

Run from a Kids Mode Hyprland level config's exec-once (share/hyprland/
L1.lua, L2.lua, L3.lua). Writes the Level 1/2 launcher's tile JSON, then
starts the launcher (Level 1) or Omarchy's own shell (Level 2/3).

Env:
  OMARCHY_KIDS_ETC      default /etc/omarchy-kids
  OMARCHY_KIDS_SHARE    default /usr/share/omarchy-kids
  OMARCHY_KIDS_RUN      default \$XDG_RUNTIME_DIR/omarchy-kids
  OMARCHY_KIDS_ACCOUNT  default: this process's own user
  OMARCHY_KIDS_LEVEL    default: omarchy-kids-conf get <account> level
  OMARCHY_KIDS_BAND     default: omarchy-kids-conf get <account> band

  -h, --help  Show this help and exit.
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    *) echo "omarchy-kids-session-start: unknown argument: '$arg'" >&2; exit 2 ;;
  esac
done

export OMARCHY_KIDS_ETC="$ETC" OMARCHY_KIDS_SHARE="$SHARE"

ACCOUNT="${OMARCHY_KIDS_ACCOUNT:-$(id -un)}"
LEVEL="${OMARCHY_KIDS_LEVEL:-$("$CONF_BIN" get "$ACCOUNT" level)}"
BAND="${OMARCHY_KIDS_BAND:-$("$CONF_BIN" get "$ACCOUNT" band)}"
ALLOWLIST="$("$CONF_BIN" get "$ACCOUNT" allowlist)"
WEB="$("$CONF_BIN" get "$ACCOUNT" web)"

PACK="$SHARE/packs/$BAND.toml"
UID_NUM="$(id -u)"
LAUNCHER_JSON="$RUN/launcher-$UID_NUM.json"

# find_desktop_file ID PKG -> a .desktop basename (without the
# extension) whose name looks like it belongs to this pack app, or
# nothing (and a non-zero exit) if none is found. This is a heuristic,
# not exact: pack ids (share/packs/<band>.toml's `id`) are short and
# human-picked (e.g. "gcompris"), while installed .desktop files are
# often reverse-DNS ids (e.g. "org.gcompris.GCompris.desktop"). A
# case-insensitive substring match on either the pack id or the pkg
# name catches the common cases; anything it misses falls back to
# running the pack id as a literal command (see resolve_tile below).
find_desktop_file() {
  # Lowercased with `tr`, not bash 4's ${var,,}: the target (Arch,
  # AGENTS.md) has bash 5, but this stays portable to whatever runs the
  # test suite too.
  local id="$1" pkg="$2" dir f base needle_id needle_pkg base_lc
  needle_id="$(printf '%s' "$id" | tr '[:upper:]' '[:lower:]')"
  needle_pkg="${pkg#aur:}"
  needle_pkg="$(printf '%s' "$needle_pkg" | tr '[:upper:]' '[:lower:]')"
  IFS=':' read -ra dirs <<<"$APPLICATIONS_DIRS"
  for dir in "${dirs[@]}"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.desktop; do
      [[ -e "$f" ]] || continue
      base="$(basename "$f" .desktop)"
      base_lc="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
      if [[ "$base_lc" == *"$needle_id"* || ( -n "$needle_pkg" && "$base_lc" == *"$needle_pkg"* ) ]]; then
        printf '%s\t%s\n' "$base" "$dir"
        return 0
      fi
    done
  done
  return 1
}

# icon_for_desktop BASENAME DIR -> the desktop file's Icon= value
# (usually an icon theme name, occasionally a literal path), or nothing.
icon_for_desktop() {
  local base="$1" dir="$2" f
  f="$dir/$base.desktop"
  [[ -f "$f" ]] || return 1
  grep -m1 '^Icon=' "$f" | cut -d= -f2-
}

# resolve_tile ID PKG -> sets RESOLVED_ICON and RESOLVED_EXEC for one
# launcher tile (globals, not "icon\texec" on stdout: bash's word
# splitting collapses a *leading* empty field on a tab-delimited
# herestring -- tab is one of the default IFS-whitespace characters --
# which silently shifts every field left whenever a tile has no icon;
# this sidesteps that instead of relying on very careful field order).
# Prefers a matched .desktop file (launched with gtk-launch, so it picks
# up the app's own working directory/env the way a normal app-grid
# entry would); falls back to running the pack id itself as a bare
# command when no .desktop file is found. Both are best-effort: neither
# is verified against the actual package names in share/packs/*.toml
# (pkg names like "aur:turbowarp-desktop-bin" or "gcompris-qt" don't
# necessarily match their .desktop or binary name exactly).
RESOLVED_ICON=""
RESOLVED_EXEC=""
resolve_tile() {
  local id="$1" pkg="$2" desktop_line base dir
  if desktop_line="$(find_desktop_file "$id" "$pkg")"; then
    IFS=$'\t' read -r base dir <<<"$desktop_line"
    RESOLVED_ICON="$(icon_for_desktop "$base" "$dir" || true)"
    RESOLVED_EXEC="gtk-launch $base"
  else
    RESOLVED_ICON=""
    RESOLVED_EXEC="$id"
  fi
}

mkdir -p "$RUN"
TILES_FILE="$(mktemp)"
trap 'rm -f "$TILES_FILE"' EXIT

IFS=',' read -ra ids <<<"$ALLOWLIST"
for id in "${ids[@]}"; do
  [[ -n "$id" ]] || continue
  if ! meta="$("$PY" "$PYHELPER" pack-app "$PACK" "$id" 2>/dev/null)"; then
    # Allowlisted id isn't in this band's pack (a stale override, a
    # renamed app, ...). Skip it rather than fail the whole launcher.
    continue
  fi
  IFS=$'\t' read -r label pkg _web <<<"$meta"
  resolve_tile "$id" "$pkg"
  jq -n --arg id "$id" --arg label "$label" --arg icon "$RESOLVED_ICON" --arg exec "$RESOLVED_EXEC" \
    '{id: $id, label: $label, icon: $icon, exec: $exec}' >>"$TILES_FILE"
done

# R-WEB-4: "The kid launcher refuses to start Chromium if the kid's
# policy file is not readable." bin/omarchy-kids-session's own R-DESK-2
# check_policy already fails the *whole* session closed before this
# script ever runs, for any band whose web mode isn't "none" (see its
# check_policy). This is defense in depth for whatever calls this
# script directly (tests, a future re-render of just the launcher tiles
# without a full session restart): the web tile is simply left out of
# the tile list when the policy file is missing or unreadable, with a
# log line naming why -- never a tile that looks real but silently fails
# to open (I-6: don't show a control that isn't enforced).
if [[ "$WEB" != "none" ]]; then
  policy="/etc/chromium/policies/managed/omarchy-kids-$BAND.json"
  if [[ -r "$policy" ]]; then
    jq -n '{id: "chromium", label: "Web", icon: "chromium", exec: "chromium"}' >>"$TILES_FILE"
  else
    log "web tile omitted for '$ACCOUNT': $policy missing or not readable (R-WEB-4, fail closed)"
  fi
fi

jq -s '{account: $account, band: $band, level: $level, tiles: .}' \
  --arg account "$ACCOUNT" --arg band "$BAND" --arg level "$LEVEL" \
  "$TILES_FILE" >"$LAUNCHER_JSON.tmp"
mv "$LAUNCHER_JSON.tmp" "$LAUNCHER_JSON"
chmod 0644 "$LAUNCHER_JSON"

: > "$RUN/launcher-control"  # the launcher polls this file; create it so the poll never warns
export OMARCHY_KIDS_LAUNCHER_JSON="$LAUNCHER_JSON" OMARCHY_KIDS_LAUNCHER_CONTROL="$RUN/launcher-control"

case "$LEVEL" in
  1)
    EXEC_LINE=(quickshell -p "$SHARE/launcher/shell.qml")
    ;;
  2|3)
    # The exact command Omarchy's own default.hypr.autostart uses.
    EXEC_LINE=(omarchy-launch-shell)
    ;;
  *)
    echo "omarchy-kids-session-start: unknown level '$LEVEL' for '$ACCOUNT'" >&2
    exit 1
    ;;
esac

if [[ "${OMARCHY_KIDS_SESSION_START_NO_EXEC:-0}" == "1" ]]; then
  printf '%s\n' "${EXEC_LINE[*]}"
  exit 0
fi

exec "${EXEC_LINE[@]}"
