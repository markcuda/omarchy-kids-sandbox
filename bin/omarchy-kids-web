#!/bin/bash
# omarchy:summary=Render and install a band's managed Chromium policy
# omarchy:args=<render|install|launch> <band> [args]
# Renders and installs the per-band managed Chromium policy (SPEC.md R-WEB-1..4).
# See docs/web.md for the template/starter-list format and every env var.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="${OMARCHY_KIDS_LIB:-$DIR/lib}"; [[ -f "$LIB/kids.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
CONF="$(kids_bin conf "$DIR")"

SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
SYSROOT="${OMARCHY_KIDS_ROOT:-}"

DRY_RUN="${DRY_RUN:-1}"

VALID_BANDS=("3-5" "6-8" "9-12" "13+")

die() { echo "omarchy-kids-web: $1" >&2; exit "${2:-2}"; }

usage() {
    cat <<'EOF'
Usage: omarchy-kids-web render <band> [--allow FILE] [--out FILE]
       omarchy-kids-web install <band> [--allow FILE] [--apply]
       omarchy-kids-web launch [URL]
       omarchy-kids-web --help

render  Merges share/policy/<band>.json with share/policy/lists/<band>.txt
        (plus an optional --allow FILE, same format -- e.g. a kid's own
        approved sites) into the final managed Chromium policy JSON.
        Prints to stdout, or --out FILE. Bands: 3-5, 6-8, 9-12, 13+.
        --allow is only accepted for a "garden" band (6-8, 9-12); "none"
        (3-5) and "filtered" (13+) bands take no allowlist at all
        (SPEC.md R-WEB-3) and this refuses rather than silently ignore it.

install Renders, then writes
        /etc/chromium/policies/managed/omarchy-kids-<band>.json at 0640
        root:omarchy-kids-<band> (R-WEB-1), under $OMARCHY_KIDS_ROOT if
        set.

launch  Execs /usr/lib/chromium/chromium (the real binary, not Arch's
        /usr/bin/chromium wrapper) with share/policy/chromium-flags.conf
        -- Omarchy's own Wayland/password-store/feature flags, minus
        every --load-extension, since the kids policy always refuses
        unpacked extensions -- plus --no-first-run
        --no-default-browser-check --hide-crash-restore-bubble
        --disable-session-crashed-bubble, then URL if given, else the
        band's RestoreOnStartupURLs[0] if its policy defines one.
        Refuses (exit 1) if the band's installed managed-policy file
        isn't readable (R-WEB-4). See --help's own header comment in
        this script for issue #44's full story.

DRY_RUN=1 is the default for "install" (see AGENTS.md rule 8): it only
prints what it would do. Pass --apply, or set DRY_RUN=0, to make it
real. "render" always runs for real -- it only ever writes to a file the
caller named with --out, never a system path. "launch" always runs for
real too -- it starts a browser, not something that touches /etc.

  -h, --help  Show this help and exit.
EOF
}

is_valid_band() {
    local b="$1" v
    for v in "${VALID_BANDS[@]}"; do [[ "$v" == "$b" ]] && return 0; done
    return 1
}

# band_web_mode BAND — none|garden|filtered, from share/bands/bands.toml
# via omarchy-kids-conf (the one place that table is read from), not a
# second hardcoded mapping here.
band_web_mode() {
    local band="$1" out
    out="$("$CONF" band "$band" 2>/dev/null)" || die "could not read band '$band' defaults from $CONF (see docs/conf.md)"
    printf '%s\n' "$out" | sed -n 's/^web=//p' | head -1
}

# list_domains FILE — one host per line, '#' comments (full-line or
# trailing) and blank lines stripped. Missing file -> nothing, not an
# error (a band with no starter list yet is not a bug).
list_domains() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$file"
}

# render_policy_json BAND [ALLOW_FILE] — prints the final managed-policy
# JSON on stdout, or dies with a one-line reason.
render_policy_json() {
    local band="$1" allow_file="${2:-}"
    local policy_file="$SHARE/policy/$band.json"
    local list_file="$SHARE/policy/lists/$band.txt"

    [[ -f "$policy_file" ]] || die "no policy template for band '$band' ($policy_file)"
    jq -e '.' "$policy_file" >/dev/null 2>&1 || die "invalid JSON in $policy_file"

    local mode
    mode="$(band_web_mode "$band")"

    case "$mode" in
        garden)
            local domains allow_json
            domains="$( { list_domains "$list_file"; [[ -n "$allow_file" ]] && list_domains "$allow_file"; } | sort -u )"
            allow_json="$(printf '%s\n' "$domains" | jq -R -s 'split("\n") | map(select(length > 0))')"
            jq --argjson allow "$allow_json" '.URLAllowlist = $allow' "$policy_file" \
                || die "failed to merge the allowlist for band '$band'"
            ;;
        none|filtered)
            [[ -z "$allow_file" ]] || die "band '$band' is '$mode' (R-WEB-3): it takes no allowlist, so --allow is not accepted"
            jq '.' "$policy_file"
            ;;
        *)
            die "band '$band' has an unrecognized web mode '$mode' (share/bands/bands.toml)"
            ;;
    esac
}

# install_policy_file BAND [ALLOW_FILE] — renders, then writes
# /etc/chromium/policies/managed/omarchy-kids-<band>.json at 0640
# root:omarchy-kids-<band> (R-WEB-1), via a temp file and rename.
# Ownership is best-effort, same reasoning as omarchy-kids-assert's
# chromium_fix (docs/assert.md).
install_policy_file() {
    local band="$1" allow_file="${2:-}"
    local dir="$SYSROOT/etc/chromium/policies/managed"
    local file="$dir/omarchy-kids-$band.json"
    local json group stage

    json="$(render_policy_json "$band" "$allow_file")" || return 1

    install -d -m 0755 "$dir"
    stage="$(mktemp "$dir/.omarchy-kids-$band.json.XXXXXX")"
    printf '%s\n' "$json" > "$stage"
    chmod 0640 "$stage"
    mv -f "$stage" "$file"

    group="$(group_for_band "$band")" || die "unknown band: '$band'"
    if ! chown "root:$group" "$file" >/dev/null 2>&1; then
        echo "  (could not chown $file to root:$group -- fine outside a real root run; omarchy-kids-assert fixes this on the target)" >&2
    fi
    echo "  installed $file (root:$group 0640)"
}

# --- render --------------------------------------------------------------

cmd_render() {
    local band="" allow_file="" out_file=""
    while (($#)); do
        case "$1" in
            --allow) allow_file="${2:?--allow needs a value}"; shift 2 ;;
            --out) out_file="${2:?--out needs a value}"; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            --) shift ;;
            -*) die "render: unknown option '$1'" ;;
            *)
                if [[ -z "$band" ]]; then band="$1"; else die "render: unexpected argument '$1'"; fi
                shift
                ;;
        esac
    done

    [[ -n "$band" ]] || die "render: needs a band"
    is_valid_band "$band" || die "render: unknown band '$band' (must be one of ${VALID_BANDS[*]})"

    local json
    json="$(render_policy_json "$band" "$allow_file")"

    if [[ -n "$out_file" ]]; then
        printf '%s\n' "$json" > "$out_file"
    else
        printf '%s\n' "$json"
    fi
}

# --- install ---------------------------------------------------------------

cmd_install() {
    local band="" allow_file=""
    while (($#)); do
        case "$1" in
            --allow) allow_file="${2:?--allow needs a value}"; shift 2 ;;
            --apply) DRY_RUN=0; shift ;;
            -h|--help) usage; exit 0 ;;
            --) shift ;;
            -*) die "install: unknown option '$1'" ;;
            *)
                if [[ -z "$band" ]]; then band="$1"; else die "install: unexpected argument '$1'"; fi
                shift
                ;;
        esac
    done

    [[ -n "$band" ]] || die "install: needs a band"
    is_valid_band "$band" || die "install: unknown band '$band' (must be one of ${VALID_BANDS[*]})"

    echo "Installing Chromium policy for band $band"
    run install_policy_file "$band" "$allow_file"
}

# --- launch ------------------------------------------------------------

# resolve_band — $OMARCHY_KIDS_BAND if set (the Web tile's own exec line
# sets it, same convention bin/omarchy-kids-session-start's "more-apps"
# tile uses), else `omarchy-kids-conf get <account> band` for
# $OMARCHY_KIDS_ACCOUNT (default: this process's own user).
resolve_band() {
    local band="${OMARCHY_KIDS_BAND:-}"
    if [[ -z "$band" ]]; then
        local account="${OMARCHY_KIDS_ACCOUNT:-$(id -un)}"
        band="$("$CONF" get "$account" band 2>/dev/null)" \
            || die "launch: could not resolve a band for '$account' (set \$OMARCHY_KIDS_BAND, or see docs/conf.md)"
    fi
    printf '%s\n' "$band"
}

# start_url_for_band BAND — the first entry of the rendered policy's
# RestoreOnStartupURLs, if it has one. None of today's four band
# templates (share/policy/*.json) set this key, so this is currently
# always empty -- it exists so a future band policy can define a start
# page without this script changing (issue #44: "the band's start URL
# when the policy defines one").
start_url_for_band() {
    local band="$1" rendered
    rendered="$(render_policy_json "$band")" || return 1
    jq -r '(.RestoreOnStartupURLs // [])[0] // empty' <<<"$rendered"
}

cmd_launch() {
    local url=""
    while (($#)); do
        case "$1" in
            -h|--help) usage; exit 0 ;;
            --) shift ;;
            -*) die "launch: unknown option '$1'" ;;
            *)
                if [[ -z "$url" ]]; then url="$1"; else die "launch: unexpected argument '$1'"; fi
                shift
                ;;
        esac
    done

    local band
    band="$(resolve_band)"
    is_valid_band "$band" || die "launch: unknown band '$band' (must be one of ${VALID_BANDS[*]})"

    # R-WEB-4, same fail-closed check bin/omarchy-kids-session-start's
    # tile-omission already gives the launcher as defense in depth: never
    # start Chromium unless this band's managed policy is actually live.
    local policy="$SYSROOT/etc/chromium/policies/managed/omarchy-kids-$band.json"
    [[ -r "$policy" ]] || die "launch: policy file not readable for band '$band' ($policy) -- refusing to start Chromium unmanaged (R-WEB-4)" 1

    if [[ -z "$url" ]]; then
        url="$(start_url_for_band "$band")" || true
    fi

    # Reuses list_domains: one item per line, '#' comments and blank
    # lines stripped -- exactly what a flags file needs too, not just a
    # host list.
    local -a flags=()
    local flag
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && flags+=("$flag")
    done < <(list_domains "$SHARE/policy/chromium-flags.conf")

    local chromium_bin="${OMARCHY_KIDS_CHROMIUM_BIN:-/usr/lib/chromium/chromium}"
    local -a argv=(
        "$chromium_bin"
        "${flags[@]+"${flags[@]}"}"
        --no-first-run
        --no-default-browser-check
        --hide-crash-restore-bubble
        --disable-session-crashed-bubble
    )
    [[ -n "$url" ]] && argv+=("$url")

    if [[ "${OMARCHY_KIDS_WEB_NO_EXEC:-0}" == "1" ]]; then
        printf '%s\n' "${argv[@]}"
        return 0
    fi

    exec "${argv[@]}"
}

# --- main --------------------------------------------------------------

main() {
    local cmd="${1:-}"
    case "$cmd" in
        -h|--help|"")
            usage
            [[ "$cmd" == "" ]] && exit 2
            exit 0
            ;;
    esac
    shift

    local -a rest=()
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "--apply" ]]; then
            DRY_RUN=0
        else
            rest+=("$arg")
        fi
    done

    case "$cmd" in
        render) cmd_render "${rest[@]+"${rest[@]}"}" ;;
        install) cmd_install "${rest[@]+"${rest[@]}"}" ;;
        launch) cmd_launch "${rest[@]+"${rest[@]}"}" ;;
        *) die "unknown command: '$cmd' (see --help)" ;;
    esac
}

main "$@"
