#!/bin/bash
# omarchy:summary=The kid-side Wi-Fi commands: list, join, status, forget, picker
# omarchy:args=<list|join|status|forget|picker> [args]
# The kid-side Wi-Fi commands (SPEC.md R-WIFI-1..2, R-WIFI-4): list, join, status, forget, picker.
# R-WIFI-3's captive-portal helper is not here: it needed a root write to
# /etc/chromium/policies/managed and org.freedesktop.systemd1.manage-units,
# neither of which a kid has or should have (I-6 -- see docs/wifi.md).
# See docs/wifi.md for the helper-vs-locked-down design and every env var.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"; [[ -f "$LIB/sock.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/sock.sh
source "$LIB/sock.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
CONF_BIN="$(kids_bin conf "$DIR")"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
WIFI_QML="$SHARE/wifi/shell.qml"
TOAST_QML="$SHARE/time/toast.qml"

# The wifid socket is a constant, for the same reason the verifier
# socket is (AGENTS.md, "The trust boundary").
SOCK=/run/omarchy-kids/wifi.sock
TIMEOUT="${OMARCHY_KIDS_WIFID_TIMEOUT:-10}"

die() { echo "omarchy-kids-wifi: $1" >&2; exit "${2:-2}"; }

usage() {
    cat <<EOF
Usage: $(basename "$0") list
       $(basename "$0") join <ssid> [--password-stdin]
       $(basename "$0") status
       $(basename "$0") forget <ssid>
       $(basename "$0") picker
       $(basename "$0") --help

Every subcommand needs the caller's profile to say wifi=helper
(bin/omarchy-kids-conf, Appendix B) — enforced authoritatively by
bin/omarchy-kids-wifid, the root helper this talks to. See docs/wifi.md.

Env:
  OMARCHY_KIDS_SHARE          default /usr/share/omarchy-kids
  OMARCHY_KIDS_WIFID_TIMEOUT  default 10 (seconds)
EOF
}

account() { id -un; }

# wifi_mode ACCOUNT — the resolved Appendix B `wifi` value, or empty
# (with a non-zero return) if it can't be read at all (no profile).
wifi_mode() {
    "$CONF_BIN" get "$1" wifi 2>/dev/null
}

# require_helper — the fast, friendly, non-authoritative half of the
# wifi=helper gate (see the file header). Exits 3 with a plain sentence
# if the profile says `parent` or can't be read at all.
require_helper() {
    local who mode
    who="$(account)"
    if ! mode="$(wifi_mode "$who")"; then
        die "could not read '$who's Wi-Fi setting (see docs/conf.md)" 1
    fi
    if [[ "$mode" != "helper" ]]; then
        die "Wi-Fi needs a grown-up for '$who' (wifi=${mode:-unset}). Ask a parent to join it for you." 3
    fi
}

# show_toast TEXT — the same small, auto-dismissing, no-keyboard-grab
# overlay bin/omarchy-kids-time uses for its own warnings
# (share/time/toast.qml); falls back to stderr if Quickshell isn't on
# PATH (e.g. this host, or a test) so the message is never silently lost.
show_toast() {
    local text="$1"
    if command -v quickshell >/dev/null 2>&1 && [[ -f "$TOAST_QML" ]]; then
        OMARCHY_KIDS_TOAST_TEXT="$text" quickshell -p "$TOAST_QML" >/dev/null 2>&1 &
        disown 2>/dev/null || true
    else
        echo "omarchy-kids-wifi: $text" >&2
    fi
}

# --- wire client (bin/omarchy-kids-wifid) -----------------------------------

# wifid_request HEADER [BODY] — sends "HEADER\n[BODY\n]" and prints
# whatever the daemon replies with, or nothing on a connect/timeout
# failure. Same socat-else-python3 shape as bin/omarchy-kids-parent-auth
# (docs/authd.md) — one dependency either way, both already in this
# repo's dependency set (PKGBUILD's optdepends/depends).
wifid_request() {
    local header="$1" body="${2:-}" payload
    if [[ -n "$body" ]]; then
        payload="$header"$'\n'"$body"$'\n'
    else
        payload="$header"$'\n'
    fi
    kids_sock_request "$SOCK" "$payload" "$TIMEOUT"
}

# call_wifid HEADER [BODY] — prints the payload on success (OK) and
# returns 0; prints a one-line reason to stderr and returns non-zero
# otherwise (3 for the daemon's own REFUSED, 1 for ERROR or no reply at
# all — e.g. the daemon isn't running).
call_wifid() {
    local reply status
    reply="$(wifid_request "$@")"
    if [[ -z "$reply" ]]; then
        echo "omarchy-kids-wifi: no reply from omarchy-kids-wifid (is it running? see systemctl status omarchy-kids-wifid.socket)" >&2
        return 1
    fi
    status="${reply%%$'\n'*}"
    case "$status" in
        OK)
            printf '%s' "${reply#*$'\n'}"
            return 0
            ;;
        REFUSED*)
            echo "omarchy-kids-wifi: ${status#REFUSED }" >&2
            return 3
            ;;
        ERROR*)
            echo "omarchy-kids-wifi: ${status#ERROR }" >&2
            return 1
            ;;
        *)
            echo "omarchy-kids-wifi: unexpected reply from omarchy-kids-wifid: $status" >&2
            return 1
            ;;
    esac
}

# --- subcommands -------------------------------------------------------

cmd_list() {
    require_helper
    call_wifid "LIST"
}

cmd_status() {
    require_helper
    call_wifid "STATUS"
}

cmd_forget() {
    local ssid="${1:?omarchy-kids-wifi forget <ssid>}"
    require_helper
    call_wifid "FORGET $ssid"
}

cmd_join() {
    local ssid="${1:?omarchy-kids-wifi join <ssid> [--password-stdin]}"
    shift
    local password_stdin=0 arg
    for arg in "$@"; do
        case "$arg" in
            --password-stdin) password_stdin=1 ;;
            *) die "join: unknown argument '$arg'" ;;
        esac
    done
    require_helper
    local password=""
    if [[ "$password_stdin" == 1 ]]; then
        IFS= read -r password || true
    fi
    call_wifid "JOIN $ssid" "$password"
}

# cmd_picker — the kid-facing overlay, always bound to Super+Shift+W
# (share/hyprland/L1.lua, L2.lua, L3.lua: the bind is unconditional
# because the level configs are static, R-DESK-1 — this command is what
# actually decides whether anything happens).
cmd_picker() {
    local who mode
    who="$(account)"
    if ! mode="$(wifi_mode "$who")"; then
        show_toast "Wi-Fi isn't set up yet. Ask a grown-up."
        exit 1
    fi
    if [[ "$mode" != "helper" ]]; then
        show_toast "Wi-Fi needs a grown-up. Ask them to turn it on for you."
        exit 3
    fi
    export OMARCHY_KIDS_ACCOUNT="$who"
    exec quickshell -p "$WIFI_QML"
}

# --- main --------------------------------------------------------------

main() {
    local cmd="${1:-}"
    case "$cmd" in
        list) shift; cmd_list "$@" ;;
        join) shift; cmd_join "$@" ;;
        status) shift; cmd_status "$@" ;;
        forget) shift; cmd_forget "$@" ;;
        picker) shift; cmd_picker "$@" ;;
        -h|--help|"") usage; [[ "$cmd" == "" ]] && exit 2; exit 0 ;;
        *) die "unknown command: '$cmd' (see --help)" ;;
    esac
}

main "$@"
