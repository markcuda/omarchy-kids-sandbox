#!/bin/bash
# Parent setup wizard. Dry-run by default.
# --apply as root writes host locks + kid login hash (not /etc/shadow).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/provision.sh
source "$DIR/lib/provision.sh"
[[ "${1:-}" == "--apply" ]] && DRY_RUN=0
HAVE_GUM=0
command -v gum >/dev/null && HAVE_GUM=1
OWNER="${OMARCHY_KIDS_OWNER:-${SUDO_USER:-$(id -un)}}"

ask_choose() {
  local p="$1"
  shift
  if [[ $HAVE_GUM == 1 ]]; then
    gum choose --header "$p" "$@"
  else
    echo "$p" >&2
    select o in "$@"; do echo "$o"; break; done
  fi
}
ask_input() {
  if [[ $HAVE_GUM == 1 ]]; then
    gum input --placeholder "$1" --password
  else
    read -rsp "$1: " v
    echo >&2
    echo "$v"
  fi
}

echo "═══ OMARCHY KIDS MODE SETUP ═══"
[[ "$DRY_RUN" == "1" ]] && echo "(dry run — nothing will change; sudo $0 --apply on a test box)"

WHO=$(ask_choose "Who is this computer for?" "Me" "Child" "Another owner")
[[ "$WHO" == "Child" ]] || { echo "Nothing to do — Kids Mode is the Child path."; exit 0; }

BAND=$(ask_choose "How old is the child?" "3-5" "5-7" "8-10" "11-12")
case "$BAND" in
  3-5 | 5-7) SUGGEST="Guided" ;;
  8-10) SUGGEST="Supported" ;;
  *) SUGGEST="Independent" ;;
esac
PRESET=$(ask_choose "Preset (suggested: $SUGGEST)" "Guided" "Supported" "Independent")
case "$PRESET" in
  Guided) BUDGET="60"; BEDTIME="19:00" ;;
  Supported) BUDGET="90"; BEDTIME="20:00" ;;
  *) BUDGET="120"; BEDTIME="21:00" ;;
esac
echo "Daily screen budget: ${BUDGET} min · screens off at ${BEDTIME} (stored, not enforced yet)"

KID_PW=$(ask_input "Kid login password (not the parent password)")
[[ -n "$KID_PW" ]] || { echo "kid password required"; exit 1; }
KID_PW2=$(ask_input "Repeat kid login password")
[[ "$KID_PW" == "$KID_PW2" ]] || { echo "passwords did not match"; exit 1; }
KID_HASH=$(printf '%s' "$KID_PW" | openssl passwd -6 -stdin)
unset KID_PW KID_PW2

echo
echo "── The plan ─────────────────────────"
echo "  Desktop user '$OWNER' stays the only Unix account"
echo "  Kid password is a second login, not in /etc/shadow — sudo still wants the parent password"
echo "  Kid session: namespaced home, filtered system bus, no nmcli/omarchy-dns"
echo "  Wi-Fi: omarchy-kids-wifi SSID (cannot set DNS)"
echo "  Host DNS: Cloudflare Family"
echo "  Preset: $PRESET · ${BUDGET} min/day · off at $BEDTIME"
echo "─────────────────────────────────────"
OK=$(ask_choose "Apply this?" "Yes" "No")
[[ "$OK" == "Yes" ]] || { echo "Stopped. Nothing changed."; exit 0; }

OMARCHY_KIDS_OWNER="$OWNER"
create_kid_account
set_kid_password_hash "$KID_HASH"
install_session_dispatch
apply_web_safety
harden_boot
run install -d -m 0700 /etc/omarchy-kids
run bash -c "printf 'preset=%s\nbudget_min=%s\nbedtime=%s\n' '$PRESET' '$BUDGET' '$BEDTIME' >> /etc/omarchy-kids/config"

echo
echo "── Safety check ─────────────────────"
"$DIR/bin/omarchy-kids-check" || true
echo "Done. Log out. Kid password starts the namespaced session; parent password starts the real home."
