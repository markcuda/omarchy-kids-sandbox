#!/bin/bash
# omarchy:summary=Walk a parent through provisioning the first kid
# omarchy:args=[--dry-run]
# The parent wizard's Easy path: one screen at a time, Appendix A, ending in Apply (SPEC.md R-WIZ-1..9).
# See docs/wizard.md for the full screen list, the answers-file format tests drive it with, and every env var.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"; [[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/sock.sh
source "$LIB/sock.sh"
# shellcheck source=lib/conf.sh
source "$LIB/conf.sh"
# shellcheck source=lib/tui.sh
source "$LIB/tui.sh"
# theme_current_name/theme_list_installed (issue #53): lib/wizard-advanced.sh's
# Desktop-group theme row reads these directly.
# shellcheck source=lib/theme.sh
source "$LIB/theme.sh"
# shellcheck source=lib/wizard-advanced.sh
source "$LIB/wizard-advanced.sh"
# shellcheck source=lib/units.sh
source "$LIB/units.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
KIDS_DIR="$ETC/kids"

CONF_BIN="$(kids_bin conf "$DIR")"
PROVISION_BIN="$(kids_bin provision "$DIR")"
WEB_BIN="$(kids_bin web "$DIR")"
ASSERT_BIN="$(kids_bin assert "$DIR")"
SESSION_BIN="$(kids_bin session "$DIR")"
APPS_BIN="$(kids_bin apps "$DIR")"
PY="$KIDS_PY"
PYHELPER="$LIB/conf.py"

# The verifier socket is a constant: a kid may not point a password
# check anywhere (AGENTS.md, "The trust boundary"; review S4/§2.1).
AUTH_SOCK=/run/omarchy-kids/auth.sock
SETUP_LOG="${OMARCHY_KIDS_SETUP_LOG:-/var/log/omarchy-kids/setup.log}"
MACHINE_CONF="$ETC/machine.conf"
# The wizard itself runs unprivileged, as the parent -- so `id -un` here,
# before Apply ever touches sudo, is simply the parent's own login name.
# Apply's first step writes this into machine.conf's parent= (issue #46
# follow-up), which is what lets omarchy-kids-authd (docs/authd.md) and
# omarchy-kids-provision (which refuses to add a kid without one) both
# work on a machine where nothing has set it yet.
INVOKING_USER="${OMARCHY_KIDS_INVOKING_USER:-$(id -un 2>/dev/null || echo "${USER:-}")}"

# --- what "no flag at all" means here -------------------------------------
#
# Interactive: a human's own button press is the confirmation, so the
# default is a real run (review §1.5). AGENTS.md rule 8's DRY_RUN=1
# default still holds for every non-interactive caller (no tty).
if launched_by_a_human; then
    DRY_RUN="${DRY_RUN:-0}"
else
    DRY_RUN="${DRY_RUN:-1}"
fi

TOTAL_STEPS=15

die() { echo "omarchy-kids-wizard: $1" >&2; exit "${2:-2}"; }

usage() {
    cat <<EOF
Usage: omarchy-kids-wizard [--dry-run] [--help]

Walks a parent through adding one kid, screen by screen (SPEC.md
Appendix A): parent password, name, face, age band, Simple or Advanced,
web, screen time, apps, Wi-Fi, desktop level, the kid's password, a
plain-words summary, then Apply with a progress dashboard and a safety
check. Run it directly, or as 'omarchy-kids wizard'. See docs/wizard.md.

  --dry-run   Print every command Apply would run instead of running it.
              Walked by a human (a terminal, or the Kids Mode app entry)
              Apply is real -- pressing Apply is the confirmation. Without
              a terminal (a test, a script, CI) the default is a preview.
  --apply     Make Apply real (same as DRY_RUN=0).
  -h, --help  Show this help and exit.
EOF
}

for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        --apply) DRY_RUN=0 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: '$arg' (see --help)"
            ;;
    esac
done

# --- small helpers -----------------------------------------------------

# band_field BAND KEY — lib/kids.sh's kids_band_field, with this
# command's own error message. The parsing lives there, once: it is the
# `sed | head -1` that returned 141 under pipefail (review §2.7).
band_field() {
    kids_band_field "$CONF_BIN" "$@" || die "could not read band '$1' defaults from $CONF_BIN"
}

# pack_field BAND KEY — every value of a `key = "value"` line in that
# band's pack TOML (share/packs/<band>.toml), one per line: `pkg`
# (prefetch/install), `id` (the apps checklist), `label` (summary text
# and the checklist's own prompts) — a plain sed over the pack's own
# documented shape (AGENTS.md, Appendix C) rather than a new lib/conf.py
# command, since these are all already-fixed-format single-line fields.
pack_field() {
    local band="$1" key="$2"
    local pack="$SHARE/packs/$band.toml"
    [[ -f "$pack" ]] || return 0
    sed -n "s/^${key} = \"\\(.*\\)\"\$/\\1/p" "$pack"
}

# app_label_for BAND ID — one app's label, via lib/conf.py's existing
# pack-app (already used by bin/omarchy-kids-session-start to resolve a
# launcher id to its pack metadata); falls back to the raw id if the
# pack has no such entry.
app_label_for() {
    local band="$1" id="$2" out
    out="$("$PY" "$PYHELPER" pack-app "$SHARE/packs/$band.toml" "$id" 2>/dev/null)" || {
        printf '%s\n' "$id"
        return
    }
    printf '%s\n' "${out%%$'\t'*}"
}

# repo_and_aur_pkgs BAND [COMMA_IDS] — sets REPO_PKGS=() and AUR_PKGS=()
# (the "aur:" prefix stripped). With no COMMA_IDS, every package in the
# band's starter pack (used by prefetch, which always fetches the whole
# pack per R-WIZ-4 — "changed selections need no undo" is exactly this:
# app screen choices only affect what gets *installed*, not what was
# already downloaded). With COMMA_IDS (the apps screen's "let me pick"
# result), only those ids' packages.
REPO_PKGS=()
AUR_PKGS=()
repo_and_aur_pkgs() {
    REPO_PKGS=()
    AUR_PKGS=()
    local band="$1" filter="${2:-}"
    _bucket_pkg() {
        case "$1" in
            aur:*) AUR_PKGS+=("${1#aur:}") ;;
            *) REPO_PKGS+=("$1") ;;
        esac
    }
    if [[ -z "$filter" ]]; then
        local p
        while IFS= read -r p; do
            [[ -z "$p" ]] && continue
            _bucket_pkg "$p"
        done < <(pack_field "$band" pkg)
    else
        local id out pkg oldifs="$IFS"
        IFS=,
        for id in $filter; do
            IFS="$oldifs"
            [[ -z "$id" ]] && continue
            out="$("$PY" "$PYHELPER" pack-app "$SHARE/packs/$band.toml" "$id" 2>/dev/null)" || continue
            pkg="$(printf '%s\n' "$out" | cut -f2)"
            [[ -n "$pkg" ]] && _bucket_pkg "$pkg"
        done
        IFS="$oldifs"
    fi
}

# run_priv CMD... — the one place a real system change is either printed
# (DRY_RUN=1, the default) or actually run, under sudo (Apply is the only
# place this wizard ever needs root — see "Root and the one sudo prompt"
# in docs/wizard.md). Never used for a command that also needs its own
# stdin; see run_priv_stdin for that.
run_priv() {
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '  [dry-run] sudo'
        printf ' %q' "$@"
        printf '\n'
    else
        sudo "$@"
    fi
}

# run_priv_stdin CMD... — like run_priv, but forwards this function's own
# stdin to the real command (provision's --password-stdin /
# --parent-password-stdin). In DRY_RUN mode the piped stdin (a password)
# is drained and discarded, never echoed — only the argv is printed, and
# a password is never on argv (AGENTS.md: "passwords only ever on stdin,
# never argv, never logged").
run_priv_stdin() {
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '  [dry-run] sudo'
        printf ' %q' "$@"
        printf '\n'
        cat >/dev/null
    else
        sudo "$@"
    fi
}

# run_priv_as USER CMD... — run_priv, but as USER (omarchy-kids-session
# --check has to run as the kid to see the kid's own facts).
run_priv_as() {
    local user="$1"
    shift
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '  [dry-run] sudo -u %q' "$user"
        printf ' %q' "$@"
        printf '\n'
    else
        sudo -u "$user" "$@"
    fi
}

# --- prefetch (R-WIZ-4): starts on the age screen, never blocks --------
#
# Known gap: no dedicated root helper yet, so this only prefetches when
# sudo already has a cached credential (from A2); otherwise it skips and
# says so -- Apply's own install step works either way. See docs/wizard.md.
PREFETCH_PID=""
start_prefetch() {
    local band="$1"
    repo_and_aur_pkgs "$band"
    ((${#REPO_PKGS[@]})) || return 0
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '  [dry-run] sudo -n pacman -Sw --noconfirm'
        printf ' %q' "${REPO_PKGS[@]}"
        printf ' (background, started now, never blocks)\n'
        return 0
    fi
    if sudo -n true 2>/dev/null; then
        sudo -n pacman -Sw --noconfirm "${REPO_PKGS[@]}" >/dev/null 2>&1 &
        PREFETCH_PID=$!
    else
        echo "  (starter-pack download will start at Apply instead of now — see docs/wizard.md)" >&2
    fi
}
stop_prefetch() {
    if [[ -n "$PREFETCH_PID" ]]; then
        kill "$PREFETCH_PID" >/dev/null 2>&1 || true
    fi
    PREFETCH_PID=""
}
trap stop_prefetch EXIT

# --- validators ----------------------------------------------------------

# validate_kid_name CANDIDATE — letters, spaces, and hyphens, 1-24 chars
# (issue #19's brief); printed on failure, redraws the screen (lib/tui.sh's
# VALIDATOR contract).
validate_kid_name() {
    local name="$1"
    if [[ -z "$name" ]]; then
        echo "Type a name — a first name or nickname is fine."
        return 1
    fi
    if ((${#name} > 24)); then
        echo "Keep it to 24 characters or fewer."
        return 1
    fi
    if [[ ! "$name" =~ ^[A-Za-z][A-Za-z\ -]*$ ]]; then
        echo "Letters, spaces, and hyphens only, please."
        return 1
    fi
    return 0
}

PASSWORD_MIN=4
validate_kid_password() {
    local pw="$1"
    if ((${#pw} < PASSWORD_MIN)); then
        echo "That needs to be at least $PASSWORD_MIN characters."
        return 1
    fi
    return 0
}

# verify_parent_password_authd CANDIDATE — the same protocol
# bin/omarchy-kids-parent-auth speaks to omarchy-kids-authd (docs/authd.md):
# one line in, "ok"/"no" back, through lib/sock.sh's one client. A missing
# socat *and* python3 fails closed (no way to speak the protocol at all),
# rather than silently accepting.
verify_parent_password_authd() {
    local candidate="$1" reply
    reply="$(kids_sock_request "$AUTH_SOCK" "$candidate"$'\n')" || return 1
    [[ "$reply" == ok* ]]
}

# verify_parent_password_sudo CANDIDATE — fallback for when authd's
# socket isn't up (fresh install, or right after omarchy-kids-remove).
# The parent's login password is also their sudo password by design, so
# `sudo -k` then `sudo -S -v` (stdin only, never argv/logged) is a real,
# independent check, not a shrug.
verify_parent_password_sudo() {
    local candidate="$1"
    sudo -k >/dev/null 2>&1
    printf '%s\n' "$candidate" | sudo -S -p '' -v >/dev/null 2>&1
}

# authd_verifiable — true iff omarchy-kids-authd's socket is active AND
# machine.conf names a parent for it to check against. Both gates matter
# independently: right after omarchy-kids-remove, the pacman hook's own
# units_fix can re-enable the socket in the same transaction that deletes
# machine.conf -- socket up, nobody home. See docs/authd.md.
authd_verifiable() {
    [[ -S "$AUTH_SOCK" ]] || return 1
    local parent
    parent="$(conf_get "$MACHINE_CONF" parent 2>/dev/null)" && [[ -n "$parent" ]]
}

# verify_parent_password CANDIDATE — true iff the candidate checks out.
# Prefers omarchy-kids-authd when authd_verifiable says it can answer,
# else verify_parent_password_sudo. The fallback reason is a stderr
# diagnostic only, never shown to the parent as a failure (issue #46) --
# see screen_parent_password for what an actually-wrong password does.
verify_parent_password() {
    local candidate="$1"
    if authd_verifiable; then
        verify_parent_password_authd "$candidate"
        return $?
    fi
    if [[ -S "$AUTH_SOCK" ]]; then
        echo "omarchy-kids-wizard: $MACHINE_CONF has no 'parent=' line — verifying the parent password via sudo instead" >&2
    else
        echo "omarchy-kids-wizard: omarchy-kids-authd socket not active ($AUTH_SOCK) — verifying the parent password via sudo instead" >&2
    fi
    verify_parent_password_sudo "$candidate"
}

friendly_wifi_mode() {
    case "$1" in
        parent) echo "Ask me first" ;;
        helper) echo "On their own, safely" ;;
        *) echo "$1" ;;
    esac
}

# maybe_override KEY VALUE BAND_DEFAULT — writes a profile override only
# when the parent's choice differs from the band default (R-BAND-2: "the
# profile stores only overrides"). Run through run_priv so DRY_RUN=1
# prints it like every other Apply command.
maybe_override() {
    local key="$1" value="$2" band_default="$3"
    [[ "$value" == "$band_default" ]] && return 0
    run_priv "$CONF_BIN" set "$ACCOUNT" "$key" "$value"
}

# apps_pick_walk STEP TOTAL — walks the band's starter pack one app at a
# time (no multi-select widget in lib/tui.sh), yes/no per app; sets
# $TUI_REPLY to the comma-joined yes ids. Shared by A9's "Let me pick"
# and the Advanced checklist's apps row. Esc on one app means "No" and
# moves on; only Ctrl+C leaves the wizard. See docs/wizard.md.
apps_pick_walk() {
    local step="$1" total="$2" id label chosen=() body
    while IFS= read -r id; do
        [[ -z "$id" ]] && continue
        label="$(app_label_for "$BAND" "$id")"
        # shellcheck disable=SC2034 # read by tui_screen_confirm via nameref-by-name
        body=("Include $label in $DISPLAY_NAME's starter apps?")
        tui_screen_confirm "$label" "$step" "$total" 0 "" body "Yes" "No"
        local rc=$?
        ((rc == 130)) && return 130
        [[ "$TUI_REPLY" == yes ]] && chosen+=("$id")
    done < <(pack_field "$BAND" id)
    local IFS=,
    TUI_REPLY="${chosen[*]}"
    return 0
}

# --- thin dispatch: one lib/wizard-<area>.sh per screen group ---------------

# shellcheck source=lib/wizard-screens.sh
source "$LIB/wizard-screens.sh"
# shellcheck source=lib/wizard-apply.sh
source "$LIB/wizard-apply.sh"

# --- driver: step forward, Esc back, Ctrl+C leave (nothing changed) ----

DISPLAY_NAME=""
ACCOUNT=""
AVATAR="fox"
BAND=""
MODE="simple"
WEB_MODE=""
BUDGET_MIN=""
BUDGET_MIN_WEEKEND=""
LIGHTS_OUT=""
LIGHTS_OUT_WEEKEND=""
APPS_MODE="pack"
ALLOWLIST_IDS=""
WIFI_MODE=""
LEVEL=""
# The four Advanced-only cells Simple never shows a screen for (issue
# #20): seeded to this band's default by screen_band's adv_init, changed
# only through the Advanced checklist or the summary's "Change
# something" (lib/wizard-advanced.sh).
DNS_MODE=""
SITES=""
MENU_MODE=""
HISTORY_VISIBLE=""
NO_PASSWORD=0
KID_PASSWORD=""
PARENT_PASSWORD=""
APPLY_OK=1
FAILED_STEP=""

tui_init || exit $?

STEP=1
while ((STEP <= TOTAL_STEPS)); do
    rc=0
    # A screen's own non-zero return (1=Esc back, 130=Ctrl+C leave) is a
    # normal signal read from $rc just below, not a failure -- set +e
    # for exactly this call so it doesn't trip `set -e` before that read.
    set +e
    case "$STEP" in
        1) screen_welcome ;;
        2) screen_parent_password ;;
        3) screen_name ;;
        4) screen_face ;;
        5) screen_band ;;
        6) screen_mode ;;
        7)
            # Advanced's grouped checklist stands in for all five of
            # Simple's A7-A11 screens at once (issue #20) — see the rc
            # handling below for how it skips straight to A12 (step 12)
            # instead of stepping to 8, and Esc there returns to A6
            # (step 6) instead of one step back.
            if [[ "$MODE" == advanced ]]; then
                screen_advanced_checklist 7 "$TOTAL_STEPS"
            else
                screen_web
            fi
            ;;
        8) screen_time ;;
        9) screen_apps ;;
        10) screen_wifi ;;
        11) screen_level ;;
        12) screen_password ;;
        13) screen_summary ;;
        14) screen_apply ;;
        15) screen_done ;;
    esac
    rc=$?
    set -e
    case "$rc" in
        0)
            if ((STEP == 7)) && [[ "$MODE" == advanced ]]; then
                STEP=12 # "Done customizing": skip Simple's A7-A11 entirely
            else
                STEP=$((STEP + 1))
            fi
            ;;
        1)
            if ((STEP == 1)); then
                echo "Nothing to go back to — leaving, nothing changed." >&2
                exit 1
            fi
            if ((STEP == 7)) && [[ "$MODE" == advanced ]]; then
                STEP=6 # Esc out of the checklist's own row list: back to A6
            else
                STEP=$((STEP - 1))
            fi
            ;;
        130)
            stop_prefetch
            echo "Left setup. Nothing changed." >&2
            exit 130
            ;;
        *)
            die "screen at step $STEP failed unexpectedly" 2
            ;;
    esac
done

exit 0
