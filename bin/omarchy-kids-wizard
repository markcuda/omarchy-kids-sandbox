#!/bin/bash
# Omarchy Kids Mode — parent setup wizard (skeleton).
# Dry-run by default. Real changes: sudo DRY_RUN=0 omarchy-kids-wizard --apply
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$DIR/lib/provision.sh"
[[ "${1:-}" == "--apply" ]] && DRY_RUN=0
HAVE_GUM=0; command -v gum >/dev/null && HAVE_GUM=1

ask_choose() { # prompt, options...
  local p="$1"; shift
  if [[ $HAVE_GUM == 1 ]]; then gum choose --header "$p" "$@"; else
    echo "$p" >&2; select o in "$@"; do echo "$o"; break; done; fi
}
ask_input() { if [[ $HAVE_GUM == 1 ]]; then gum input --placeholder "$1"; else read -rp "$1: " v; echo "$v"; fi; }

echo "═══ OMARCHY KIDS MODE SETUP ═══"
[[ "$DRY_RUN" == "1" ]] && echo "(dry run — nothing will change; use --apply with sudo on a test box)"

# 1 · Who is this computer for?
WHO=$(ask_choose "Who is this computer for?" "Me" "Child" "Another owner")
[[ "$WHO" != "Child" ]] && { echo "Nothing to do — Kids Mode is for the Child path."; exit 0; }

# 2 · Age band (under-13 first, per upstream)
BAND=$(ask_choose "How old is the child?" "3-5" "5-7" "8-10" "11-12")

# 3 · Preset (suggested from the band; parent can override)
case "$BAND" in
  3-5|5-7) SUGGEST="Guided";; 8-10) SUGGEST="Supported";; *) SUGGEST="Independent";;
esac
PRESET=$(ask_choose "Preset (suggested: $SUGGEST)" "Guided" "Supported" "Independent")

# 4 · Time limits (defaults per preset; stored for the future time engine)
case "$PRESET" in
  Guided) BUDGET="60"; BEDTIME="19:00";; Supported) BUDGET="90"; BEDTIME="20:00";; *) BUDGET="120"; BEDTIME="21:00";;
esac
echo "Daily screen budget: ${BUDGET} min · Screens off at: ${BEDTIME} (edit later)"

# 5 · Parent PIN (for in-session approvals; recovery = your own password)
PIN=$(ask_input "Choose a 4-6 digit parent PIN")

echo
echo "── The plan ─────────────────────────"
echo "  Child account '$KID_USER' · no sudo · locked-down home"
echo "  Web safety on: family DNS + locked browser (SafeSearch, no incognito)"
echo "  Boot basics: menu editor off, spare terminals off"
echo "  Preset: $PRESET · ${BUDGET} min/day · off at $BEDTIME"
echo "─────────────────────────────────────"
OK=$(ask_choose "Apply this?" "Yes" "No")
[[ "$OK" != "Yes" ]] && { echo "Stopped. Nothing changed."; exit 0; }

create_kid_account
apply_web_safety
harden_boot
# PIN + preset + budget: stored root-owned for the coming time engine (hashed PIN; sha256 for now)
run install -d -m 0700 /etc/omarchy-kids
run bash -c "printf 'preset=%s\nbudget_min=%s\nbedtime=%s\npin_sha256=%s\n' '$PRESET' '$BUDGET' '$BEDTIME' \"\$(printf %s '$PIN' | sha256sum | cut -d' ' -f1)\" > /etc/omarchy-kids/config"

echo
echo "── Safety check ─────────────────────"
"$DIR/bin/omarchy-kids-check" || true
echo "Done. Log out; the child logs in as '$KID_USER'."
