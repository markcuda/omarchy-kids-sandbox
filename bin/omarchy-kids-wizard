#!/bin/bash
# omarchy-kids-wizard — the parent wizard's Easy path (SPEC.md R-WIZ-1..9,
# Appendix A; issue #19). Bash + gum in Omarchy's floating terminal, every
# screen rendered by lib/tui.sh (issue #18) — this file never calls gum
# directly. See docs/wizard.md for the full screen list and the
# answers-file layout tests drive it with.
#
# This follows Appendix A screen by screen: Welcome (A1), parent password
# (A2), name (A3), face (A4), age band (A5), Simple or Advanced (A6), the
# five Simple one-choice screens (A7-A11: web, time, apps, Wi-Fi, level —
# each with the band's default preselected and a one-line reason per
# option), the kid's password (A12), the summary (A13), Apply (A13b) with
# the safety check (A13c), and Done (A14). Advanced (A13a's per-cell
# checklist) is issue #20; choosing it on A6 here just explains that and
# returns to A6.
#
# Every screen is keyboard-complete (Esc back, Ctrl+C leave with nothing
# changed — see lib/tui.sh) up to the moment Apply actually starts
# running commands; once a system change has begun, stopping partway
# would leave things half-done, so the run is committed at that point,
# same as the installer's own dashboard (R-WIZ-5).
#
#   omarchy-kids-wizard [--dry-run] [--help]
#
# DRY_RUN=1 is the default everywhere Apply would write something (AGENTS.md
# rule 8): every command Apply would run is printed, `pacman`/`sudo`/
# `omarchy-kids-*` included, nothing runs. --apply is not offered here on
# purpose — spec's summary screen (A13) is itself the confirmation; passing
# DRY_RUN=0 (or --apply) is how a real run happens, same convention as
# every other command in bin/.
#
# Every path is overridable for tests, same convention as the rest of
# bin/ (test/shell.d/wizard-test.sh runs entirely against scratch trees
# with a stub PATH for gum/pacman/sudo and stub omarchy-kids-provision/
# -web/-assert/-session pointed at by their own env vars below):
#   OMARCHY_KIDS_ETC             default /etc/omarchy-kids
#   OMARCHY_KIDS_SHARE            default /usr/share/omarchy-kids
#   OMARCHY_KIDS_LIB              default lib/ beside bin/, else /usr/lib/omarchy-kids
#   OMARCHY_KIDS_CONF_BIN          path to omarchy-kids-conf (default: resolved
#                                  beside this script, else PATH)
#   OMARCHY_KIDS_CONF_PY           python3 interpreter for lib/conf.py (default: python3)
#   OMARCHY_KIDS_PROVISION_BIN     path to omarchy-kids-provision (default: sibling, else PATH)
#   OMARCHY_KIDS_WEB_BIN           path to omarchy-kids-web (default: sibling, else PATH)
#   OMARCHY_KIDS_ASSERT_BIN        path to omarchy-kids-assert (default: sibling, else PATH)
#   OMARCHY_KIDS_SESSION_BIN       path to omarchy-kids-session (default: sibling, else PATH)
#   OMARCHY_KIDS_AUTH_SOCK         the parent-password verifier socket (default
#                                  /run/omarchy-kids/auth.sock, same var
#                                  bin/omarchy-kids-parent-auth uses)
#   OMARCHY_KIDS_SETUP_LOG         the technical log Apply writes to (R-WIZ-5;
#                                  default /var/log/omarchy-kids/setup.log)
#   OMARCHY_KIDS_TUI_ANSWERS       one answer per line; see lib/tui.sh / docs/tui.md
#   DRY_RUN                        default 1; 0 (or --apply) makes Apply real
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="${OMARCHY_KIDS_LIB:-$DIR/lib}"; [[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/conf.sh
source "$LIB/conf.sh"
# shellcheck source=lib/tui.sh
source "$LIB/tui.sh"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
KIDS_DIR="$ETC/kids"

CONF_BIN="${OMARCHY_KIDS_CONF_BIN:-$DIR/bin/omarchy-kids-conf}"; [[ -x "$CONF_BIN" ]] || CONF_BIN=omarchy-kids-conf
PROVISION_BIN="${OMARCHY_KIDS_PROVISION_BIN:-$DIR/bin/omarchy-kids-provision}"; [[ -x "$PROVISION_BIN" ]] || PROVISION_BIN=omarchy-kids-provision
WEB_BIN="${OMARCHY_KIDS_WEB_BIN:-$DIR/bin/omarchy-kids-web}"; [[ -x "$WEB_BIN" ]] || WEB_BIN=omarchy-kids-web
ASSERT_BIN="${OMARCHY_KIDS_ASSERT_BIN:-$DIR/bin/omarchy-kids-assert}"; [[ -x "$ASSERT_BIN" ]] || ASSERT_BIN=omarchy-kids-assert
SESSION_BIN="${OMARCHY_KIDS_SESSION_BIN:-$DIR/bin/omarchy-kids-session}"; [[ -x "$SESSION_BIN" ]] || SESSION_BIN=omarchy-kids-session
PY="${OMARCHY_KIDS_CONF_PY:-python3}"
PYHELPER="$LIB/conf.py"

AUTH_SOCK="${OMARCHY_KIDS_AUTH_SOCK:-/run/omarchy-kids/auth.sock}"
SETUP_LOG="${OMARCHY_KIDS_SETUP_LOG:-/var/log/omarchy-kids/setup.log}"

DRY_RUN="${DRY_RUN:-1}"

VALID_BANDS=("3-5" "6-8" "9-12" "13+")
TOTAL_STEPS=15

die() { echo "omarchy-kids-wizard: $1" >&2; exit "${2:-2}"; }

usage() {
    cat <<EOF
Usage: omarchy-kids-wizard [--dry-run] [--help]

Walks a parent through adding one kid, screen by screen (SPEC.md
Appendix A): parent password, name, face, age band, Simple or Advanced,
web, screen time, apps, Wi-Fi, desktop level, the kid's password, a
plain-words summary, then Apply with a progress dashboard and a safety
check. Run it directly, or as 'omarchy-kids wizard'. See docs/wizard.md.

  --dry-run   Print every command Apply would run instead of running it
              (also the default with no DRY_RUN set at all — AGENTS.md
              rule 8). Set DRY_RUN=0 to make Apply real.
  -h, --help  Show this help and exit.
EOF
}

for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        --apply) DRY_RUN=0 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: '$arg' (see --help)"
            ;;
    esac
done

# --- small helpers -----------------------------------------------------

# band_field BAND KEY — one value out of `omarchy-kids-conf band <band>`'s
# key=value lines (label, blurb, level, web, budget_min, lights_out,
# terminal, password_min, password_optional, ...). Same shape as
# bin/omarchy-kids-provision's own band_field; duplicated rather than
# shared for the same reason that file gives for group_for_band: four to
# a dozen stable lines, and provision is a script, not a library.
band_field() {
    local band="$1" key="$2" out
    out="$("$CONF_BIN" band "$band")" || die "could not read band '$band' defaults from $CONF_BIN"
    printf '%s\n' "$out" | sed -n "s/^${key}=//p" | head -1
}

# pack_field BAND KEY — every value of a `key = "value"` line in that
# band's pack TOML (share/packs/<band>.toml), one per line: `pkg`
# (prefetch/install), `id` (the apps checklist), `label` (summary text
# and the checklist's own prompts) — a plain sed over the pack's own
# documented shape (AGENTS.md, Appendix C) rather than a new lib/conf.py
# command, since these are all already-fixed-format single-line fields.
pack_field() {
    local band="$1" key="$2"
    local pack="$SHARE/packs/$band.toml"
    [[ -f "$pack" ]] || return 0
    sed -n "s/^${key} = \"\\(.*\\)\"\$/\\1/p" "$pack"
}

# app_label_for BAND ID — one app's label, via lib/conf.py's existing
# pack-app (already used by bin/omarchy-kids-session-start to resolve a
# launcher id to its pack metadata); falls back to the raw id if the
# pack has no such entry.
app_label_for() {
    local band="$1" id="$2" out
    out="$("$PY" "$PYHELPER" pack-app "$SHARE/packs/$band.toml" "$id" 2>/dev/null)" || {
        printf '%s\n' "$id"
        return
    }
    printf '%s\n' "${out%%$'\t'*}"
}

# repo_and_aur_pkgs BAND [COMMA_IDS] — sets REPO_PKGS=() and AUR_PKGS=()
# (the "aur:" prefix stripped). With no COMMA_IDS, every package in the
# band's starter pack (used by prefetch, which always fetches the whole
# pack per R-WIZ-4 — "changed selections need no undo" is exactly this:
# app screen choices only affect what gets *installed*, not what was
# already downloaded). With COMMA_IDS (the apps screen's "let me pick"
# result), only those ids' packages.
REPO_PKGS=()
AUR_PKGS=()
repo_and_aur_pkgs() {
    REPO_PKGS=()
    AUR_PKGS=()
    local band="$1" filter="${2:-}"
    _bucket_pkg() {
        case "$1" in
            aur:*) AUR_PKGS+=("${1#aur:}") ;;
            *) REPO_PKGS+=("$1") ;;
        esac
    }
    if [[ -z "$filter" ]]; then
        local p
        while IFS= read -r p; do
            [[ -z "$p" ]] && continue
            _bucket_pkg "$p"
        done < <(pack_field "$band" pkg)
    else
        local id out pkg oldifs="$IFS"
        IFS=,
        for id in $filter; do
            IFS="$oldifs"
            [[ -z "$id" ]] && continue
            out="$("$PY" "$PYHELPER" pack-app "$SHARE/packs/$band.toml" "$id" 2>/dev/null)" || continue
            pkg="$(printf '%s\n' "$out" | cut -f2)"
            [[ -n "$pkg" ]] && _bucket_pkg "$pkg"
        done
        IFS="$oldifs"
    fi
}

# run_priv CMD... — the one place a real system change is either printed
# (DRY_RUN=1, the default) or actually run, under sudo (Apply is the only
# place this wizard ever needs root — see "Root and the one sudo prompt"
# in docs/wizard.md). Never used for a command that also needs its own
# stdin; see run_priv_stdin for that.
run_priv() {
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '  [dry-run] sudo'
        printf ' %q' "$@"
        printf '\n'
    else
        sudo "$@"
    fi
}

# run_priv_stdin CMD... — like run_priv, but forwards this function's own
# stdin to the real command (provision's --password-stdin /
# --parent-password-stdin). In DRY_RUN mode the piped stdin (a password)
# is drained and discarded, never echoed — only the argv is printed, and
# a password is never on argv (AGENTS.md: "passwords only ever on stdin,
# never argv, never logged").
run_priv_stdin() {
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '  [dry-run] sudo'
        printf ' %q' "$@"
        printf '\n'
        cat >/dev/null
    else
        sudo "$@"
    fi
}

# run_priv_as USER CMD... — run_priv, but as USER (omarchy-kids-session
# --check has to run as the kid to see the kid's own facts).
run_priv_as() {
    local user="$1"
    shift
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '  [dry-run] sudo -u %q' "$user"
        printf ' %q' "$@"
        printf '\n'
    else
        sudo -u "$user" "$@"
    fi
}

# --- prefetch (R-WIZ-4): starts on the age screen, never blocks --------
#
# Known gap (see docs/wizard.md): there is no dedicated root helper for
# this yet (R-WIZ-4 calls for one), so a real run only prefetches when
# sudo already has a cached credential (`sudo -n true`) — this early in
# the wizard that's only true if the A2 parent-password step already
# warmed it (see screen_parent_password). Rather than pop a second,
# unplanned password prompt here, a real run without a warm credential
# just skips prefetching and says so; Apply's own "installing starter
# apps" step still works fine either way, from cache if prefetch got to
# run or freshly downloaded if not (R-APPS-8's "offline: complete and
# defer" is the same shape of fallback, just for a different reason).
PREFETCH_PID=""
start_prefetch() {
    local band="$1"
    repo_and_aur_pkgs "$band"
    ((${#REPO_PKGS[@]})) || return 0
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '  [dry-run] sudo -n pacman -Sw --noconfirm'
        printf ' %q' "${REPO_PKGS[@]}"
        printf ' (background, started now, never blocks)\n'
        return 0
    fi
    if sudo -n true 2>/dev/null; then
        sudo -n pacman -Sw --noconfirm "${REPO_PKGS[@]}" >/dev/null 2>&1 &
        PREFETCH_PID=$!
    else
        echo "  (starter-pack download will start at Apply instead of now — see docs/wizard.md)" >&2
    fi
}
stop_prefetch() {
    [[ -n "$PREFETCH_PID" ]] && kill "$PREFETCH_PID" >/dev/null 2>&1
    PREFETCH_PID=""
}
trap stop_prefetch EXIT

# --- validators ----------------------------------------------------------

# validate_kid_name CANDIDATE — letters, spaces, and hyphens, 1-24 chars
# (issue #19's brief); printed on failure, redraws the screen (lib/tui.sh's
# VALIDATOR contract).
validate_kid_name() {
    local name="$1"
    if [[ -z "$name" ]]; then
        echo "Type a name — a first name or nickname is fine."
        return 1
    fi
    if ((${#name} > 24)); then
        echo "Keep it to 24 characters or fewer."
        return 1
    fi
    if [[ ! "$name" =~ ^[A-Za-z][A-Za-z\ -]*$ ]]; then
        echo "Letters, spaces, and hyphens only, please."
        return 1
    fi
    return 0
}

PASSWORD_MIN=4
validate_kid_password() {
    local pw="$1"
    if ((${#pw} < PASSWORD_MIN)); then
        echo "That needs to be at least $PASSWORD_MIN characters."
        return 1
    fi
    return 0
}

validate_budget_minutes() {
    if [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 1440)); then
        return 0
    fi
    echo "A number of minutes, 1 to 1440."
    return 1
}

validate_lights_out() {
    [[ "$1" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] && return 0
    echo "24-hour time, like 19:30."
    return 1
}

# verify_parent_password CANDIDATE — the same protocol
# bin/omarchy-kids-parent-auth speaks to omarchy-kids-authd (docs/authd.md):
# one line in, "ok"/"no" back. If the verifier isn't running here (no
# socket — a dev box, or a machine mid-setup), this can't verify anything
# on its own, and doesn't block on a check it has no way to perform.
verify_parent_password() {
    local candidate="$1" reply
    [[ -S "$AUTH_SOCK" ]] || return 0
    if command -v socat >/dev/null 2>&1; then
        reply="$(printf '%s\n' "$candidate" | socat -T5 - "UNIX-CONNECT:$AUTH_SOCK" 2>/dev/null)"
    elif command -v python3 >/dev/null 2>&1; then
        reply="$(printf '%s\n' "$candidate" | python3 -c '
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(5)
try:
    s.connect(sys.argv[1])
    s.sendall(sys.stdin.buffer.read())
    s.shutdown(socket.SHUT_WR)
    data = b""
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        data += chunk
    sys.stdout.buffer.write(data)
except OSError:
    pass
' "$AUTH_SOCK" 2>/dev/null)"
    else
        return 0
    fi
    [[ "$reply" == ok* ]]
}

# validate_parent_password CANDIDATE — A2's validator. --dry-run never
# has a real omarchy-kids-authd to check against (and shouldn't try to
# reach a real one even if it happened to exist on this box), so it just
# prompts and accepts, as asked; a real run defers to verify_parent_password,
# which itself accepts when the verifier isn't running (see its own
# comment) — provision's own --parent-password-stdin is the backstop
# check whenever a LUKS slot is actually in play.
validate_parent_password() {
    [[ "$DRY_RUN" == "1" ]] && return 0
    verify_parent_password "$1" && return 0
    echo "That password wasn't recognized. Try again."
    return 1
}

friendly_web_mode() {
    case "$1" in
        none) echo "No browser" ;;
        garden) echo "Only sites you choose" ;;
        filtered) echo "Filtered open web" ;;
        *) echo "$1" ;;
    esac
}

friendly_wifi_mode() {
    case "$1" in
        parent) echo "Ask me first" ;;
        helper) echo "On their own, safely" ;;
        *) echo "$1" ;;
    esac
}

# maybe_override KEY VALUE BAND_DEFAULT — writes a profile override only
# when the parent's choice differs from the band default (R-BAND-2: "the
# profile stores only overrides"). Run through run_priv so DRY_RUN=1
# prints it like every other Apply command.
maybe_override() {
    local key="$1" value="$2" band_default="$3"
    [[ "$value" == "$band_default" ]] && return 0
    run_priv "$CONF_BIN" set "$ACCOUNT" "$key" "$value"
}

# --- screens -------------------------------------------------------------
# One function per screen, in Appendix A order. Each returns lib/tui.sh's
# own contract: 0 = continue (answer in the variable the caller expects),
# 1 = Esc/"go back", 130 = Ctrl+C/"leave, nothing changed" (the driver
# loop below is what actually does the going-back and leaving).

# A1: Welcome.
screen_welcome() {
    # shellcheck disable=SC2034 # read by tui_screen_choose via nameref-by-name
    local choices=("begin|Begin|")
    local omy=$'Hi, I\'m Omy. Kids Mode turns this computer into one your kids can use on their own.\n\nEach kid gets their own desktop, at their own level.\nYou stay in charge with one password, yours.\nEverything can be undone.'
    tui_screen_choose "Welcome" 1 "$TOTAL_STEPS" 1 "$omy" choices "begin" "$TUI_FOOTER_FIRST"
}

# A2: Parent password, right after Welcome (SPEC.md R-WIZ-1). Kept for
# the whole wizard, in memory only (never written anywhere — R-SEC-1),
# and reused at Apply for the one sudo prompt (docs/wizard.md).
screen_parent_password() {
    tui_screen_input "First, your password." 2 "$TOTAL_STEPS" 0 "" \
        password "Kids Mode uses it for every grown-up decision. It's the same one you log in with." \
        validate_parent_password
    local rc=$?
    ((rc == 0)) || return $rc
    PARENT_PASSWORD="$TUI_REPLY"
    return 0
}

# A3: Name.
screen_name() {
    tui_screen_input "What's your kid's name?" 3 "$TOTAL_STEPS" 0 "" \
        text "First name or nickname. It's what they'll see." validate_kid_name
    local rc=$?
    ((rc == 0)) || return $rc
    DISPLAY_NAME="$TUI_REPLY"
    ACCOUNT="$("$CONF_BIN" slug "$DISPLAY_NAME")" || die "could not slug '$DISPLAY_NAME'"
    if [[ -e "$KIDS_DIR/$ACCOUNT.conf" ]]; then
        echo
        echo "That'll be close to $ACCOUNT on this computer (a number gets added if it's taken)."
    else
        echo
        echo "That'll be $ACCOUNT on this computer."
    fi
    return 0
}

# A4: Face — a keyboard list of share/avatars/*.svg (one of the twelve
# CC0 animals, Q18), same tui_screen_choose "arrows" input Appendix A
# calls for; there's no separate grid widget in lib/tui.sh, and a list is
# just as keyboard-complete.
screen_face() {
    local -a choices=()
    local f id label
    shopt -s nullglob
    for f in "$SHARE/avatars"/*.svg; do
        id="$(basename "$f" .svg)"
        label="$(tr '[:lower:]' '[:upper:]' <<<"${id:0:1}")${id:1}"
        choices+=("$id|$label|")
    done
    shopt -u nullglob
    if ((${#choices[@]} == 0)); then
        AVATAR="fox"
        return 0
    fi
    tui_screen_choose "Pick $DISPLAY_NAME's face." 4 "$TOTAL_STEPS" 0 "" choices "fox"
    local rc=$?
    ((rc == 0)) || return $rc
    AVATAR="$TUI_REPLY"
    return 0
}

# A5: Age.
screen_band() {
    local -a choices=()
    local b label blurb
    for b in "${VALID_BANDS[@]}"; do
        label="$(band_field "$b" label)"
        blurb="$(band_field "$b" blurb)"
        choices+=("$b|$label|$blurb")
    done
    tui_screen_choose "How old is $DISPLAY_NAME?" 5 "$TOTAL_STEPS" 0 "" choices "6-8"
    local rc=$?
    ((rc == 0)) || return $rc
    BAND="$TUI_REPLY"
    PASSWORD_MIN="$(band_field "$BAND" password_min)"
    # R-WIZ-4: prefetch starts here, in the background, and never blocks.
    start_prefetch "$BAND"
    return 0
}

# A6: Simple or Advanced. Advanced (A13a's per-cell checklist) is issue
# #20; choosing it here explains that and re-shows this same screen.
screen_mode() {
    while true; do
        local choices=(
            "simple|Simple|A few clear choices with sensible defaults. About five minutes."
            "advanced|Advanced|Every setting on one screen. Coming in a later update."
        )
        tui_screen_choose "How do you want to set up $DISPLAY_NAME's computer?" \
            6 "$TOTAL_STEPS" 0 "" choices "simple"
        local rc=$?
        ((rc == 0)) || return $rc
        if [[ "$TUI_REPLY" == advanced ]]; then
            echo
            echo "Advanced setup is coming next — for now, Simple covers everyone with sensible defaults."
            continue
        fi
        return 0
    done
}

# A7: Web (Simple). Two options, band-appropriate (R-WEB-3's three real
# modes are none/garden/filtered; each band offers its own default plus
# the one adjacent alternative that actually makes sense for that band).
screen_web() {
    local -a choices=()
    local default
    case "$BAND" in
        3-5)
            choices=(
                "none|No browser|Simplest and safest for the youngest kids."
                "garden|Only sites you choose|A short list you can grow, if you'd rather start early."
            )
            default="none"
            ;;
        13+)
            choices=(
                "filtered|Filtered open web|Adult content blocked, safe search on."
                "garden|Only sites you choose|A shorter, safer list if you'd rather start there."
            )
            default="filtered"
            ;;
        *)
            choices=(
                "garden|Only sites you choose|A short list you can grow. Best for younger kids."
                "filtered|Filtered open web|Adult content blocked, safe search on."
            )
            default="garden"
            ;;
    esac
    tui_screen_choose "What can $DISPLAY_NAME see on the web?" 7 "$TOTAL_STEPS" 0 "" choices "$default"
    local rc=$?
    ((rc == 0)) || return $rc
    WEB_MODE="$TUI_REPLY"
    return 0
}

# A8: Time (Simple). B leads to two custom fields, per Appendix A.
screen_time() {
    local band_budget band_lights
    band_budget="$(band_field "$BAND" budget_min)"
    band_lights="$(band_field "$BAND" lights_out)"
    local choices=(
        "default|$band_budget minutes a day, lights out at $band_lights|Matches Ages $BAND's usual day."
        "custom|I'll set my own|Pick your own minutes and bedtime."
    )
    tui_screen_choose "How much screen time?" 8 "$TOTAL_STEPS" 0 "" choices "default"
    local rc=$?
    ((rc == 0)) || return $rc
    if [[ "$TUI_REPLY" == default ]]; then
        BUDGET_MIN="$band_budget"
        LIGHTS_OUT="$band_lights"
        return 0
    fi
    tui_screen_input "How many minutes a day?" 8 "$TOTAL_STEPS" 0 "" \
        text "A number, like 60." validate_budget_minutes
    rc=$?
    ((rc == 0)) || return $rc
    BUDGET_MIN="$TUI_REPLY"
    tui_screen_input "Lights out at?" 8 "$TOTAL_STEPS" 0 "" \
        text "24-hour time, like 19:30." validate_lights_out
    rc=$?
    ((rc == 0)) || return $rc
    LIGHTS_OUT="$TUI_REPLY"
    return 0
}

# A9: Apps (Simple). B walks the pack one app at a time (a confirm per
# app, since lib/tui.sh has no multi-select checklist widget yet — the
# real checklist is Advanced's, A13a, issue #20); a "No" and an Esc are
# the same thing there (tui_screen_confirm's own contract): the app is
# left out either way, and the wizard moves to the next one.
screen_apps() {
    local names
    names="$(pack_field "$BAND" label | paste -sd, - | sed 's/,/, /g')"
    local choices=(
        "pack|The $BAND starter pack|$names"
        "pick|Let me pick|Turn any of them off, one at a time."
    )
    tui_screen_choose "Which apps to start with?" 9 "$TOTAL_STEPS" 0 "" choices "pack"
    local rc=$?
    ((rc == 0)) || return $rc
    APPS_MODE="$TUI_REPLY"
    ALLOWLIST_IDS=""
    if [[ "$APPS_MODE" == pick ]]; then
        local id label chosen=()
        local body
        while IFS= read -r id; do
            [[ -z "$id" ]] && continue
            label="$(app_label_for "$BAND" "$id")"
            # shellcheck disable=SC2034 # read by tui_screen_confirm via nameref-by-name
            body=("Include $label in $DISPLAY_NAME's starter apps?")
            tui_screen_confirm "$label" 9 "$TOTAL_STEPS" 0 "" body "Yes" "No"
            rc=$?
            ((rc == 130)) && return 130
            [[ "$TUI_REPLY" == yes ]] && chosen+=("$id")
        done < <(pack_field "$BAND" id)
        local IFS=,
        ALLOWLIST_IDS="${chosen[*]}"
    fi
    return 0
}

# A10: Wi-Fi (Simple).
screen_wifi() {
    local default
    default="$(band_field "$BAND" wifi)"
    local choices=(
        "parent|Ask me first|Wi-Fi requests go through you."
        "helper|On their own, safely|They can join school or café Wi-Fi. The network can't change what's blocked."
    )
    tui_screen_choose "Can $DISPLAY_NAME join new Wi-Fi?" 10 "$TOTAL_STEPS" 0 "" choices "$default"
    local rc=$?
    ((rc == 0)) || return $rc
    WIFI_MODE="$TUI_REPLY"
    return 0
}

# A11: Level (Simple), band default marked.
screen_level() {
    local default
    default="$(band_field "$BAND" level)"
    local choices=(
        "1|One thing at a time|Simplest — one app fills the screen."
        "2|Two things side by side|Split-screen multitasking."
        "3|The full desktop|Everything Omarchy normally offers."
    )
    tui_screen_choose "How should $DISPLAY_NAME's desktop work?" 11 "$TOTAL_STEPS" 0 "" choices "$default"
    local rc=$?
    ((rc == 0)) || return $rc
    LEVEL="$TUI_REPLY"
    return 0
}

# A12: Kid password. 3-5 gets an extra "set one or not" choice first
# (R-BAND's password_optional).
screen_password() {
    NO_PASSWORD=0
    if [[ "$BAND" == "3-5" ]]; then
        local choices=(
            "yes|Set a password|$DISPLAY_NAME types it to get in."
            "no|No password|$DISPLAY_NAME gets in once you start their session, no typing needed."
        )
        tui_screen_choose "Give $DISPLAY_NAME a password?" 12 "$TOTAL_STEPS" 0 "" choices "yes"
        local rc=$?
        ((rc == 0)) || return $rc
        if [[ "$TUI_REPLY" == no ]]; then
            NO_PASSWORD=1
            KID_PASSWORD=""
            return 0
        fi
    fi

    while true; do
        tui_screen_input "Now a password for $DISPLAY_NAME." 12 "$TOTAL_STEPS" 0 "" \
            password "This unlocks $DISPLAY_NAME's screen (and this computer's disk, if it's encrypted) and logs them in." \
            validate_kid_password
        local rc=$?
        ((rc == 0)) || return $rc
        local first="$TUI_REPLY"

        tui_screen_input "Type it again to be sure." 12 "$TOTAL_STEPS" 0 "" \
            password "Same password, once more." validate_kid_password
        rc=$?
        ((rc == 0)) || return $rc

        if [[ "$first" == "$TUI_REPLY" ]]; then
            KID_PASSWORD="$first"
            return 0
        fi
        echo
        echo "Those didn't match — let's try again."
    done
}

# A13: Summary.
screen_summary() {
    local label blurb apps_desc password_line
    label="$(band_field "$BAND" label)"
    blurb="$(band_field "$BAND" blurb)"
    if [[ -n "$ALLOWLIST_IDS" ]]; then
        apps_desc=""
        local id oldifs="$IFS"
        IFS=,
        for id in $ALLOWLIST_IDS; do
            IFS="$oldifs"
            [[ -z "$id" ]] && continue
            [[ -n "$apps_desc" ]] && apps_desc+=", "
            apps_desc+="$(app_label_for "$BAND" "$id")"
        done
        IFS="$oldifs"
        [[ -z "$apps_desc" ]] && apps_desc="(none selected)"
    else
        apps_desc="$(pack_field "$BAND" label | paste -sd, - | sed 's/,/, /g')"
    fi
    if ((NO_PASSWORD)); then
        password_line="No password — $DISPLAY_NAME gets in once you start their session."
    else
        password_line="$DISPLAY_NAME types their own password to get in."
    fi

    # shellcheck disable=SC2034 # read by tui_screen_summary via nameref-by-name
    local rows=(
        "Account|$ACCOUNT"
        "Face|$AVATAR"
        "Age band|$label ($blurb)"
        "Desktop|Level $LEVEL"
        "Web|$(friendly_web_mode "$WEB_MODE")"
        "Screen time|$BUDGET_MIN minutes a day"
        "Bedtime|$LIGHTS_OUT"
        "Wi-Fi|$(friendly_wifi_mode "$WIFI_MODE")"
        "Starter apps|$apps_desc"
        "Password|$password_line"
    )
    tui_screen_summary "Here's what happens next for $DISPLAY_NAME." 13 "$TOTAL_STEPS" 0 "" rows

    local choices=("apply|Apply|" "change|Change something|")
    tui_screen_choose "Ready?" 13 "$TOTAL_STEPS" 0 "" choices "apply"
    local rc=$?
    ((rc == 0)) || return $rc
    [[ "$TUI_REPLY" == apply ]] && return 0
    return 1 # "Change something" == Esc: don't proceed, go back a screen
}

# A13b/A13c: Apply, then the safety check. The parent password was
# already collected and (where possible) verified at A2 — see
# screen_parent_password and docs/wizard.md "Root and the one sudo prompt".
screen_apply() {
    tui_header "Apply" 14 "$TOTAL_STEPS" 0 ""
    echo

    # shellcheck disable=SC2034 # read by tui_progress via nameref-by-name
    local steps=(
        "Getting your OK"
        "Setting up $DISPLAY_NAME's account"
        "Turning on the safe browser rules"
        "Installing $BAND starter apps"
        "Double-checking everything is safe"
    )
    local i=0
    tui_progress steps "$i" "You can watch this happen — nothing here needs another click."

    # Step 1: the one sudo prompt for the whole Apply step, spending the
    # A2 password (see run_priv's comment / docs/wizard.md).
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '  [dry-run] sudo -v\n'
    elif ! sudo -n true 2>/dev/null; then
        printf '%s\n' "$PARENT_PASSWORD" | sudo -S -p '' -v 2>/dev/null
    fi
    i=1
    tui_progress steps "$i"

    # Step 2: the account itself, plus every choice that differs from
    # the band default (R-BAND-2: only overrides are ever written).
    if ((NO_PASSWORD)); then
        run_priv_stdin "$PROVISION_BIN" add "$DISPLAY_NAME" --band "$BAND" --avatar "$AVATAR" --no-password --apply </dev/null
    else
        printf '%s\n%s\n' "$KID_PASSWORD" "$PARENT_PASSWORD" |
            run_priv_stdin "$PROVISION_BIN" add "$DISPLAY_NAME" --band "$BAND" --avatar "$AVATAR" --password-stdin --parent-password-stdin --apply
    fi
    local provision_rc=$?
    maybe_override level "$LEVEL" "$(band_field "$BAND" level)"
    maybe_override web "$WEB_MODE" "$(band_field "$BAND" web)"
    maybe_override wifi "$WIFI_MODE" "$(band_field "$BAND" wifi)"
    maybe_override budget_min "$BUDGET_MIN" "$(band_field "$BAND" budget_min)"
    maybe_override lights_out "$LIGHTS_OUT" "$(band_field "$BAND" lights_out)"
    [[ -n "$ALLOWLIST_IDS" ]] && run_priv "$CONF_BIN" set "$ACCOUNT" allowlist "$ALLOWLIST_IDS"
    i=2
    tui_progress steps "$i"

    # Step 3: web policy.
    run_priv "$WEB_BIN" install "$BAND" --apply
    local web_rc=$?
    i=3
    tui_progress steps "$i"

    # Step 4: starter pack, from cache (R-WIZ-4/R-APPS-3) — only the apps
    # the apps screen actually chose, if it chose a subset.
    repo_and_aur_pkgs "$BAND" "$ALLOWLIST_IDS"
    if ((${#REPO_PKGS[@]})); then
        run_priv pacman -S --noconfirm --needed "${REPO_PKGS[@]}"
    fi
    if ((${#AUR_PKGS[@]})); then
        echo "  (AUR packages deferred — no AUR helper wired up yet: ${AUR_PKGS[*]})"
    fi
    i=4
    tui_progress steps "$i"

    # Step 5: the safety check (A13c): omarchy-kids-assert (I-4) and the
    # same R-DESK-2 preflight a real login runs, as the new kid's own
    # account (omarchy-kids-session --check figures out who it's
    # checking via `id -un`).
    echo
    echo "Safety check:"
    run_priv "$ASSERT_BIN"
    local assert_rc=$?
    run_priv_as "$ACCOUNT" "$SESSION_BIN" --check
    local session_rc=$?
    i=5
    tui_progress steps "$i" "The technical log is at $SETUP_LOG."

    APPLY_OK=1
    if [[ "$DRY_RUN" != "1" ]]; then
        ((provision_rc == 0)) || APPLY_OK=0
        ((web_rc == 0)) || APPLY_OK=0
        ((assert_rc == 0)) || APPLY_OK=0
        ((session_rc == 0)) || APPLY_OK=0
    fi
    return 0
}

# A14: Done.
screen_done() {
    local headline
    if ((APPLY_OK)); then
        headline="$DISPLAY_NAME's desktop is ready."
    else
        headline="$DISPLAY_NAME's account is set up, but the safety check found something to fix — see the lines above."
    fi
    local omy="$headline Next time the computer starts, $DISPLAY_NAME can just type their password."
    local choices=(
        "parent|Return to my desktop|"
        "kid|Open $DISPLAY_NAME's desktop|"
    )
    tui_screen_choose "Done" 15 "$TOTAL_STEPS" 1 "$omy" choices "parent"
    local rc=$?
    if [[ "$TUI_REPLY" == kid ]]; then
        echo
        echo "There's no live preview switch yet on this box (see docs/wizard.md) —"
        echo "$DISPLAY_NAME logs in from the portal next time the screen locks or the computer starts."
    fi
    return $((rc == 130 ? 130 : 0))
}

# --- driver: step forward, Esc back, Ctrl+C leave (nothing changed) ----

DISPLAY_NAME=""
ACCOUNT=""
AVATAR="fox"
BAND=""
WEB_MODE=""
BUDGET_MIN=""
LIGHTS_OUT=""
APPS_MODE="pack"
ALLOWLIST_IDS=""
WIFI_MODE=""
LEVEL=""
NO_PASSWORD=0
KID_PASSWORD=""
PARENT_PASSWORD=""
APPLY_OK=1

tui_init || exit $?

STEP=1
while ((STEP <= TOTAL_STEPS)); do
    rc=0
    case "$STEP" in
        1) screen_welcome ;;
        2) screen_parent_password ;;
        3) screen_name ;;
        4) screen_face ;;
        5) screen_band ;;
        6) screen_mode ;;
        7) screen_web ;;
        8) screen_time ;;
        9) screen_apps ;;
        10) screen_wifi ;;
        11) screen_level ;;
        12) screen_password ;;
        13) screen_summary ;;
        14) screen_apply ;;
        15) screen_done ;;
    esac
    rc=$?
    case "$rc" in
        0) STEP=$((STEP + 1)) ;;
        1)
            if ((STEP == 1)); then
                echo "Nothing to go back to — leaving, nothing changed." >&2
                exit 1
            fi
            STEP=$((STEP - 1))
            ;;
        130)
            stop_prefetch
            echo "Left setup. Nothing changed." >&2
            exit 130
            ;;
        *)
            die "screen at step $STEP failed unexpectedly" 2
            ;;
    esac
done

exit 0
