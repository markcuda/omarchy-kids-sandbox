#!/bin/bash
# omarchy:summary=Walk three sample lib/tui.sh screens on a real terminal
# omarchy-kids-tui-demo: walks three sample screens from lib/tui.sh so a
# human can see the look on a real terminal (issue #18). Not part of the
# real wizard — that's later issues; this only exercises the renderer.
#
#   omarchy-kids-tui-demo                 interactive: gum asks, you answer
#   OMARCHY_KIDS_TUI_ANSWERS=f ... demo    scripted: answers come from a file
#
# See docs/tui.md for the answers-file format (one answer per line, plus
# the reserved @esc / @ctrlc lines).
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/tui.sh
source "$DIR/lib/tui.sh"

for arg in "$@"; do
    case "$arg" in
        -h | --help)
            cat <<'EOF'
Usage: omarchy-kids-tui-demo

Walks three sample screens (Welcome, a choice screen, Done) so a human can
see lib/tui.sh's look on a real terminal. Set OMARCHY_KIDS_TUI_ANSWERS to a
file of newline-separated answers to run it non-interactively (see
docs/tui.md).

  -h, --help  Show this help and exit.
EOF
            exit 0
            ;;
    esac
done

tui_init || exit $?

# Every tui_screen_choose call below returns 1 (Esc) / 130 (Ctrl+C) as
# data for the case right after it, not as an error -- set +e for the
# rest of this demo (same fix as bin/omarchy-kids-wizard's step loop).
set +e

# --- Screen 1: Welcome (A1) — Omy speaks, single "Begin" choice ------------
# shellcheck disable=SC2034 # read by tui_screen_choose via nameref (by name)
welcome_choices=("begin|Begin|")
tui_screen_choose \
    "Welcome" 1 3 1 \
    "Hi, I'm Omy. Kids Mode turns this computer into one your kids can use on their own." \
    welcome_choices "begin" "$TUI_FOOTER_FIRST"
rc=$?
case $rc in
    130)
        echo "Left setup. Nothing changed."
        exit 130
        ;;
    1)
        echo "Nothing to go back to from the first screen."
        exit 1
        ;;
esac

# --- Screen 2: a choice screen (shaped like A7, Web) -----------------------
# shellcheck disable=SC2034 # read by tui_screen_choose via nameref (by name)
web_choices=(
    "garden|Only sites you choose|A short list you can grow. Best for younger kids."
    "filtered|Filtered open web|Adult content blocked, safe search on."
)
tui_screen_choose \
    "What can <K> see on the web?" 2 3 0 "" \
    web_choices "garden"
rc=$?
case $rc in
    130)
        echo "Left setup. Nothing changed."
        exit 130
        ;;
    1)
        echo "(back to Welcome — this demo just stops here)"
        exit 0
        ;;
esac
web_choice="$TUI_REPLY"

# --- Screen 3: Done (A14) — Omy speaks again, a choice between two desks --
# shellcheck disable=SC2034 # read by tui_screen_choose via nameref (by name)
done_choices=(
    "parent|Return to my desktop|"
    "kid|Open <Kp> desktop|"
)
tui_screen_choose \
    "Done" 3 3 1 \
    "<K>'s desktop is ready. Next time the computer starts, <K> can just type their password." \
    done_choices "parent"
rc=$?
case $rc in
    130)
        echo "Left setup. Nothing changed."
        exit 130
        ;;
    1)
        echo "(back to the web screen — this demo just stops here)"
        exit 0
        ;;
esac

echo
echo "Demo answers: web=${web_choice} done=${TUI_REPLY}"
