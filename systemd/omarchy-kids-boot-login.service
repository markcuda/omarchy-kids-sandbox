[Unit]
Description=Write the per-boot Kids Mode SDDM autologin drop-in (R-BOOT-3); no recorded slot means the portal
Documentation=https://github.com/markcuda/omarchy-kids-sandbox/blob/main/docs/boot.md
After=local-fs.target
Before=display-manager.service
# No /run/omarchy-kids/boot-slot means omarchy-kids-unlock stepped aside
# (I-9): skip entirely and leave Omarchy's own autologin drop-in in place,
# which is exactly today's behavior.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/omarchy-kids-boot-login

[Install]
WantedBy=multi-user.target
