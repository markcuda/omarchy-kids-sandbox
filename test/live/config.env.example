# Copy this file to test/live/config.env (gitignored — see .gitignore) and fill it in for your
# own test laptop and VM. Every var below can also just be exported in the shell instead; either
# way test/live/lib.sh reads them with these same defaults, so an unset var is never a hard error,
# only a wrong-box error (docs/live-tests.md explains how to tell the difference).

# --- ssh ---------------------------------------------------------------------
# Path to an ssh config file (your real ~/.ssh/config works fine) with two Host aliases:
#   air  - the test laptop, reached over Tailscale SSH (docs/laptop-runbook.md)
#   vm   - the VM's forwarded SSH port, ProxyJump'd through air (docs/vm.md, "Driving it from
#          the Mac" has the exact stanza to copy)
LIVE_SSH_CFG="$HOME/.ssh/omarchy-kids-vm-config"

# This repo's checkout dir on the laptop, relative to $HOME on `air` — where scripts/vm-run.sh,
# scripts/vm-qmp.sh, and makepkg all run.
LIVE_REMOTE_REPO="omarchy-kids-sandbox"

# --- the owner / parent account ------------------------------------------------
# Both the LUKS disk password AND the login/verifier password for the VM's owner account
# (scripts/vm-build.sh's cidata recipe sets both to this by default) and the account name that
# password logs into (VM_USER in vm-build.sh, kid-vm by default).
LIVE_OWNER_PASSWORD="omarchy"
LIVE_OWNER_ACCOUNT="kid-vm"

# --- the persistent test kid --------------------------------------------------
# Provisioned once, by hand or by an earlier wizard run, and left alone: scenarios 10, 20, 30, 40,
# and 50 all log in as this kid; 90-remove never touches it (see that scenario's own comment for
# why). If your test box has no kid provisioned yet, provision one with this name/password first
# (docs/provision.md), or run 60-wizard-easy once and point these three vars at what it creates.
LIVE_KID1_ACCOUNT="kid-cy"
LIVE_KID1_NAME="Cy"
LIVE_KID1_PASSWORD="kidpass-cy"

# What 40-time-lights-out restores lights_out to when it's done, so a later scenario run doesn't
# find the kid still locked out from the last test.
LIVE_KID1_LIGHTS_OUT_RESET="21:00"

# --- the wizard-provisioned kid ------------------------------------------------
# 60-wizard-easy provisions this kid fresh (skipping the wizard run if it's already there — see
# that scenario's own comment); 90-remove is the only scenario allowed to delete it, and only for
# real under LIVE_DESTRUCTIVE=1. Band is fixed at 6-8 in 60-wizard-easy.sh's own answers file
# (AGENTS.md rule 9's fixture band, and the band the Simple-path answers below assume defaults
# for — level 1, garden, default time, starter pack, parent wifi); only the name, avatar, and
# password are configurable here.
LIVE_WIZARD_KID_NAME="Ada"
LIVE_WIZARD_KID_AVATAR="owl"
LIVE_WIZARD_KID_PASSWORD="kidpass-wiz"

# --- output --------------------------------------------------------------------
# Where screenshots and report.md land, relative to nothing in particular — give it an absolute
# path or a path relative to wherever you invoke test/live/all or a scenario from. Defaults to
# test/live/out inside this checkout.
LIVE_OUT_DIR=""

# --- safety gate -----------------------------------------------------------------
# 90-remove's dry-run step always runs. Its real (non-dry-run) step — deleting the wizard kid's
# account and LUKS slot for real — only runs when this is 1. Leave it 0 for a routine `all` run;
# set it to 1 only when you actually want that cleanup to happen.
LIVE_DESTRUCTIVE=0
